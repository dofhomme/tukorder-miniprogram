<view class="page {{rtl ? 'rtl' : ''}}"><view wx:if="{{loading}}" class="loading">{{i18n.loading}}</view><block wx:else><view class="me-card"><view class="me-avatar">{{avatarChar}}</view><view class="me-info"><text class="me-name">{{displayLabel}}</text><text class="me-badge">{{roleBadge}}</text></view></view><view class="data-entry" bindtap="onTeamData" hover-class="menu-item-hover" hover-stay-time="60"><text>{{i18n.teamData}}</text><text class="chev">›</text></view><block wx:if="{{isOwner}}"><view class="sec-head"><view class="sec-bar"></view><text class="sec-title">{{i18n.teamTitle}}</text></view><view class="seat-bar" wx:if="{{seatLimit > 0}}"><text class="seat-bar-t">{{seatHint}}</text><text class="seat-bar-d">{{i18n.followSeatHint}}</text></view><view class="seat-bar" wx:else><text class="seat-bar-d">{{i18n.followSeatNeedPlan}}</text></view><view wx:if="{{!members.length}}" class="empty-card">{{i18n.noTeamMembers}}</view><view class="mem-card" wx:for="{{members}}" wx:key="id"><view
          class="seat-check {{item.seatGranted ? 'on' : ''}} {{seatLimit <= 0 ? 'off' : ''}}"
          catchtap="onToggleSeat"
          data-userid="{{item.userId}}"
          hover-stay-time="50"
          hover-start-time="0"
        ><text wx:if="{{item.seatGranted}}">✓</text></view><view class="mem-main" bindtap="onMemberTap" data-id="{{item.id}}" hover-stay-time="50" hover-start-time="0"><text class="mem-name">{{item.displayName}}</text><text class="mem-joined">{{i18n.joinedAt}}：{{item.joinedLabel}}</text><text class="mem-seat" wx:if="{{item.seatGranted}}">{{i18n.followSeatOn}}</text></view><text class="mem-gear" catchtap="onMemberTap" data-id="{{item.id}}" hover-stay-time="50" hover-start-time="0">⚙</text><view class="mem-remove" catchtap="onRemove" data-id="{{item.id}}" data-name="{{item.displayName}}" hover-stay-time="50" hover-start-time="0">
          {{i18n.removeMember}}
        </view></view><text class="help">{{i18n.teamHelp}}</text><view class="fab-space"></view><view class="invite-fab {{busy?'off':''}}" bindtap="onInvite" hover-stay-time="50" hover-start-time="0"><text class="invite-ico">＋</text><text>{{i18n.inviteOthers}}</text></view></block><block wx:else><view class="sec-head"><view class="sec-bar"></view><text class="sec-title">{{i18n.teamInfo}}</text></view><view class="info-card"><text wx:if="{{ownerShop}}">{{i18n.shop}}：{{ownerShop}}</text><text wx:if="{{ownerPhone}}">{{i18n.merchantPhone}}：{{ownerPhone}}</text></view><view class="sec-head"><view class="sec-bar"></view><text class="sec-title">{{i18n.myDisplayName}}</text></view><view class="info-card"><input class="name-input" placeholder="{{i18n.displayNamePh}}" value="{{myName}}" bindinput="onMyName" /><view class="save-name" bindtap="onRename" hover-stay-time="50" hover-start-time="0">{{i18n.saveName}}</view></view><view class="sync-boss {{busy?'off':''}}" bindtap="onSyncBoss" hover-stay-time="50" hover-start-time="0">☁ {{i18n.syncMerchantData}}</view><text class="perm-hint">{{i18n.memberPermHint}}</text></block></block><view class="sheet-mask" wx:if="{{showInvite}}" catchtap="onCloseInvite" catchtouchmove="noop" hover-stay-time="50" hover-start-time="0"><view class="sheet" catchtap="noop" hover-stay-time="50" hover-start-time="0"><text class="sheet-title">{{i18n.addStaff}}</text><text class="sheet-hint">{{inviteHint}}</text><input class="sheet-input" type="number" placeholder="{{i18n.memberPhone}}" value="{{phone}}" bindinput="onPhone" disabled="{{inviteStep !== 'phone'}}" /><input wx:if="{{inviteStep === 'new'}}" class="sheet-input" password placeholder="{{i18n.initPwd}}" value="{{password}}" bindinput="onPassword" /><input wx:if="{{inviteStep === 'sms'}}" class="sheet-input" type="number" placeholder="{{i18n.smsCode}}" value="{{smsCode}}" bindinput="onSmsCode" /><input class="sheet-input" placeholder="{{i18n.memberDisplayName}}" value="{{displayName}}" bindinput="onName" /><view wx:if="{{inviteStep === 'phone'}}" class="sheet-btn {{busy?'off':''}}" bindtap="onCheckPhone" hover-stay-time="50" hover-start-time="0">{{i18n.detectAccount}}</view><view wx:if="{{inviteStep === 'new'}}" class="sheet-btn {{busy?'off':''}}" bindtap="onCreate" hover-stay-time="50" hover-start-time="0">{{i18n.createStaff}}</view><view wx:if="{{inviteStep === 'sms'}}" class="sheet-btn {{busy?'off':''}}" bindtap="onSendSms" hover-stay-time="50" hover-start-time="0">{{i18n.sendSms}}</view><view wx:if="{{inviteStep === 'sms'}}" class="sheet-btn {{busy?'off':''}}" bindtap="onConfirmInvite" hover-stay-time="50" hover-start-time="0">{{i18n.verifyJoin}}</view><view wx:if="{{inviteStep !== 'phone'}}" class="sheet-btn ghost {{busy?'off':''}}" bindtap="onBackToPhone" hover-stay-time="50" hover-start-time="0">{{i18n.redetect}}</view></view></view><view class="sheet-mask" wx:if="{{detail}}" catchtap="onCloseDetail" catchtouchmove="noop" hover-stay-time="50" hover-start-time="0"><view class="sheet" catchtap="noop" hover-stay-time="50" hover-start-time="0"><text class="sheet-title">{{detail.displayName}}</text><view class="detail-row"><text class="dk">{{i18n.phoneNumber}}</text><text class="dv">{{detail.phone || '—'}}</text></view><view class="detail-row"><text class="dk">{{i18n.joinedAt}}</text><text class="dv">{{detail.joinedLabel}}</text></view><view class="detail-row"><text class="dk">供应链</text><switch checked="{{detail.supplyEnabled}}" color="#1d4ed8" bindchange="onSupply" /></view><view
        class="sheet-btn danger"
        bindtap="onRemove"
        data-id="{{detail.id}}"
        data-name="{{detail.displayName}}"
       hover-stay-time="50" hover-start-time="0">{{i18n.removeStaffRel}}</view></view></view>
<human-captcha show="{{captchaShow}}" error="{{captchaError}}" error-seq="{{captchaSeq}}" bind:pass="onCaptchaPass" bind:cancel="onCaptchaCancel" />
</view>
