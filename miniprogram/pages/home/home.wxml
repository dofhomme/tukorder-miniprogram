    class="reason-mask"
    wx:if="{{returnReasonVisible}}"
    catchtouchmove="noop"
    bindtap="onReturnReasonCancel"
   hover-stay-time="50" hover-start-time="0"><view class="reason-dialog" catchtap="noop" hover-stay-time="50" hover-start-time="0"><text class="reason-title">{{i18n.pickReturnReason}}</text><view
        class="reason-item"
        wx:for="{{returnReasonOptions}}"
        wx:key="*this"
        data-reason="{{item}}"
        bindtap="onReturnReasonPick"
       hover-stay-time="50" hover-start-time="0"><text class="reason-item-txt">{{item}}</text></view></view></view><view class="corner-dock {{dockFolded ? 'folded' : ''}}" style="bottom: {{suggestKbH > 0 ? (suggestKbH + 16) + 'px' : 'calc(112rpx + env(safe-area-inset-bottom))'}};">
      <view class="corner-card"><view class="dock-edge" bindtap="onToggleDockFold" hover-stay-time="50" hover-start-time="0"><view class="dock-edge-chev"></view></view><view class="corner-slide"><view
      class="corner-btn print {{saving || printing ? 'busy' : ''}} {{isReturnMode ? 'return' : ''}}"
      bindtap="onPrint"
      hover-stay-time="50"
      hover-start-time="0"
    ><image class="corner-ico" src="{{media.url('print-blue.png')}}" mode="aspectFit" /><text class="corner-txt">{{printing ? i18n.printing : i18n.print}}</text></view><voice-fab
      quiet="{{true}}"
      hold-text="{{i18n.voiceBtn}}"
      release-text="{{i18n.voiceRelease}}"
      busy-text="{{i18n.recognizing}}"
      keyboard-up="{{suggestKbH > 0}}"
      bind:willhold="onVoiceWillHold"
      bind:idle="onVoiceFabIdle"
      bind:transcript="onVoiceFabTranscript"
      bind:error="onVoiceFabError"
    /></view></view></view><view
    class="bill-kind-mask"
    wx:if="{{billKindVisible}}"
    catchtouchmove="noop"
    bindtap="onBillKindClose"
  ><view class="bill-kind-dialog" catchtap="noop"><text class="bill-kind-title">{{i18n.billKindTitle}}</text><text class="bill-kind-name">{{nm.gap(customerName)}}</text><view class="bill-kind-actions"><view class="bill-kind-btn sale" bindtap="onBillKindSale" hover-stay-time="50">{{i18n.billSale}}</view><view class="bill-kind-btn return" bindtap="onBillKindReturn" hover-stay-time="50">{{i18n.billReturn}}</view></view></view></view><bluetooth-search-sheet id="btSheet" /></block></view>
