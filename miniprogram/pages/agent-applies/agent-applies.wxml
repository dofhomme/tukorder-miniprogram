<view class="page"><text class="hint" wx:if="{{error}}">{{error}}</text><view class="empty" wx:if="{{!loading && !items.length}}">{{i18n.agentAppliesEmpty}}</view><view class="card" wx:for="{{items}}" wx:key="id"><text class="name">{{item.displayName}}</text><text class="meta" wx:if="{{item.phone}}">{{item.phone}}</text><text class="meta" wx:if="{{item.note}}">{{item.note}}</text><text class="meta">{{item.createdAt}}</text><view class="row"><view class="btn ok {{busyId===item.id ? 'off' : ''}}" data-id="{{item.id}}" data-action="approve" bindtap="onDecide">{{i18n.agentApplyApprove}}</view><view class="btn no {{busyId===item.id ? 'off' : ''}}" data-id="{{item.id}}" data-action="reject" bindtap="onDecide">{{i18n.agentApplyReject}}</view></view></view></view>
