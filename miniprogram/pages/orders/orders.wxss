.page{background:#f3f6fb;min-height:100vh;padding-bottom:calc(148rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow-x:hidden;position:relative}
.page-head{background:linear-gradient(180deg,#dbe7f5 0%,#eef3f9 52%,#f3f6fb 100%);box-shadow:0 1rpx 0 rgba(22,58,107,0.08);border-bottom:1rpx solid rgba(22,58,107,0.06)}
.status-spacer,.capsule-gap{width:100%}
.date-bar{display:flex;align-items:center;padding:16rpx 24rpx 8rpx 32rpx}
.date-custom{display:flex;align-items:center;justify-content:center;gap:20rpx;padding:4rpx 24rpx 16rpx}
.date-pick{min-width:220rpx;padding:10rpx 20rpx;text-align:center;background:#fff;border-radius:12rpx;font-size:26rpx;color:#163a6b}
.date-sep{color:#8a98ab}
.date-hit{flex:1;min-width:0;display:flex;align-items:center;padding:8rpx 12rpx 8rpx 0}
.date-hit-on{opacity:0.6}
.date-label{font-size:30rpx;font-weight:600;color:#163a6b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.date-export{flex-shrink:0;margin-right:16rpx;padding:6rpx 18rpx;border-radius:999rpx;background:#1e4d8c;color:#fff;font-size:24rpx;font-weight:600;line-height:1.4}
.export-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:100000;display:flex;align-items:flex-end;padding-bottom:calc(112rpx + env(safe-area-inset-bottom))}
.export-bg{position:absolute;left:0;right:0;top:0;bottom:0;background:rgba(16,32,54,0.45)}
.export-sheet{position:relative;z-index:1;width:100%;max-height:calc(100vh - 160rpx - env(safe-area-inset-bottom));background:#fff;border-radius:24rpx 24rpx 0 0;padding:28rpx 28rpx 24rpx;box-sizing:border-box}
.export-title{display:block;font-size:36rpx;font-weight:700;color:#163a6b}
.export-hint{display:block;margin-top:12rpx;color:#5b7390;font-size:24rpx;line-height:1.45}
.export-preview{width:100%;height:50vh;margin-top:16rpx}
.export-x{width:100%}
.export-table{display:inline-flex;flex-direction:column;flex-shrink:0;min-width:100%;border:1rpx solid rgba(30,77,140,0.16);border-radius:12rpx;overflow:hidden}
.export-row{display:flex;flex-direction:row}
.export-row.head{background:#e7f0fa}
.export-row.alt{background:#f4f8fc}
.export-cell{width:148rpx;flex:none;padding:12rpx 8rpx;font-size:22rpx;line-height:1.3;color:#1a2b3c;border-right:1rpx solid #e6eef6;border-bottom:1rpx solid #e6eef6;box-sizing:border-box;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.export-row.head .export-cell{color:#163a6b;font-weight:600}
.export-btn{margin-top:16rpx;height:80rpx;line-height:80rpx;text-align:center;border-radius:12rpx;background:#1e4d8c;color:#fff;font-size:30rpx;font-weight:600}
.export-btn.ghost{background:#fff;color:#1e4d8c;border:2rpx solid #1e4d8c;box-sizing:border-box;line-height:76rpx}
.date-sync{width:40rpx;height:40rpx;flex-shrink:0;margin-right:8rpx;border-radius:50%;background:radial-gradient(circle at 32% 30%,#7dd3fc 0%,#0284c7 52%,#0369a1 100%);box-shadow:0 2rpx 6rpx rgba(2,132,199,0.3);overflow:hidden}
.date-sync-ico{width:40rpx;height:40rpx;display:block}
.date-sync.spin .date-sync-ico{animation:od-sync-spin 0.7s linear infinite}
@keyframes od-sync-spin{from{transform:rotate(0deg)}
to{transform:rotate(360deg)}
}
.quick-row{display:flex;flex-direction:row;align-items:stretch;gap:12rpx;padding:4rpx 24rpx 16rpx}
.quick-btn{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;height:112rpx;padding:12rpx 4rpx;border-radius:20rpx;background:#fff;border:1rpx solid rgba(22,58,107,0.08);box-shadow:0 4rpx 16rpx rgba(22,58,107,0.05);box-sizing:border-box}
.quick-on{background:#eef3fb}
.quick-ico{width:40rpx;height:40rpx;flex-shrink:0}
.quick-lbl{max-width:100%;font-size:22rpx;font-weight:600;line-height:1.2;color:#1e4d8c;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.search-wrap{padding:0 32rpx 16rpx}
.search-box{display:flex;align-items:center;height:72rpx;padding:0 24rpx;background:#ffffff;border:1rpx solid rgba(22,58,107,0.08);border-radius:48rpx;box-sizing:border-box;box-shadow:0 2rpx 8rpx rgba(22,58,107,0.04)}
.search-ico{font-size:28rpx;margin-right:12rpx;opacity:0.55;flex-shrink:0}
.search{flex:1;height:72rpx;font-size:28rpx;color:#333}
.search-ph{color:#9e9e9e}
.search-clear{font-size:28rpx;color:#9e9e9e;padding:8rpx 4rpx 8rpx 16rpx;flex-shrink:0}
.filters{display:flex;padding:0 8rpx 12rpx;border-bottom:1rpx solid #f0f0f0}
.fchip{flex:1;display:flex;align-items:center;justify-content:center;gap:4rpx;font-size:26rpx;color:#333;padding:16rpx 4rpx;min-width:0}
.fchip text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fchev{font-size:22rpx;color:#757575;flex-shrink:0}
.day.open{margin-bottom:12rpx}
.day-row{display:flex;align-items:center;padding:28rpx 32rpx;background:#e8eef6;border-bottom:1rpx solid rgba(22,58,107,0.08)}
.day-body{padding:16rpx 20rpx 4rpx;background:#f4f7fb;border-bottom:1rpx solid rgba(22,58,107,0.06)}
.day-date{width:200rpx;font-size:30rpx;color:#333;flex-shrink:0}
.day-count{font-size:30rpx;color:#333;flex-shrink:0}
.day-amt{flex:1;text-align:right;font-size:32rpx;font-weight:600;padding-right:8rpx}
.day-amt.pos{color:#4caf50}
.day-amt.neg{color:#ef6c00}
.day-arrow{width:36rpx;text-align:center;font-size:24rpx;color:#757575;flex-shrink:0}
.order-row{display:flex;align-items:center;padding:20rpx 24rpx 20rpx 22rpx;margin-bottom:12rpx;background:#fff;border-radius:16rpx;border:1rpx solid rgba(22,58,107,0.08);border-left:6rpx solid #1e4d8c;box-shadow:0 4rpx 14rpx rgba(22,58,107,0.05)}
.order-main{flex:1;min-width:0;margin-right:16rpx}
.order-name-row{display:flex;align-items:center;gap:10rpx}
.order-name{font-size:30rpx;color:#212121;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:360rpx}
.ret-badge{background:#e53935;color:#fff;font-size:20rpx;padding:2rpx 10rpx;border-radius:20rpx;flex-shrink:0}
.order-sub-row{margin-top:8rpx;display:flex;flex-direction:row;align-items:center;flex-wrap:wrap;gap:8rpx 12rpx;min-width:0}
.order-meta{font-size:22rpx;color:#9e9e9e;flex-shrink:0;max-width:100%}
.chip-wrap{display:flex;flex-direction:row;flex-wrap:wrap;gap:8rpx;min-width:0;flex:1}
.st-chip{display:inline-block;padding:4rpx 12rpx;border-radius:8rpx;font-size:20rpx;font-weight:600;line-height:1.25;border:1rpx solid transparent}
.st-chip.paid{color:#2e7d32;background:rgba(46,125,50,0.12);border-color:rgba(46,125,50,0.22)}
.st-chip.picked{color:#1565c0;background:rgba(21,101,192,0.12);border-color:rgba(21,101,192,0.22)}
.st-chip.shipped{color:#ef6c00;background:rgba(239,108,0,0.12);border-color:rgba(239,108,0,0.22)}
.st-chip.delivered{color:#00796b;background:rgba(0,121,107,0.12);border-color:rgba(0,121,107,0.22)}
.st-chip.muted{color:#757575;background:rgba(117,117,117,0.12);border-color:rgba(117,117,117,0.22)}
.st-chip.unpaid{color:#c62828;background:rgba(198,40,40,0.1);border-color:rgba(198,40,40,0.22)}
.st-chip.agent{color:#6a1b9a;background:rgba(106,27,154,0.1);border-color:rgba(106,27,154,0.22)}
.order-amt{font-size:30rpx;font-weight:700;color:#212121;flex-shrink:0}
.order-amt.neg{color:#e53935}
.empty{padding:48rpx 40rpx;text-align:center;color:#a0aec0;font-size:28rpx}
.refresh-tip{padding:8rpx 0 16rpx;text-align:center;color:#94a3b8;font-size:22rpx}
.load-more{padding:24rpx 0 48rpx;text-align:center;font-size:24rpx;color:#9e9e9e}
.fs-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:1000;background:rgba(0,0,0,0.45);display:flex;flex-direction:column;justify-content:flex-end}
.fs-sheet{background:#fff;border-radius:24rpx 24rpx 0 0;padding:8rpx 0 0;max-height:70vh;overflow-y:auto}
.fs-title{display:block;text-align:center;font-size:30rpx;font-weight:600;color:#1a1a1a;padding:28rpx 32rpx 16rpx}
.fs-item{display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding:28rpx 40rpx;border-top:1rpx solid #f0f0f0}
.fs-item-hover{background:#f5f5f5}
.fs-lab{font-size:30rpx;color:#222}
.fs-check{font-size:32rpx;color:#1976d2;font-weight:600}
.fs-safe{height:calc(24rpx + env(safe-area-inset-bottom))}
.guest-empty{padding:120rpx 48rpx 80rpx;display:flex;flex-direction:column;align-items:center}
.guest-empty-t{font-size:34rpx;font-weight:600;color:#163a6b}
.guest-empty-d{margin-top:16rpx;text-align:center;font-size:26rpx;line-height:1.6;color:#6b7c93}
.guest-empty-btn{margin-top:40rpx;background:#2e6bb5 !important;color:#fff !important;border-radius:48rpx;font-size:30rpx}
.page.agent-skin{background:#eef6f4}
.page.agent-skin .page-head{background:linear-gradient(180deg,#d7efe9 0%,#eef6f4 48%,#f3f7f6 100%);box-shadow:none;border-bottom-color:rgba(15,118,110,0.08)}
.page-head.with-brand{padding-bottom:12rpx}
.agent-brand-row{display:flex;align-items:center;gap:20rpx;padding:8rpx 28rpx 4rpx;max-width:calc(100% - 40rpx);box-sizing:border-box}
.agent-brand-logo{width:72rpx;height:72rpx;border-radius:0;flex-shrink:0;background:transparent}
.agent-brand-info{flex:1;min-width:0}
.agent-brand-title{display:block;font-size:34rpx;font-weight:700;color:#134e4a;line-height:1.2}
.agent-brand-sub{display:block;margin-top:4rpx;font-size:22rpx;color:#3d5c58;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.agent-brand-edit{width:56rpx;height:56rpx;border-radius:14rpx;background:rgba(15,118,110,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:12rpx}
.agent-brand-edit-img{width:32rpx;height:32rpx}
.page.agent-skin .date-label,.page.agent-skin .date-pick{color:#134e4a}
.agent-list{padding:8rpx 28rpx 40rpx}
.agent-filt{display:flex;flex-wrap:nowrap;gap:12rpx;padding:8rpx 28rpx 12rpx;overflow-x:auto}
.agent-filt-chip{padding:8rpx 20rpx;border-radius:999rpx;font-size:24rpx;color:#5f6b7a;background:#eef2f6;flex-shrink:0;white-space:nowrap}
.agent-filt-chip.on{color:#0f766e;background:#d1fae5;font-weight:600}
.agent-card{background:#fff;border-radius:16rpx;padding:22rpx;margin-bottom:12rpx;border-left:8rpx solid #cbd5e1}
.agent-card.pending{border-left-color:#c026d3}
.agent-card.rejected{border-left-color:#b45309}
.agent-card.confirmed{border-left-color:#0f766e}
.agent-card.shipped{border-left-color:#2563eb}
.agent-card.delivered{border-left-color:#15803d}
.agent-card-top,.agent-card-mid{display:flex;justify-content:space-between;gap:12rpx}
.agent-no{font-weight:600;color:#134e4a}
.agent-flag,.agent-card-mid{margin-top:8rpx;color:#8a98ab;font-size:24rpx}
.agent-amt{color:#134e4a;font-weight:700}
