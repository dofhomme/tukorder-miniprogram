.page{min-height:100vh;background:#f3f6fb;padding:24rpx 28rpx 160rpx;box-sizing:border-box}
.state,.hint{display:block;color:#6b7c93;font-size:28rpx;line-height:1.6}
.state-wrap{padding:48rpx 8rpx}
.title{display:block;font-size:40rpx;font-weight:700;color:#163a6b;margin-bottom:12rpx}
.shop{display:block;color:#8a98ab;font-size:24rpx;margin-bottom:16rpx}
.search{background:#fff;border-radius:12rpx;padding:0 20rpx;margin-bottom:16rpx}
.search input{height:76rpx;font-size:28rpx}
.row{display:flex;align-items:flex-start;background:#fff;border-radius:14rpx;padding:20rpx;margin-bottom:12rpx}
.thumb-wrap{position:relative;flex-shrink:0;margin-right:16rpx}
.thumb{width:168rpx;height:168rpx;border-radius:12rpx;display:block;background:#eef3f1}
.thumb-n{position:absolute;right:6rpx;bottom:6rpx;min-width:28rpx;padding:0 8rpx;height:28rpx;line-height:28rpx;text-align:center;font-size:18rpx;color:#fff;background:rgba(0,0,0,0.45);border-radius:8rpx}
.pick-imgs{white-space:nowrap;margin:12rpx 0 4rpx;height:160rpx}
.pick-img{width:160rpx;height:160rpx;border-radius:12rpx;margin-right:12rpx;background:#eef3f1;display:inline-block;vertical-align:top}
.row-main{flex:1;min-width:0}
.code{display:block;font-weight:700;color:#163a6b}
.name,.meta,.muted{display:block;color:#8a98ab;font-size:22rpx}
.price-col{flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;align-self:stretch;gap:4rpx;margin-left:12rpx}
.base{font-size:20rpx;color:#9aa8ba}
.base.diff{text-decoration:line-through}
.price{font-weight:700;color:#1e4d8c;font-size:26rpx}
.cart{margin-top:20rpx;background:#fff;border-radius:14rpx;padding:8rpx 20rpx}
.cline{display:flex;align-items:center;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #eef2f6}
.cline:last-child{border-bottom:none}
.spin,.spin.big{display:flex;align-items:center;gap:16rpx}
.spin.big{justify-content:center;margin:20rpx 0}
.spin-btn{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;border-radius:8rpx;background:#eef3f9;color:#1e4d8c;font-size:32rpx}
.bar{position:fixed;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 16rpx rgba(22,58,107,0.06)}
.btn{margin-top:20rpx;height:80rpx;line-height:80rpx;text-align:center;border-radius:12rpx;background:#1e4d8c;color:#fff;font-weight:600}
.btn.mini{margin-top:0;padding:0 28rpx;height:72rpx;line-height:72rpx}
.btn.off{opacity:0.45;pointer-events:none}
.mask{position:fixed;inset:0;background:rgba(16,32,54,0.45);display:flex;align-items:flex-end}
.sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:8rpx 0 16rpx}
.chip{padding:8rpx 20rpx;border-radius:999rpx;background:#eef3f9;color:#163a6b;font-size:26rpx}
.chip.on{background:#1e4d8c;color:#fff}
.empty{padding:40rpx 0;text-align:center;color:#8a98ab}
