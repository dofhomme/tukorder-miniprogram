.voice-hold-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:10000020;pointer-events:none}
.voice-hold-center{position:absolute;left:64rpx;right:64rpx;top:42%;z-index:2;transform:translateY(-50%);display:flex;justify-content:center}
.voice-hold-live{display:block;width:100%;color:#163A6B;font-size:44rpx;font-weight:700;line-height:1.45;text-align:center;word-break:break-all;text-shadow:0 2rpx 16rpx rgba(255,255,255,0.95)}
.voice-hold-shade{position:absolute;left:0;right:0;bottom:0;height:72vh;box-sizing:border-box;display:flex;flex-direction:column;justify-content:flex-end;padding:0 56rpx calc(28rpx + env(safe-area-inset-bottom));overflow:visible}
.voice-hold-fan{position:absolute;left:50%;bottom:-92vw;width:184vw;height:184vw;margin-left:-92vw;border-radius:50%;transform-origin:center center;transition:transform .28s linear,opacity .28s linear;background:radial-gradient(circle at 50% 50%,rgba(30,77,140,.96) 0%,rgba(59,134,232,.72) 18%,rgba(107,179,255,.38) 36%,rgba(180,214,255,.12) 54%,rgba(255,255,255,0) 72%)}
.voice-hold-fan-soft{bottom:-108vw;width:216vw;height:216vw;margin-left:-108vw;transition:transform .46s linear,opacity .46s linear;background:radial-gradient(circle at 50% 50%,rgba(107,179,255,.42) 0%,rgba(157,206,255,.22) 28%,rgba(210,230,255,.08) 52%,rgba(255,255,255,0) 74%)}
.voice-hold-shade.cancel .voice-hold-fan{background:radial-gradient(circle at 50% 50%,rgba(229,57,53,.94) 0%,rgba(255,125,142,.7) 18%,rgba(255,174,184,.36) 36%,rgba(255,214,220,.12) 54%,rgba(255,255,255,0) 72%)}
.voice-hold-shade.cancel .voice-hold-fan-soft{background:radial-gradient(circle at 50% 50%,rgba(255,174,184,.4) 0%,rgba(255,196,204,.2) 28%,rgba(255,228,232,.08) 52%,rgba(255,255,255,0) 74%)}
.voice-hold-tip{position:relative;z-index:1;margin-bottom:28rpx;color:#ffffff;font-size:32rpx;font-weight:600;text-align:center;text-shadow:0 2rpx 12rpx rgba(22,58,107,.35)}
.voice-hold-shade.cancel .voice-hold-tip{color:#ffffff}
.voice-hold-bars{position:relative;z-index:1;height:120rpx;display:flex;align-items:flex-end}
.voice-hold-slot{flex:1;height:100%;display:flex;align-items:flex-end;justify-content:center}
.voice-hold-bar{width:6rpx;border-radius:6rpx;background:#ffffff;box-shadow:0 0 12rpx rgba(255,255,255,0.85)}
.voice-hold-shade.cancel .voice-hold-bar{background:#E85D6C}
.voice-fab{height:84rpx;padding:0 24rpx;border-radius:42rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;box-sizing:border-box;background:#ffffff;border:1rpx solid rgba(30,77,140,0.16);box-shadow:none;flex-shrink:0;white-space:nowrap}
.voice-fab.holding{background:#e8eef4}
.voice-fab.busy{opacity:0.55}
.voice-fab.icon{width:auto;height:40rpx;padding:0;border:none;border-radius:8rpx;background:transparent;box-shadow:none;gap:4rpx;justify-content:flex-start}
.voice-fab.icon.holding{background:#e8eef4}
.voice-fab.icon .voice-fab-mic-img{width:30rpx;height:30rpx}
.voice-fab.icon .voice-fab-t{font-size:24rpx;font-weight:600}
.voice-fab.quiet{height:96rpx;padding:0 28rpx 0 22rpx;border:none;border-radius:0;background:transparent;box-shadow:none;gap:10rpx}
.voice-fab.quiet.holding{background:rgba(30,77,140,0.08)}
.voice-fab.quiet .voice-fab-mic-img{width:34rpx;height:34rpx;opacity:0.75}
.voice-fab.quiet .voice-fab-t{font-size:28rpx;font-weight:600;color:#5b7390}
.voice-fab-mic-img{width:28rpx;height:28rpx;flex-shrink:0}
.voice-fab-t{font-size:28rpx;font-weight:700;line-height:1;color:#1e4d8c;white-space:nowrap;flex-shrink:0}
