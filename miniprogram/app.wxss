page{--ink:#163a6b;--ink-soft:#3d6aa0;--paper:#f3f6fb;--paper-deep:#eef3f9;--line:rgba(22,58,107,0.1);--toolbar-blue:#2e6bb5;--toolbar-button-blue:#2e6bb5;--toolbar-blue-dark:#163a6b;--chrome-bg:linear-gradient(180deg,#dbe7f5 0%,#eef3f9 55%,#f3f6fb 100%);--chrome-solid:#eef3f9;--page-bg:#f3f6fb;--table-header-bg:#e8eef4;--table-border:#d0d7de;--text-primary:#1a2b3c;--text-muted:#6b7c93;--accent-red:#e53935;background:var(--page-bg);color:var(--text-primary);font-size:28rpx;box-sizing:border-box}
.rtl{direction:rtl;font-family:"UKIJ Ekran","UKIJ Tuz","Microsoft Uighur","Noto Naskh Arabic","Noto Sans Arabic",sans-serif}
.rtl .chev{transform:scaleX(-1)}
