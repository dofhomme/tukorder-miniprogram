<view class="page {{rtl ? 'rtl' : ''}}"><view class="card account"><text class="phone">{{phone}}</text><text class="role">{{roleLabel}}</text><text class="shop" wx:if="{{shopName}}">{{i18n.shop}}：{{shopName}}</text></view><text class="sec">{{i18n.localData}}</text><view class="stats"><view class="stat"><text class="ico">📦</text><text class="n">{{productCount}}</text><text class="l">{{i18n.productsShort}}</text></view><view class="stat"><text class="ico">🧾</text><text class="n">{{orderCount}}</text><text class="l">{{i18n.ordersShort}}</text></view><view class="stat"><text class="ico">👥</text><text class="n">{{customerCount}}</text><text class="l">{{i18n.tabCustomers}}</text></view></view><text class="sec">{{i18n.pendingSync}}</text><text class="sub">{{lastSyncLabel}}</text><view class="card pending"><view class="prow" wx:for="{{pendingRows}}" wx:key="key"><text class="pl">{{item.label}}</text><text class="pc {{item.count>0?'warn':''}}">{{item.count}}</text></view><text class="aligned" wx:if="{{pendingTotal===0}}">{{i18n.alignedCloud}}</text></view><text class="sec">{{i18n.syncActions}}</text><view class="card actions"><view class="act" bindtap="onPullCloud" hover-stay-time="50" hover-start-time="0"><text class="act-ico">☁↓</text><view class="act-body"><text class="act-t">{{i18n.syncFromCloud}}</text><text class="act-s">{{i18n.syncFromCloudD}}</text></view><text class="chev">›</text></view><view class="act" bindtap="onPushCloud" hover-stay-time="50" hover-start-time="0"><text class="act-ico">☁↑</text><view class="act-body"><text class="act-t">{{i18n.uploadToCloud}}</text><text class="act-s">{{i18n.uploadToCloudD}}</text></view><text class="chev">›</text></view><view class="act" bindtap="onSyncCustomers" hover-stay-time="50" hover-start-time="0"><text class="act-ico">👥</text><view class="act-body"><text class="act-t">{{i18n.syncCustomersOnly}}</text><text class="act-s">{{i18n.syncCustomersOnlyD}}</text></view><text class="chev">›</text></view></view><text class="sec">{{i18n.shortcuts}}</text><view class="card actions"><view class="act" bindtap="go" data-url="/pages/customers/customers" hover-stay-time="50" hover-start-time="0"><text class="act-ico">👥</text><view class="act-body"><text class="act-t">{{i18n.customers}}</text></view><text class="chev">›</text></view><view class="act" wx:if="{{canManageTeam}}" bindtap="go" data-url="/pages/team/team" hover-stay-time="50" hover-start-time="0"><text class="act-ico">👥</text><view class="act-body"><text class="act-t">{{i18n.mineTeam}}</text></view><text class="chev">›</text></view></view><view class="hint-ok" wx:if="{{hint}}">{{hint}}</view></view>
