.hc-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:13000000;display:flex;align-items:center;justify-content:center;background:rgba(18,24,33,0.45);padding:32rpx;box-sizing:border-box}
.hc-card{width:100%;max-width:680rpx;background:#fff;border-radius:32rpx;padding:32rpx 32rpx 24rpx;box-sizing:border-box;box-shadow:0 24rpx 80rpx rgba(16,24,40,0.18)}
.hc-prompt{display:block;margin:0 0 20rpx;color:#243044;font-size:30rpx;line-height:1.4}
.hc-stage{position:relative;width:100%;border-radius:20rpx;overflow:hidden;background:#f3f6f8}
.hc-img{display:block;width:100%}
.hc-dot{position:absolute;width:44rpx;height:44rpx;margin:-22rpx 0 0 -22rpx;border-radius:50%;background:#163a6b;color:#fff;font-size:24rpx;line-height:44rpx;text-align:center}
.hc-err{display:block;min-height:36rpx;margin-top:12rpx;color:#c62828;font-size:24rpx;line-height:1.4}
.hc-actions{display:flex;justify-content:flex-end;margin-top:12rpx}
.hc-btn{height:64rpx;line-height:64rpx;padding:0 24rpx;margin-left:16rpx;border-radius:12rpx;background:#eef3f9;color:#1e4d8c;font-size:28rpx;font-weight:600}
