<view class="field"><text class="label">名称</text><input class="input" placeholder="填写名称" placeholder-class="ph" value="{{name}}" bindinput="onName" /></view><view class="field"><text class="label">颜色</text><input class="input" placeholder="填写颜色" placeholder-class="ph" value="{{color}}" bindinput="onColor" /></view><view class="field"><text class="label">{{specLabel}}</text><input class="input" placeholder="填写规格" placeholder-class="ph" value="{{spec}}" bindinput="onSpec" /></view><view class="field"><text class="label">单位</text><input class="input" placeholder="如 米、个" placeholder-class="ph" value="{{unit}}" bindinput="onUnit" /></view><view class="field"><text class="label">参考价</text><input class="input" type="digit" placeholder="填写参考价" placeholder-class="ph" value="{{refPrice}}" bindinput="onPrice" /></view><text class="sub">参考价只算标准成本。签收单价以后才进入实际成本。</text><view class="btn" bindtap="onSave"><image class="btn-ico" src="/assets/icons/pe-save.svg" mode="aspectFit" /><text>保存</text></view>
