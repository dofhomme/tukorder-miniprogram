<view class="page lock"><view class="pin"><text class="title">{{name}}</text><input class="find" placeholder="搜货号、单号、物流" placeholder-class="ph" value="{{q}}" confirm-type="search" bindinput="onFind" /><view class="checks"><text class="check {{docType === '' ? 'on' : ''}}" data-key="" bindtap="onTab">全部</text><text class="check {{docType === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTab">{{item.label}}</text></view></view><scroll-view class="scroller" scroll-y bindscrolltolower="onMore" lower-threshold="120"><block wx:if="{{grouped}}"><view wx:if="{{loaded && !groups.length && !loose.length}}" class="empty">{{q ? '没有匹配的记录' : '还没有记录'}}</view><view class="card cut-block" wx:for="{{groups}}" wx:for-item="group" wx:key="id"><text class="cut-done" wx:if="{{group.done}}">已完成</text><view class="cut-main" bindtap="onEdit" data-id="{{group.id}}" data-type="cut"><view class="row"><text class="rec-name">{{group.text}}</text><text class="sent">{{group.sentText}}</text><view class="rec-tools"><image class="rec-pen" src="/assets/icons/edit-outlined.svg" mode="aspectFit" /></view></view><text class="when">{{group.timeText}}</text><text class="from-factory" wx:if="{{group.filledBy === 'factory'}}">厂里提供</text></view><view class="ship" wx:for="{{group.ships}}" wx:for-item="rec" wx:key="id" bindtap="onEdit" data-id="{{rec.id}}" data-type="{{rec.docType}}"><view class="row"><text class="rec-name">{{rec.text}}</text><text class="amt">{{rec.amount}}</text><text class="pay {{rec.accepted ? 'on' : ''}}" wx:if="{{rec.canToggleAccept}}" catchtap="onToggleAccept" data-id="{{rec.id}}" data-accepted="{{rec.accepted}}" data-bound="{{rec.boundCutId}}">{{rec.acceptText}}</text><text class="pay {{rec.paid ? 'on' : ''}}" wx:if="{{rec.canPay}}" catchtap="onTogglePaid" data-id="{{rec.id}}" data-paid="{{rec.paid}}">{{rec.paid ? '已付' : '未付'}}</text><view class="rec-tools"><image class="rec-pen" src="/assets/icons/edit-outlined.svg" mode="aspectFit" /><image class="rec-trash" src="/assets/icons/pe-delete.svg" mode="aspectFit" catchtap="onDelete" data-id="{{rec.id}}" data-no="{{rec.docNo}}" data-type="{{rec.docType}}" /></view></view><text class="when">{{rec.timeText}}{{rec.timeText ? ' · ' : ''}}{{rec.docNo}}{{rec.statusText ? ' · ' + rec.statusText : ''}}{{rec.logistics ? ' · ' + rec.logistics : ''}}</text><view class="jump-row acts" wx:if="{{rec.canAccept}}"><text class="accept" catchtap="onAccept" data-id="{{rec.id}}" data-code="{{rec.productCode}}" data-qty="{{rec.qty}}">验收</text></view></view></view><view class="card" wx:if="{{loose.length}}"><text class="split-head">未对应裁剪的送货</text><view class="ship loose" wx:for="{{loose}}" wx:for-item="rec" wx:key="id" bindtap="onEdit" data-id="{{rec.id}}" data-type="{{rec.docType}}"><view class="row"><text class="rec-name">{{rec.text || rec.docNo}}</text><text class="amt">{{rec.amount}}</text><text class="pay {{rec.accepted ? 'on' : ''}}" wx:if="{{rec.canToggleAccept}}" catchtap="onToggleAccept" data-id="{{rec.id}}" data-accepted="{{rec.accepted}}" data-bound="{{rec.boundCutId}}">{{rec.acceptText}}</text><text class="pay {{rec.paid ? 'on' : ''}}" wx:if="{{rec.canPay}}" catchtap="onTogglePaid" data-id="{{rec.id}}" data-paid="{{rec.paid}}">{{rec.paid ? '已付' : '未付'}}</text><view class="rec-tools"><image class="rec-pen" src="/assets/icons/edit-outlined.svg" mode="aspectFit" /><image class="rec-trash" src="/assets/icons/pe-delete.svg" mode="aspectFit" catchtap="onDelete" data-id="{{rec.id}}" data-no="{{rec.docNo}}" data-type="{{rec.docType}}" /></view></view><text class="when">{{rec.timeText}}{{rec.statusText ? ' · ' + rec.statusText : ''}}</text><view class="jump-row acts" wx:if="{{rec.canAccept}}"><text class="accept" catchtap="onAccept" data-id="{{rec.id}}" data-code="{{rec.productCode}}" data-qty="{{rec.qty}}">验收</text></view></view></view></block><view wx:if="{{!grouped && loaded && !items.length}}" class="empty">{{q ? '没有匹配的记录' : '还没有记录'}}</view><view class="card" wx:if="{{!grouped}}" wx:for="{{items}}" wx:key="id" bindtap="onEdit" data-id="{{item.id}}" data-type="{{item.docType}}"><view class="row"><text class="rec-name">{{item.text}}</text><text class="amt" wx:if="{{item.docType !== 'cut'}}">{{item.amount}}</text><text class="pay {{item.accepted ? 'on' : ''}}" wx:if="{{item.canToggleAccept}}" catchtap="onToggleAccept" data-id="{{item.id}}" data-accepted="{{item.accepted}}" data-bound="{{item.boundCutId}}">{{item.acceptText}}</text><text class="pay {{item.paid ? 'on' : ''}}" wx:if="{{item.canPay}}" catchtap="onTogglePaid" data-id="{{item.id}}" data-paid="{{item.paid}}">{{item.paid ? '已付' : '未付'}}</text><view class="rec-tools"><image class="rec-pen" src="/assets/icons/edit-outlined.svg" mode="aspectFit" /><image class="rec-trash" wx:if="{{item.docType !== 'cut'}}" src="/assets/icons/pe-delete.svg" mode="aspectFit" catchtap="onDelete" data-id="{{item.id}}" data-no="{{item.docNo}}" data-type="{{item.docType}}" /></view></view><text class="to-factory" wx:if="{{item.factoryText}}">{{item.factoryText}}</text><text class="when">{{item.timeText}}{{item.timeText ? ' · ' : ''}}{{item.docNo}}{{item.statusText ? ' · ' + item.statusText : ''}}{{item.logistics ? ' · ' + item.logistics : ''}}</text><view class="jump-row acts" wx:if="{{item.canAccept}}"><text class="accept" catchtap="onAccept" data-id="{{item.id}}" data-code="{{item.productCode}}" data-qty="{{item.qty}}">验收</text></view></view><view class="more-tip" wx:if="{{more}}">上拉加载更多</view><view class="scroller-pad"></view></scroll-view></view><accept-sheet wx:if="{{acceptOn}}" doc-id="{{acceptId}}" code="{{acceptCode}}" qty="{{acceptQty}}" bind:done="onAcceptDone" bind:fail="onAcceptFail" bind:close="onAcceptClose" /><view class="pop-mask" wx:if="{{benchOn}}" catchtouchmove="noop" bindtap="onCloseBench"><view class="pop-sheet tall" catchtap="noop"><view class="pop-handle"></view><supply-bench class="pop-fill" party-id="{{partyId}}" role="{{role}}" edit-id="{{editId}}" edit-type="{{editType}}" bind:saved="onCloseBench" /></view></view>
