.page{min-height:100vh;background:#eef6f4;padding:24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.state,.empty,.hint{padding:40rpx 12rpx;text-align:center;color:#5f7a74;font-size:26rpx}
.head{padding:8rpx 8rpx 24rpx}
.h{display:block;font-size:40rpx;font-weight:700;color:#134e4a}
.sub{display:block;margin-top:6rpx;font-size:24rpx;color:#5f7a74}
.list{display:flex;flex-direction:column;gap:12rpx}
.row{display:flex;align-items:center;padding:28rpx 24rpx;background:#fff;border-radius:16rpx}
.row.wish{background:#e7f6f2}
.row-t{flex:1}
.row-h{display:block;font-size:30rpx;font-weight:600;color:#134e4a}
.row-n{display:block;margin-top:4rpx;font-size:22rpx;color:#5f7a74}
.chev{color:#9ab3ae;font-size:36rpx}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.card{background:#fff;border-radius:16rpx;overflow:hidden}
.cover,.cover-ph{width:100%;height:280rpx;background:#d7efe9}
.cover-ph{display:flex;align-items:center;justify-content:center;color:#3d5c58}
.code{display:block;padding:12rpx 16rpx 0;font-size:26rpx;font-weight:700;color:#134e4a}
.rm{display:block;padding:8rpx 16rpx 16rpx;font-size:22rpx;color:#b45309}
.bar{position:fixed;left:0;right:0;bottom:0;display:flex;gap:16rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:rgba(238,246,244,0.96)}
.btn{flex:1;height:80rpx;border-radius:16rpx;background:#0f766e;color:#fff;font-size:28rpx;font-weight:600;display:flex;align-items:center;justify-content:center}
.btn.ghost{background:#fff;color:#0f766e;border:2rpx solid #0f766e}
.danger{margin-top:32rpx;text-align:center;color:#b45309;font-size:26rpx}
.mask{position:fixed;inset:0;background:rgba(15,40,36,0.4);display:flex;align-items:flex-end}
.sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.title{display:block;font-size:32rpx;font-weight:700;color:#134e4a;margin-bottom:20rpx}
.ipt{background:#f3f7f6;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx;font-size:28rpx}
