@import "../workbench.wxss";.code-hits{margin-top:8rpx}
.code-hit{display:block;padding:16rpx 4rpx;font-size:28rpx;color:#163a6b;border-bottom:1rpx solid #e2e8f0}
.bench{height:100%;min-height:0;display:flex;flex-direction:column;background:linear-gradient(180deg,#dbe7f5 0%,#f3f6fb 28%);overflow:hidden}
.bench .pin{background:transparent}
.btn.invite{background:#fff;color:#1e4d8c;border:2rpx solid #1e4d8c}
.bench .pin .title{flex:1;min-width:0}
.pen{flex-shrink:0;display:flex;align-items:center;margin-left:16rpx;color:#1e4d8c;font-size:26rpx}
.bench .scroller{flex:1;height:0}
.material-cost{display:block;margin-top:8rpx;color:#1e4d8c;font-size:28rpx;font-weight:600}
.ratio-grid{display:flex;flex-wrap:wrap;width:100%;margin-bottom:0}
.ratio-col{position:relative;flex:0 0 23%;width:23%;max-width:23%;min-width:0;margin:0 2.6% 12rpx 0;box-sizing:border-box}
.ratio-col:nth-child(4n){margin-right:0}
.ratio-col .input{width:100%;height:72rpx;min-height:72rpx;line-height:72rpx;padding:0 12rpx;font-size:26rpx}
.ratio-col .size-name{margin-bottom:8rpx;padding-right:32rpx}
.ratio-x{position:absolute;right:6rpx;top:0;height:72rpx;line-height:72rpx;color:#9e9e9e;font-size:28rpx}
.ratio-add{flex:0 0 23%;width:23%;max-width:23%;margin:0 2.6% 12rpx 0;height:72rpx;line-height:72rpx;text-align:center;color:#1e4d8c;font-size:40rpx;font-weight:600;box-sizing:border-box}
.ratio-add:nth-child(4n){margin-right:0}
.ship-row{display:flex;align-items:center;gap:12rpx;margin-bottom:24rpx}
.ship-row .input{flex:1;width:0;height:72rpx;min-height:72rpx;line-height:72rpx;padding:0 16rpx;font-size:26rpx}
.ship-slip{position:relative;flex-shrink:0;width:112rpx;height:72rpx;border-radius:16rpx;background:#1e4d8c;color:#fff;font-size:24rpx;font-weight:600;display:flex;align-items:center;justify-content:center;overflow:hidden}
.ship-slip.on{background:#e8f0ff}
.ship-thumb{width:100%;height:100%}
.ship-x{position:absolute;right:0;top:0;width:32rpx;height:32rpx;line-height:30rpx;text-align:center;background:rgba(15,23,42,0.55);color:#fff;font-size:22rpx}
.input.link{color:#1e4d8c}
.input.pick{display:flex;align-items:center;justify-content:space-between}
.pick-txt{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#212121}
.pick-chev{flex-shrink:0;margin-left:12rpx;color:#64748b;font-size:24rpx;line-height:1}
.pick-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:300;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:48rpx 40rpx;box-sizing:border-box}
.pick-dialog{width:100%;max-width:680rpx;max-height:70vh;background:#fff;border-radius:28rpx;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 16rpx 48rpx rgba(0,0,0,0.22);box-sizing:border-box}
.pick-title{padding:32rpx 32rpx 16rpx;font-size:36rpx;font-weight:700;color:#1a1a1a}
.pick-search{margin:0 28rpx 12rpx;height:72rpx;padding:0 20rpx;background:#f0f2f5;border-radius:36rpx;display:flex;align-items:center;box-sizing:border-box}
.pick-search-ico{font-size:28rpx;margin-right:10rpx;opacity:0.55}
.pick-search-input{flex:1;height:72rpx;font-size:28rpx;color:#333}
.pick-ph{color:#9e9e9e}
.pick-search-clear{padding:8rpx 4rpx 8rpx 12rpx;color:#9e9e9e;font-size:28rpx}
.pick-list{height:46vh;max-height:520rpx;padding:0 8rpx;box-sizing:border-box}
.pick-row{display:flex;align-items:center;padding:22rpx 20rpx;border-bottom:1rpx solid #eee}
.pick-row.on{background:#e8f1ff}
.pick-name{flex:1;min-width:0;font-size:30rpx;font-weight:600;color:#212121;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pick-mark{flex-shrink:0;margin-left:16rpx;color:#1e4d8c;font-size:32rpx;font-weight:700}
.pick-empty{padding:80rpx 24rpx;text-align:center;color:#9e9e9e;font-size:28rpx}
.pick-actions{display:flex;align-items:center;justify-content:flex-end;padding:8rpx 16rpx 20rpx;border-top:1rpx solid #eee}
.pick-act{padding:20rpx 24rpx;font-size:28rpx;color:#1e4d8c;font-weight:500}
.pick-act.strong{font-weight:700}
