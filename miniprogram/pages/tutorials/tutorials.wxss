page{height:100vh;background:#f3f6fb}
.page{height:100vh;display:flex;flex-direction:column;background:#f3f6fb}
.list{flex:1;height:0;padding:24rpx 24rpx 12rpx;box-sizing:border-box}
.hint{display:block;margin:0 8rpx 8rpx;font-size:24rpx;color:#5b7390}
.hint.sub{margin-bottom:20rpx}
.group{margin-bottom:12rpx}
.group-title{display:block;margin:8rpx 8rpx 12rpx;font-size:26rpx;font-weight:700;color:#163a6b}
.card{display:flex;align-items:center;gap:20rpx;margin-bottom:16rpx;padding:22rpx 24rpx;background:#fff;border-radius:20rpx;border:2rpx solid transparent;box-shadow:0 8rpx 22rpx rgba(22,58,107,0.05)}
.card.on{border-color:#1e4d8c}
.play{width:84rpx;height:84rpx;border-radius:18rpx;background:#e8eef4;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.play-mark{width:0;height:0;margin-left:6rpx;border-style:solid;border-width:14rpx 0 14rpx 22rpx;border-color:transparent transparent transparent #1e4d8c}
.meta{flex:1;min-width:0}
.title{display:block;font-size:30rpx;font-weight:600;color:#212121}
.sub{display:block;margin-top:6rpx;font-size:22rpx;color:#5b7390}
.card.off .title{color:#8a98ab}
.card.off .play{background:#f2f4f7}
.card.off .play-mark{border-color:transparent transparent transparent #c5ced8}
.desk{height:46%;min-height:320rpx;display:flex;flex-direction:column;background:#fff;border-top:2rpx solid #e4eaf2}
.desk-log{flex:1;height:0;padding:16rpx 24rpx 8rpx;box-sizing:border-box}
.msg{margin-bottom:16rpx}
.who{display:block;margin-bottom:6rpx;font-size:22rpx;color:#5b7390}
.msg.me .who{text-align:right}
.body{display:block;padding:16rpx 18rpx;border-radius:16rpx;background:#f3f6fb;color:#163a6b;font-size:26rpx;line-height:1.5;white-space:pre-wrap}
.msg.me .body{background:#1e4d8c;color:#fff}
.play-btn{display:inline-block;margin-top:10rpx;padding:8rpx 22rpx;border-radius:999rpx;background:#1e4d8c;color:#fff;font-size:24rpx}
.desk-bar{display:flex;align-items:center;gap:12rpx;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));border-top:2rpx solid #e4eaf2}
.desk-input{flex:1;height:72rpx;padding:0 20rpx;border-radius:16rpx;background:#f3f6fb;color:#163a6b;font-size:28rpx}
.desk-ph{color:#5b7390}
.send{flex-shrink:0;height:72rpx;line-height:72rpx;padding:0 28rpx;border-radius:16rpx;background:#1e4d8c;color:#fff;font-size:28rpx}
