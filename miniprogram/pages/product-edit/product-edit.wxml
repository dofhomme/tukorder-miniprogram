<wxs src="../../utils/media.wxs" module="media" /><wxs module="cw">
function width(code) {
  var s = code == null ? '' : '' + code
  var n = s.length
  var w = 0
  var i = 0
  var c = 0
  for (i = 0; i < n; i++) {
    c = s.charCodeAt(i)
    w += c > 255 ? 1 : 0.62
  }
  if (w < 1.2) w = 1.2
  return (w + 0.35) + 'em'
}
module.exports.width = width
