@import "./common.wxss";.page{padding:8rpx 12rpx 48rpx}
.stage{position:relative;width:726rpx;height:726rpx;margin:0 auto}
.orbit{position:absolute;left:14%;top:14%;width:72%;height:72%;border:2rpx solid #d7e0ea;border-radius:50%;box-sizing:border-box}
.hub{position:absolute;left:50%;top:50%;width:228rpx;height:228rpx;margin-left:-114rpx;margin-top:-114rpx;border-radius:50%;background:#1e4d8c;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 16rpx 36rpx rgba(30,77,140,0.28);z-index:2}
.hub.hit,.hub.focus{box-shadow:0 0 0 6rpx #c5d6ea,0 16rpx 36rpx rgba(30,77,140,0.28)}
.hub-ico{width:48rpx;height:48rpx;margin-bottom:8rpx}
.hub-title{font-size:32rpx;font-weight:700;line-height:1.2}
.hub-meta{margin-top:6rpx;font-size:24rpx;color:rgba(255,255,255,0.86)}
.node{position:absolute;width:148rpx;transform:translate(-50%,-52rpx);display:flex;flex-direction:column;align-items:center;z-index:3}
.ico{width:52rpx;height:52rpx}
.name{margin-top:10rpx;font-size:26rpx;font-weight:600;color:#1f2937;line-height:1.2}
.meta{margin-top:2rpx;font-size:22rpx;color:#64748b;line-height:1.2}
.meta.warn{color:#e53935;font-weight:700}
.dot{position:absolute;top:6rpx;right:6rpx;width:14rpx;height:14rpx;border-radius:50%;background:#e53935;border:2rpx solid #fff}
.hub .dot{top:22rpx;right:28rpx}
.search{display:flex;align-items:center;margin:20rpx 8rpx 0;padding:8rpx 8rpx 8rpx 28rpx;background:#fff;border-radius:18rpx;box-shadow:0 8rpx 24rpx rgba(15,23,42,0.06)}
.search-input{flex:1;height:76rpx;font-size:28rpx;color:#1f2937}
.search-btn{width:132rpx;height:76rpx;line-height:76rpx;text-align:center;background:#1e4d8c;color:#fff;border-radius:14rpx;font-size:28rpx;font-weight:600}
