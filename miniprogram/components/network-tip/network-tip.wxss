.net-mask{position:fixed;z-index:80;left:0;right:0;top:0;bottom:0;display:flex;align-items:stretch;justify-content:center;padding:24rpx 24rpx 160rpx;background:#f3f5f8;box-sizing:border-box}
.net-card{flex:1;width:100%;background:#fff;border-radius:24rpx;box-shadow:0 8rpx 28rpx rgba(31,42,55,0.06);padding:48rpx 40rpx 36rpx;box-sizing:border-box;display:flex;flex-direction:column}
.net-main{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center}
.cloud-icon{width:168rpx;height:160rpx;margin-bottom:28rpx}
.net-title{display:block;text-align:center;font-size:34rpx;font-weight:700;color:#1f2a37}
.net-sub{display:block;margin-top:12rpx;text-align:center;font-size:24rpx;color:#8a94a6}
.net-actions{display:flex;justify-content:flex-end}
.net-retry{background:#2f6bff;color:#fff;font-size:26rpx;font-weight:600;border-radius:999rpx;padding:14rpx 32rpx}
