<view class="page"><view class="card" wx:if="{{docNo}}"><text class="title">{{docNo}}</text><text class="sub">{{statusText}} · ¥{{amount}} · 照片 {{files}} 张</text><text class="sub" wx:if="{{issuedAt}}">发料时间 {{issuedAt}}</text><text class="sub" wx:if="{{bolts}}">{{bolts}} 匹</text><text class="sub" wx:if="{{logisticsName || logisticsNo}}">{{logisticsName}} {{logisticsNo}}</text></view><block wx:if="{{!id}}"><view class="field" wx:if="{{needMaterial}}"><text class="label">物料</text><picker mode="selector" range="{{materials}}" range-key="label" value="{{materialIndex}}" bindchange="onMaterial"><view class="input">{{materials[materialIndex].label || '请先在物料档案里建好'}}</view></picker></view><view class="checks" wx:if="{{needBatch && role === 'factory'}}"><text class="check {{batchMode === 'cmt' ? 'on' : ''}}" data-mode="cmt" bindtap="onMode">来料加工</text><text class="check {{batchMode === 'package' ? 'on' : ''}}" data-mode="package" bindtap="onMode">包工包料</text></view><view class="field" wx:if="{{needBatch}}"><text class="label">货号</text><input class="input" placeholder="填写货号" placeholder-class="ph" value="{{productCode}}" bindinput="onCode" /></view><view class="field"><text class="label">米数</text><input class="input" type="digit" placeholder="填写米数" placeholder-class="ph" value="{{meters}}" bindinput="onMeters" /></view><view class="field"><text class="label">数量 / 件数</text><input class="input" type="digit" placeholder="填写数量" placeholder-class="ph" value="{{qty}}" bindinput="onQty" /></view><view class="field"><text class="label">尺码</text><input class="input" placeholder="填写尺码" placeholder-class="ph" value="{{size}}" bindinput="onSize" /></view><view class="field"><text class="label">单价（发料由服务端取最近签收价）</text><input class="input" type="digit" placeholder="填写单价" placeholder-class="ph" value="{{unitPrice}}" bindinput="onPrice" /></view><view class="field"><text class="label">物流单号</text><input class="input" placeholder="没有可留空" placeholder-class="ph" value="{{logisticsNo}}" bindinput="onLogistics" /></view><view class="btn" bindtap="onSave"><image class="btn-ico" src="/assets/icons/pe-save.svg" mode="aspectFit" /><text>保存</text></view></block><block wx:else><view class="photos" wx:if="{{fileList.length}}"><view class="photo" wx:for="{{fileList}}" wx:key="id"><image class="thumb" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="onPreview" /><text class="photo-x" data-id="{{item.id}}" catchtap="onDeleteFile">删除</text></view></view><view class="btn" bindtap="onPhoto">上传照片</view><view class="btn" wx:if="{{status === 'draft'}}" bindtap="onSubmit">提交</view><view class="btn" wx:if="{{status === 'pending' && docType !== 'fabric_in'}}" bindtap="onAccept">验收</view><view class="btn" wx:if="{{status === 'accepted'}}" bindtap="onStatement">放入本期对账</view><view class="field" wx:if="{{statement}}"><text class="label">付款金额 · {{statement.statementNo}} 未付 {{statement.unpaid}}</text><input class="input" type="digit" value="{{payAmount}}" placeholder="{{statement.unpaid}}" placeholder-class="ph" bindinput="onPayAmount" /></view><view class="btn" wx:if="{{statement}}" bindtap="onPay">上传截图并付款</view><view class="btn ghost" wx:if="{{docType !== 'cut'}}" bindtap="onDelete">删除这张单据</view></block></view>
