<view class="page {{rtl ? 'rtl' : ''}}"><view class="bar"><text class="title">{{i18n.stockChange}}</text><text class="link" bindtap="onAdd" hover-stay-time="50" hover-start-time="0">{{i18n.register}}</text></view><view class="card" wx:for="{{list}}" wx:key="cloudUid"><view class="top"><text class="code">{{item.productCode}}</text><text class="type">{{item.type}}</text></view><text class="name">{{item.productName}}</text><text class="meta">{{i18n.colQty}} {{item.quantity}} · {{item.stockAfter != null ? item.stockAfter : '—'}}</text><text class="meta muted">{{item.createdAt || ''}} {{item.createdByName || ''}}</text></view><view wx:if="{{!list.length}}" class="empty">{{i18n.noLedger}}</view></view>
