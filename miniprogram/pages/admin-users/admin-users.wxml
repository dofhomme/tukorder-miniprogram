<view class="page {{rtl ? 'rtl' : ''}}"><view class="meta">{{i18n.suggestCount}} {{users.length}} {{i18n.registeredUsers}}（{{i18n.admin}} {{adminPhone}} {{i18n.adminCannotDelete}}）</view><view wx:if="{{loading}}" class="loading">{{i18n.loading}}</view><view wx:elif="{{loadError}}" class="empty" bindtap="load">{{loadError}}，{{i18n.tapRetry}}</view><view wx:elif="{{!users.length}}" class="empty">{{i18n.noUsers}}</view><view class="row" wx:for="{{users}}" wx:key="id"><view class="main" bindtap="onEdit" data-id="{{item.id}}" hover-stay-time="50" hover-start-time="0"><view class="top"><text class="phone">{{item.phone}}</text><text class="tag" wx:if="{{item.isAdmin}}">{{i18n.admin}}</text><text class="tag me" wx:if="{{item.phone===myPhone}}">{{i18n.currentMe}}</text></view><text class="line">{{i18n.nickname}}：{{item.nickname || '—'}}</text><text class="line">clientId：{{item.clientId || '—'}}</text><text class="line">{{i18n.registeredAt}}：{{item.createdLabel}}</text><text class="line">{{item.accessLabel || '未开通'}}</text></view><view class="side"><view
        class="trial-open {{item.paid ? 'paid' : ''}}"
        catchtap="onTrial"
        data-id="{{item.id}}"
      >{{item.trialBtn}}</view><text class="more" catchtap="onMore" data-id="{{item.id}}" hover-stay-time="50" hover-start-time="0">⋮</text></view></view><view class="menu-mask" wx:if="{{menuId}}" catchtap="onCloseMenu" hover-stay-time="50" hover-start-time="0"><view class="menu-sheet" catchtap="noop" hover-stay-time="50" hover-start-time="0"><view class="mi" bindtap="onMenuEdit" hover-stay-time="50" hover-start-time="0">{{i18n.edit}}</view><view class="mi" bindtap="onMenuCopy" hover-stay-time="50" hover-start-time="0">{{i18n.copyClientId}}</view><view class="mi danger" bindtap="onMenuDelete" hover-stay-time="50" hover-start-time="0">{{i18n.delete}}</view></view></view><view class="dlg-mask" wx:if="{{trialUserId}}" catchtouchmove="noop"><view class="dlg" catchtap="noop"><text class="dlg-t">开通试用</text><text class="trial-d">给 {{trialPhone}} 开通。权限与付费套餐1相同，从现在起算。已付费账号不能改成试用。</text><view class="trial-row"><input class="trial-in" type="number" value="{{trialDays}}" bindinput="onTrialDays" /><text class="trial-unit">天</text></view><view class="dlg-actions"><view class="btn ghost" bindtap="onTrialCancel">取消</view><view class="btn ok" bindtap="onGrantTrial">{{trialSaving ? '开通中' : '开通'}}</view></view></view></view><view class="dlg-mask" wx:if="{{showEdit}}" catchtouchmove="noop"><view class="dlg" catchtap="noop" hover-stay-time="50" hover-start-time="0"><text class="dlg-t">{{i18n.editUser}} #{{editId}}</text><input class="dlg-in" placeholder="{{i18n.phoneNumber}}" value="{{editPhone}}" bindinput="onEditPhone" disabled="{{editIsAdmin}}" /><input class="dlg-in" password placeholder="{{i18n.newPwdKeep}}" value="{{editPwd}}" bindinput="onEditPwd" /><input class="dlg-in" placeholder="{{i18n.nicknameOpt}}" value="{{editNick}}" bindinput="onEditNick" /><input class="dlg-in" placeholder="{{i18n.clientIdLab}}" value="{{editClient}}" bindinput="onEditClient" /><view class="dlg-actions"><view class="btn ghost" bindtap="onEditCancel" hover-stay-time="50" hover-start-time="0">{{i18n.cancel}}</view><view class="btn ok" bindtap="onEditSave" hover-stay-time="50" hover-start-time="0">{{i18n.save}}</view></view></view></view></view>
