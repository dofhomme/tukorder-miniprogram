@import "./common.wxss";.find{width:100%;height:64rpx;background:#fff;border:2rpx solid #dbe3ee;border-radius:999rpx;box-shadow:0 6rpx 16rpx rgba(22,58,107,0.05);padding:0 24rpx;font-size:28rpx;color:#212121;box-sizing:border-box}
.agent-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.agent-main{flex:1;min-width:0}
.agent-main .title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.agent-main .sub{margin-top:6rpx}
.agent-amts{display:flex;flex-direction:column;align-items:flex-end;gap:6rpx;flex-shrink:0}
.agent-amts .amt{font-size:26rpx;line-height:1.3;white-space:nowrap}
.amt.back{color:#1a6b45}
.invite-tip{display:block;padding:0 28rpx 12rpx;font-size:24rpx;color:#6b7c93;line-height:1.5}
.invite-q{margin:0 28rpx 16rpx;width:calc(100% - 56rpx)}
.pick-on{box-shadow:0 0 0 2rpx #1e4d8c}
.share{margin:0;padding:22rpx 0;line-height:1.2;border:none;border-radius:20rpx;background:#1e4d8c;color:#fff;font-size:30rpx;font-weight:600}
.share::after{border:none}
.share[disabled]{background:#c5d4ea;color:#fff}
