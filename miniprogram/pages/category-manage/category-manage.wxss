.page{min-height:100vh;background:#fff;box-sizing:border-box;position:relative}
.loading,.empty,.err{padding:160rpx 48rpx;text-align:center;color:#757575;font-size:30rpx}
.empty-sub{display:block;margin-top:12rpx;font-size:26rpx;color:#9e9e9e}
.err-txt{display:block;margin-bottom:32rpx;color:#757575}
.retry{display:inline-block;background:#1e4d8c;color:#fff;font-size:28rpx;padding:0 40rpx;height:72rpx;line-height:72rpx;border-radius:12rpx}
.list{height:100vh;box-sizing:border-box;padding:8rpx 24rpx 0}
.list-pad{height:200rpx}
.divider{height:1rpx;background:#eeeeee;margin-left:72rpx}
.row{display:flex;align-items:center;min-height:104rpx;padding:8rpx 0;background:#fff}
.row.dragging{background:#f5f7fa;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.08);z-index:2}
.drag{width:72rpx;height:88rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.drag-ico{font-size:36rpx;color:#bdbdbd;letter-spacing:-4rpx}
.name{flex:1;font-size:32rpx;color:#212121;padding-right:16rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.acts{display:flex;align-items:center;flex-shrink:0}
.act{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center}
.act.edit .act-ico{width:40rpx;height:40rpx}
.act.del .act-ico{color:#e53935;font-size:32rpx}
.fab{position:fixed;right:40rpx;bottom:calc(48rpx + env(safe-area-inset-bottom));background:#1e4d8c;color:#fff;font-size:30rpx;font-weight:600;padding:0 40rpx;height:96rpx;line-height:96rpx;border-radius:48rpx;box-shadow:0 8rpx 24rpx rgba(30,77,140,0.35);z-index:10}
.busy-mask{position:fixed;inset:0;background:rgba(0,0,0,0.12);z-index:40;display:flex;align-items:center;justify-content:center}
.busy-box{background:rgba(0,0,0,0.7);color:#fff;padding:24rpx 40rpx;border-radius:12rpx;font-size:28rpx}
.mask{position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:50;display:flex;align-items:center;justify-content:center;padding:48rpx;box-sizing:border-box}
.dlg{width:100%;max-width:640rpx;background:#fff;border-radius:28rpx;padding:36rpx 36rpx 20rpx;box-sizing:border-box;box-shadow:0 16rpx 48rpx rgba(0,0,0,0.22)}
.dlg-title{display:block;font-size:36rpx;font-weight:700;color:#1a1a1a;margin-bottom:24rpx}
.dlg-body{display:block;font-size:30rpx;color:#424242;line-height:1.5;margin-bottom:24rpx;white-space:pre-wrap}
.dlg-input-wrap{border-bottom:2rpx solid #bdbdbd;margin-bottom:28rpx;padding:8rpx 0 12rpx}
.finput{width:100%;height:64rpx;font-size:32rpx;color:#212121}
.dlg-ph{color:#9e9e9e}
.dlg-acts{display:flex;justify-content:flex-end;align-items:center;gap:12rpx}
.dlg-btn{min-width:120rpx;height:72rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;color:#616161;font-weight:600;border-radius:12rpx}
.dlg-btn.filled{background:#1e4d8c;color:#fff}
.dlg-btn.danger{color:#e53935}
