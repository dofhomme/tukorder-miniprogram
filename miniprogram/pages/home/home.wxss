.guest-brand{font-size:42rpx;font-weight:700;color:var(--ink-deep);letter-spacing:3rpx;line-height:1.2}
.guest-pitch{margin-top:12rpx;max-width:560rpx;text-align:center;font-size:24rpx;color:var(--muted);letter-spacing:1rpx;line-height:1.45}
.guest-feats{display:flex;flex-wrap:wrap;justify-content:space-between;width:100%}
.guest-feat{width:48%;flex:0 0 48%;max-width:48%;margin-bottom:18rpx;box-sizing:border-box;min-height:168rpx;padding:22rpx 20rpx 24rpx;border-radius:16rpx;background:rgba(255,255,255,0.82);border:1rpx solid var(--line);display:flex;flex-direction:column}
.guest-feats.is-in .guest-feat{animation:guestFeatIn 200ms ease-out both}
.guest-feats.is-in .guest-feat:nth-child(1){animation-delay:0ms}
.guest-feats.is-in .guest-feat:nth-child(2){animation-delay:60ms}
.guest-feats.is-in .guest-feat:nth-child(3){animation-delay:120ms}
.guest-feats.is-in .guest-feat:nth-child(4){animation-delay:180ms}
.guest-feats.is-in .guest-feat:nth-child(5){animation-delay:240ms}
.guest-feats.is-in .guest-feat:nth-child(6){animation-delay:300ms}
@keyframes guestFeatIn{from{opacity:0;transform:translateY(12rpx)}
to{opacity:1;transform:translateY(0)}
}
.guest-feat-ico{width:44rpx;height:44rpx;margin-bottom:14rpx;opacity:0.92}
