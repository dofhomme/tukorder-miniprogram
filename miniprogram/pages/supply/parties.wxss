@import "./common.wxss";.row .title{flex:1;min-width:0}
.row .amt{flex-shrink:0;margin-left:16rpx}
.fold{flex-shrink:0;margin-left:12rpx;padding:8rpx 8rpx 8rpx 16rpx;color:#64748b;font-size:24rpx;line-height:1}
.recs{margin-top:20rpx;padding:16rpx 16rpx 8rpx;background:#f4f7fb;border-radius:16rpx}
.empty-rec{margin-top:0;padding:8rpx 4rpx 12rpx}
.rec{margin-top:0;margin-bottom:12rpx;padding:16rpx 16rpx 16rpx 18rpx;background:#fff;border-radius:16rpx;border-left:6rpx solid #1e4d8c}
.cut-block{margin-bottom:16rpx;background:#fff;border-radius:16rpx;border-left:6rpx solid #1e4d8c;overflow:hidden;position:relative}
.cut-main{padding:16rpx 16rpx 12rpx 18rpx}
.sent{flex-shrink:0;margin-left:12rpx;color:#1e4d8c;font-size:24rpx;font-weight:600}
.from-factory{display:inline-block;margin-top:8rpx;padding:2rpx 12rpx;border-radius:999rpx;background:#e8f1ff;color:#1e4d8c;font-size:22rpx;font-weight:600}
.ship{margin:0 12rpx 12rpx 24rpx;padding:12rpx 14rpx;background:#f4f7fb;border-radius:12rpx}
.ship .when{font-size:24rpx;font-weight:500;color:#64748b}
.all{display:flex;align-items:center;justify-content:flex-end;gap:6rpx;margin-top:0;padding:4rpx 4rpx 8rpx;color:#1e4d8c;font-size:26rpx}
.all-ico{width:28rpx;height:28rpx;flex-shrink:0}
.rec-name{flex:1;min-width:0;font-size:30rpx;font-weight:600;color:#212121;word-break:break-all}
.dock-2{display:flex;gap:16rpx}
.dock-2 .btn{flex:1}
.dock-3{display:flex;gap:12rpx}
.dock-3 .btn{flex:1;padding-left:8rpx;padding-right:8rpx;font-size:28rpx}
.btn.line{background:#fff;color:#1e4d8c;border:2rpx solid #1e4d8c}
.off-title{display:block;margin:8rpx 8rpx 16rpx;color:#6b7c93;font-size:26rpx}
.card.off{background:#f4f7fb;box-shadow:none}
.amt.zero{color:#94a3b8}
.off-acts{display:flex;justify-content:flex-end;align-items:center;gap:28rpx;margin-top:16rpx}
.off-acts .photo-x{margin-top:0}
.pop-sheet.tall supply-bench{flex:1;height:0;min-height:0}
