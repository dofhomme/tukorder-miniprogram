.page{height:100vh;background:#f5f6f8;position:relative;box-sizing:border-box;overflow:hidden}
.body{height:100%;box-sizing:border-box}
.body-pad{height:calc(140rpx + env(safe-area-inset-bottom))}
.tap-hover{opacity:0.72}
.banner{display:flex;align-items:center;gap:12rpx;padding:20rpx 32rpx;background:#e8f5e9}
.banner-ico{color:#2e7d32;font-size:32rpx;font-weight:700}
.banner-txt{flex:1;color:#2e7d32;font-size:26rpx;font-weight:600}
.form{padding:24rpx}
.field.outlined{display:flex;align-items:flex-start;gap:12rpx;background:#fff;border:1rpx solid #cfd8dc;border-radius:12rpx;padding:16rpx 20rpx 12rpx;margin-bottom:20rpx;box-sizing:border-box}
.field.outlined.block{display:block}
.prefix{width:40rpx;height:40rpx;margin-top:28rpx;flex-shrink:0}
.prefix.sm{width:36rpx;height:36rpx;margin-top:0;margin-right:8rpx}
.field-body{flex:1;min-width:0}
.field-body.full{width:100%}
.flabel{display:block;font-size:22rpx;color:#757575;margin-bottom:4rpx}
.req{color:#e53935}
.finput{width:100%;min-height:56rpx;padding:0;font-size:30rpx;color:#212121;background:transparent;box-sizing:border-box}
.finput.picker{line-height:56rpx}
.finput.custom{margin-top:8rpx;padding-top:8rpx;border-top:1rpx dashed #e0e0e0;font-size:26rpx;color:#616161}
.finput.ph,.ph{color:#9e9e9e}
.farea{width:100%;min-height:140rpx;padding:8rpx 0 0;font-size:28rpx;color:#212121;box-sizing:border-box}
.items-card{background:#fafafa;border:1rpx solid #e0e0e0;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx}
.items-head{display:flex;align-items:center;margin-bottom:16rpx}
.items-title{font-size:28rpx;font-weight:600;color:#212121}
.add-line{margin-left:auto;color:#1e4d8c;font-size:26rpx;font-weight:600}
.col-head{display:flex;align-items:center;gap:10rpx;margin-bottom:10rpx;padding:0 4rpx}
.ch{font-size:22rpx;color:#9e9e9e}
.ch.code{flex:5}
.ch.name{flex:5}
.ch.qty{flex:3;text-align:center}
.ch.del{width:56rpx;flex-shrink:0}
.item-row{display:flex;align-items:center;gap:10rpx;margin-bottom:12rpx}
.cell{height:72rpx;padding:0 12rpx;background:#fff;border:1rpx solid #cfd8dc;border-radius:8rpx;font-size:26rpx;box-sizing:border-box}
.cell.code{flex:5;min-width:0}
.cell.name{flex:5;min-width:0}
.cell.qty{flex:3;min-width:0;text-align:center}
.item-del{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.del-img{width:40rpx;height:40rpx}
.item-line{display:flex;gap:16rpx;padding:12rpx 0;border-bottom:1rpx solid #eee;font-size:28rpx;color:#212121}
.item-line .dim{color:#757575}
.item-line .qty-t{margin-left:auto;color:#1e4d8c;font-weight:600}
.meta{padding:8rpx 8rpx 24rpx;font-size:22rpx;color:#9e9e9e}
.meta-line{display:block;line-height:1.6}
.footer{position:fixed;left:0;right:0;bottom:0;z-index:100;display:flex;gap:20rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e8e8e8;box-sizing:border-box;box-shadow:0 -4rpx 16rpx rgba(0,0,0,0.04)}
.fbtn{flex:1;height:88rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;border-radius:14rpx;font-size:30rpx;font-weight:600;box-sizing:border-box}
.fbtn.outline{background:#fff;color:#1e4d8c;border:2rpx solid #1e4d8c}
.fbtn.outline.danger{color:#e53935;border-color:#e53935}
.fbtn.handled{background:#2e7d32;color:#fff}
.fico{width:36rpx;height:36rpx}
