<view class="page lock"><view class="pin"><input class="find" placeholder="搜索代理" placeholder-class="ph" value="{{q}}" confirm-type="search" bindinput="onFind" /></view><scroll-view class="scroller" scroll-y bindscrolltolower="onMore" lower-threshold="120"><view wx:if="{{loaded && !items.length}}" class="empty">{{q ? '没有匹配的代理' : '还没有代理拿货'}}</view><view class="card agent-row" wx:for="{{items}}" wx:key="name" bindtap="onOpen" data-name="{{item.name}}"><view class="agent-main"><text class="title">{{item.name}}</text><text class="sub">拿货 {{item.orders}} 单 · 退货 {{item.returns}} 单</text></view><view class="agent-amts" wx:if="{{item.unpaidSalesText || item.unpaidRefundText}}"><text class="amt" wx:if="{{item.unpaidSalesText}}">未收 ¥{{item.unpaidSalesText}}</text><text class="amt back" wx:if="{{item.unpaidRefundText}}">未退 ¥{{item.unpaidRefundText}}</text></view></view><view class="more-tip" wx:if="{{more}}">上拉加载更多</view><text class="sub">点进一家，未付销售单勾选后记已收。未退的单点一下，变成已退款。</text><view class="scroller-pad"></view></scroll-view><view class="dock"><view class="btn" bindtap="onInvite">邀请代理</view></view></view><view class="pop-mask" wx:if="{{orderOn}}" catchtouchmove="noop" bindtap="onCloseOrder"><view class="pop-sheet tall" catchtap="noop"><view class="pop-handle"></view><text class="pop-title">{{orderName}}</text><scroll-view class="pop-body" scroll-y bindscrolltolower="onOrderMore" lower-threshold="120"><view class="card order-card {{picked[item.id] ? 'on' : ''}}" wx:for="{{orders}}" wx:key="id" bindtap="onPick" data-id="{{item.id}}"><view class="order-line"><view class="tick-box {{picked[item.id] ? 'on' : ''}}" wx:if="{{!item.isPaid && !item.isReturn}}"><view class="tick" wx:if="{{picked[item.id]}}"></view></view><view class="order-main"><text class="title">{{item.orderNo}}</text><text class="sub">¥{{item.amount}} · {{item.createdAt}}</text></view><text wx:if="{{item.isReturn && !item.isPaid}}" class="pay" catchtap="onRefund" data-id="{{item.id}}">未退</text><text wx:else class="pay {{item.isPaid ? 'on' : ''}}">{{item.isReturn ? '已退款' : (item.isPaid ? '已收' : '未收')}}</text></view></view><view class="more-tip" wx:if="{{orderMore}}">上拉加载更多</view><view class="pop-pad"></view></scroll-view><view class="pop-dock"><view class="btn" bindtap="onPaid">把勾选的销售单记成已收</view></view></view></view><view class="pop-mask" wx:if="{{inviteOn}}" catchtouchmove="noop" bindtap="onCloseInvite"><view class="pop-sheet tall" catchtap="noop"><view class="pop-handle"></view><text class="pop-title">邀请代理</text><text class="invite-tip">发给对方后，微信登录即绑定这个客户名称</text><input class="input invite-q" placeholder="搜索客户" value="{{inviteQ}}" bindinput="onInviteQ" /><scroll-view class="pop-body" scroll-y><view wx:if="{{!inviteList.length}}" class="empty">没有客户</view><view
        class="card {{invitePick === item.id ? 'pick-on' : ''}}"
        wx:for="{{inviteList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onInvitePick"
      ><view class="row"><text class="title">{{item.name}}</text><text class="sub" wx:if="{{item.wxBound}}">已绑定</text></view></view><view class="pop-pad"></view></scroll-view><view class="pop-dock"><button class="btn share" open-type="share" disabled="{{!inviteToken || inviteBusy}}">{{inviteLabel}}</button></view></view></view>
