.page{min-height:100vh;background:#f5f6f8;padding:24rpx;box-sizing:border-box}
.tip{font-size:24rpx;color:#757575;margin-bottom:16rpx;line-height:1.5}
.row{display:flex;align-items:center;justify-content:space-between;background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}
.row.pick{align-items:flex-start}
.meta{flex:1;min-width:0;padding-right:16rpx}
.lab{display:block;font-size:28rpx;color:#212121;font-weight:600}
.link{font-size:28rpx;color:#1e4d8c;flex-shrink:0;margin-top:4rpx}
.save{margin-top:8rpx;height:88rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;background:#1e4d8c;color:#fff;border-radius:12rpx;font-size:30rpx;font-weight:600}
.save-ico{width:32rpx;height:32rpx;flex-shrink:0}
.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}
.title{font-size:30rpx;font-weight:700;color:#212121}
.hint{display:block;font-size:22rpx;color:#90a4ae;margin-top:6rpx}
.chunk{display:block;font-size:28rpx;color:#1565c0;font-weight:700;margin:12rpx 0 4rpx}
.meta{font-size:22rpx;color:#757575;margin:8rpx 0 4rpx}
.slider{margin:8rpx 0 16rpx}
.sec{font-size:28rpx;font-weight:700;margin:12rpx 0 8rpx}
.empty{color:#9e9e9e;font-size:26rpx}
.tel{font-size:26rpx;color:#424242;padding:12rpx 0;border-bottom:1rpx solid #f0f0f0}
