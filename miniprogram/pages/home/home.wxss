.page{height:100vh;display:flex;flex-direction:column;background:#f3f6fb;overflow:hidden}
.toolbar{background:linear-gradient(180deg,#dbe7f5 0%,#eef3f9 52%,#f3f6fb 100%);box-shadow:0 1rpx 0 rgba(22,58,107,0.08);border-bottom:1rpx solid rgba(22,58,107,0.06)}
.status-spacer{width:100%}
.capsule-gap{width:100%}
.capsule-gap.nav-row{display:flex;align-items:center;justify-content:flex-start;padding-left:24rpx;padding-right:200rpx;box-sizing:border-box}
.toolbar-body{margin-top:0;padding:8rpx 20rpx 16rpx}
.bill-head{display:flex;align-items:center;justify-content:center;padding:8rpx 28rpx 4rpx;box-sizing:border-box}
.bill-head.has-qr{display:flex;flex-direction:row;align-items:flex-start;justify-content:center;column-gap:12rpx;margin:0;padding:8rpx 0 4rpx;overflow:visible}
.bill-head.has-qr .bill-title{flex:1;min-width:0}
.bill-qr{width:176rpx;min-width:176rpx;flex:0 0 176rpx;display:flex;flex-direction:column;align-items:center}
.bill-qr-img,.bill-qr-ph{width:176rpx;height:176rpx;background:#fff;border-radius:12rpx;box-sizing:border-box;border:1rpx solid rgba(22,58,107,0.12)}
.bill-qr-ph{border-style:dashed;border-color:rgba(22,58,107,0.22)}
.bill-qr-cap{margin-top:8rpx;max-width:176rpx;font-size:20rpx;line-height:1.2;color:#5b7390;text-align:center}
.bill-title{min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:0 8rpx}
.bill-shop-row{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:center;max-width:100%}
.bill-shop{font-weight:700;line-height:1.25;color:#163a6b;text-align:center}
.bill-mark{font-size:28rpx;font-weight:700;color:#e53935}
.bill-sub{margin-top:8rpx;max-width:100%;font-size:24rpx;line-height:1.35;color:#5b7390;text-align:center;white-space:pre-wrap}
.meta-row{display:flex;align-items:center;justify-content:center;margin-top:16rpx;padding:0 28rpx;box-sizing:border-box}
.meta-fields{display:flex;flex-direction:row;align-items:center;justify-content:center;width:100%;min-width:0;gap:24rpx}
.meta-field{display:flex;align-items:center;justify-content:center;flex:1;height:64rpx;min-width:0}
.meta-field.customer{flex:1;min-width:0}
.meta-field.time{flex:1;min-width:0}
.meta-k{flex:none;margin-right:10rpx;font-size:28rpx;font-weight:600;line-height:64rpx;color:#5b7390}
.meta-field.customer .meta-line{position:relative;flex:1;width:auto;min-width:0;max-width:none;height:64rpx;min-height:0;margin:0;padding:0 28rpx;align-items:center;justify-content:center;border-bottom:2rpx solid rgba(30,77,140,0.35)}
.meta-name-x{position:absolute;right:0;top:18rpx;width:28rpx;height:28rpx;line-height:26rpx;text-align:center;font-size:26rpx;font-weight:600;color:#8aa0b8;z-index:2}
.meta-field.customer .meta-v{font-size:32rpx;font-weight:600;line-height:64rpx;color:#163a6b;text-align:center}
.meta-field.time .meta-line{flex:1;width:auto;min-width:0;max-width:none;height:64rpx;min-height:0;margin:0;padding:0 28rpx;align-items:center;justify-content:center;border-bottom:2rpx solid rgba(30,77,140,0.35)}
.meta-field.time .meta-v{font-size:30rpx;font-weight:600;line-height:64rpx;color:#163a6b;white-space:nowrap;text-align:center}
.meta-tools{display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;justify-content:space-between;width:100%;margin:18rpx 0 0;padding:6rpx;gap:4rpx;box-sizing:border-box;background:rgba(255,255,255,0.88);border:1rpx solid rgba(22,58,107,0.08);border-radius:18rpx}
.more-drop voice-fab{height:64rpx;padding:0 22rpx;box-sizing:border-box;border-radius:999rpx;background:#f3f6fb;display:flex;align-items:center;justify-content:center}
.meta-shortcut{flex:1;min-width:0;height:72rpx;margin:0;padding:0 4rpx;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:6rpx;border-radius:14rpx;box-sizing:border-box}
.meta-shortcut-ico{width:30rpx;height:30rpx;flex-shrink:0}
.meta-shortcut-txt{font-size:24rpx;font-weight:600;line-height:1;color:#1e4d8c;white-space:nowrap}
.meta-shortcut-txt.more-dots{font-size:32rpx;letter-spacing:2rpx;line-height:1}
.meta-shortcut.on{background:#1e4d8c;padding:0 8rpx}
.meta-shortcut.on .meta-shortcut-ico{filter:brightness(0) invert(1)}
.meta-shortcut.on .meta-shortcut-txt{color:#fff}
.meta-line{flex:1;min-width:0;min-height:52rpx;margin-left:8rpx;padding:0 8rpx 6rpx;border-bottom:2rpx solid #163a6b;display:flex;align-items:flex-end;box-sizing:border-box}
.meta-v{max-width:100%;color:#1a2b3c;font-size:30rpx;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.return-banner{margin-top:8rpx;padding:12rpx 20rpx;background:rgba(255,243,224,0.95);border:1rpx solid rgba(230,81,0,0.28);border-radius:16rpx;display:flex;align-items:center}
.return-txt{flex:1;color:#bf360c;font-size:24rpx}
.return-exit{color:#e65100;font-size:24rpx;padding:4rpx 12rpx;font-weight:600}
.pending-banner{margin-top:16rpx;padding:12rpx 20rpx;background:rgba(15,118,110,0.12);border:1rpx solid rgba(15,118,110,0.28);border-radius:16rpx;display:flex;align-items:center}
.pending-txt{flex:1;color:#0f766e;font-size:24rpx;font-weight:600}
.pending-go{color:#0f766e;font-size:32rpx}
.more-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:1000;background:transparent}
.more-drop{position:fixed;z-index:1001;width:max-content;max-width:100%;overflow-x:hidden;overflow-y:auto;background:#fff;border:1rpx solid rgba(22,58,107,0.08);border-radius:20rpx;box-shadow:0 16rpx 40rpx rgba(22,58,107,0.16);padding:16rpx;box-sizing:border-box}
.more-drop .tools{margin:0;padding:0;background:transparent;border:none;box-shadow:none;display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;width:max-content;max-width:100%;gap:12rpx}
.more-drop .tool{flex:none;width:auto;min-width:0;height:64rpx;padding:0 22rpx;box-sizing:border-box;border-radius:999rpx;background:#f3f6fb;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:8rpx}
.more-drop .tool-ico{width:30rpx;height:30rpx;flex-shrink:0}
.more-drop .tool-lbl{margin-top:0;max-width:none;color:#1e4d8c;font-size:24rpx;font-weight:600;text-align:left;line-height:1;white-space:nowrap}
.more-drop .fulfill{margin-top:14rpx;padding:14rpx 0 0;background:transparent;border-radius:0;border-top:1rpx solid rgba(22,58,107,0.08);overflow:visible}
.more-drop .chip-row{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;width:max-content;max-width:100%;gap:12rpx}
.more-drop .chip{flex:none;width:auto;height:56rpx;padding:0 22rpx}
.tools{margin-top:20rpx;padding:16rpx 8rpx;background:rgba(255,255,255,0.82);border:1rpx solid rgba(22,58,107,0.08);border-radius:20rpx;box-shadow:0 4rpx 14rpx rgba(22,58,107,0.06);display:flex;flex-direction:row;align-items:center;flex-wrap:nowrap}
.tool{flex:1;min-width:0;padding:8rpx 0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.tool-ico{width:44rpx;height:44rpx}
.tool-lbl{margin-top:6rpx;color:#3d6aa0;font-size:22rpx;font-weight:500;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center}
.fulfill{margin-top:16rpx;background:#f5f7fa;border-radius:20rpx;padding:12rpx 16rpx 14rpx;overflow:hidden;display:flex;flex-direction:column;align-items:stretch}
.chip-row{display:flex;align-items:stretch;gap:12rpx}
.chip{flex:1;min-width:0;height:56rpx;padding:0 8rpx;border-radius:28rpx;background:#e8eaed;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.chip text{font-size:24rpx;color:#555;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip.on.paid{background:#c8e6c9}
.chip.on.picked{background:#bbdefb}
.chip.on.shipped{background:#ffe0b2}
.chip.ship{gap:4rpx}
.chip.ship .ship-ico{font-size:22rpx;line-height:1;flex-shrink:0}
.chip.on.shipped text{color:#e65100}
.chip.on.delivered{background:#b2dfdb}
.chip.deliv{gap:4rpx}
.chip.deliv .deliv-ico{font-size:22rpx;line-height:1;flex-shrink:0}
.chip.on.delivered text{color:#00695c}
.deliv-thumb{width:72rpx;height:72rpx;border-radius:8rpx;overflow:hidden;flex-shrink:0;border:1rpx solid #80cbc4}
.deliv-img{width:100%;height:100%}
.deliv-mask{position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,0.45);display:flex;align-items:flex-end;justify-content:center;box-sizing:border-box}
.reason-mask{position:fixed;inset:0;z-index:10010;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:48rpx}
.reason-dialog{width:100%;max-width:560rpx;background:#fff;border-radius:16rpx;padding:24rpx 0 12rpx;box-sizing:border-box;overflow:hidden}
.reason-title{display:block;padding:16rpx 40rpx 28rpx;font-size:34rpx;font-weight:600;color:#212121}
.reason-item{padding:28rpx 40rpx}
.reason-item-txt{font-size:30rpx;color:#212121}
.deliv-sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:12rpx 0 calc(16rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.deliv-item{display:flex;align-items:center;padding:28rpx 40rpx}
.deliv-item-ico{width:56rpx;height:56rpx;line-height:56rpx;text-align:center;font-size:36rpx;margin-right:28rpx;color:#1e4d8c}
.deliv-item-txt{font-size:32rpx;color:#212121}
.deliv-item-txt.danger,.deliv-item.danger .deliv-item-txt{color:#e53935}
.deliv-cancel{margin:8rpx 24rpx 0;height:88rpx;line-height:88rpx;text-align:center;font-size:32rpx;color:#616161;font-weight:600;border-top:1rpx solid #eee}
.trk-wrap{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx;max-height:240rpx;overflow-y:auto}
.trk-chip{display:flex;align-items:center;max-width:100%;padding:8rpx 8rpx 8rpx 16rpx;background:#fff3e0;border:1rpx solid #ffcc80;border-radius:999rpx;box-sizing:border-box}
.trk-txt{font-size:22rpx;color:#e65100;max-width:360rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.trk-x{margin-left:8rpx;width:40rpx;height:40rpx;line-height:40rpx;text-align:center;color:#e53935;font-size:24rpx}
.chip.on text{color:#333;font-weight:600}
.table-scroll-wrap{flex:1;height:0;position:relative;background:#fff;overflow:hidden;display:flex;flex-direction:column;width:100%;box-sizing:border-box}
.table-header,.row,.sku-sub{display:grid;grid-template-columns:64rpx minmax(0,4fr) minmax(0,2fr) minmax(0,2fr) minmax(0,2fr) minmax(0,3fr);align-items:stretch;width:100%;box-sizing:border-box}
.table-header.index-fold,.row.index-fold,.sku-sub.index-fold{grid-template-columns:0 minmax(0,4fr) minmax(0,2fr) minmax(0,2fr) minmax(0,2fr) minmax(0,3fr)}
.fold-no{width:44rpx;height:44rpx;border-radius:10rpx;background:#fff;border:1rpx solid rgba(22,58,107,0.18);display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.fold-no-on{background:#e8f1ff}
.fold-chev{width:12rpx;height:12rpx;border-left:4rpx solid #1e4d8c;border-bottom:4rpx solid #1e4d8c;transform:rotate(45deg);margin-left:4rpx;box-sizing:border-box}
.fold-chev.out{transform:rotate(-135deg);margin-left:0;margin-right:4rpx}
.table-header.index-fold .h-cell.no{overflow:visible;border-right:none;z-index:5}
.table-header.index-fold .fold-no{position:absolute;left:4rpx;top:50%;margin-top:-22rpx}
.table-header.index-fold .h-cell.name{padding-left:52rpx}
.row.index-fold .cell.no,.sku-sub.index-fold .cell.no{overflow:hidden;border-right-color:transparent;padding:0}
.table-header,.row{height:88rpx;flex-shrink:0}
.table-header{background:#e8eef4;border-bottom:1rpx solid #d0d7de}
.h-cell,.cell{box-sizing:border-box;min-width:0;width:auto;padding:0 8rpx;border-right:1rpx solid #d0d7de}
.h-cell{position:relative;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:700;color:#333;overflow:visible}
.h-cell text{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.col-grip{position:absolute;top:0;right:-18rpx;width:36rpx;height:100%;z-index:6}
.col-grip .col-line,.col-grip .col-arr{display:none;pointer-events:none}
.col-grip.on .col-line{display:block;position:absolute;left:50%;top:8rpx;bottom:8rpx;width:4rpx;margin-left:-2rpx;background:#1e4d8c;border-radius:2rpx}
.col-grip.on .col-arr{display:block;position:absolute;top:50%;width:0;height:0;margin-top:-9rpx;border-top:9rpx solid transparent;border-bottom:9rpx solid transparent}
.col-grip.on .col-arr.left{right:50%;margin-right:4rpx;border-right:12rpx solid #1e4d8c}
.col-grip.on .col-arr.right{left:50%;margin-left:4rpx;border-left:12rpx solid #1e4d8c}
.col-drag-mask{position:fixed;left:0;top:0;right:0;bottom:0;z-index:40}
.h-cell.no,.cell.no{padding:0}
.h-cell.total,.cell.total{border-right:none}
.table-x{flex:1;height:0;width:100%}
.table-x-inner{height:100%;min-width:100%;display:flex;flex-direction:column}
.table-body{flex:1;height:0;background:#fff;width:100%;box-sizing:border-box}
.sb-track{position:absolute;top:48px;bottom:4px;right:2px;width:8px;border-radius:8px;background:rgba(158,158,158,0.18);pointer-events:none;z-index:20}
.sb-thumb{width:8px;border-radius:8px;background:rgba(117,117,117,0.72);will-change:transform}
.row{box-sizing:content-box;border-bottom:1rpx solid #d0d7de}
.row-wrap:not(.has-sku) > .row{overflow:hidden}
.row.even{background:#e8eef4}
.row.selected{background:#e8f1ff}
.row-wrap{position:relative;width:100%;flex-shrink:0}
.sum-float{position:absolute;left:0;top:0;z-index:4;display:grid;grid-template-columns:64rpx minmax(0,4fr) minmax(0,2fr) minmax(0,2fr) minmax(0,2fr) minmax(0,3fr);align-items:center;width:100%;height:88rpx;background:transparent;pointer-events:none;box-sizing:border-box}
.sum-float.index-fold{grid-template-columns:0 minmax(0,4fr) minmax(0,2fr) minmax(0,2fr) minmax(0,2fr) minmax(0,3fr)}
.sum-qty,.sum-k,.sum-amt{display:flex;align-items:center;height:88rpx;min-width:0;box-sizing:border-box;font-weight:700;line-height:1}
.sum-qty{grid-column:2;justify-content:center;font-size:28rpx;color:#111}
.sum-k{grid-column:5;justify-content:flex-start;padding-left:4rpx;font-size:28rpx;color:#ff5252;white-space:nowrap}
.sum-amt{grid-column:6;justify-content:flex-start;padding-left:8rpx;font-size:34rpx;color:#ff5252}
.row-wrap.has-sku > .row{height:auto;min-height:88rpx}
.row-wrap.has-sku > .row > .cell{height:auto;min-height:88rpx}
.row-wrap.has-sku .cell.name{height:auto;min-height:88rpx;line-height:1.15}
.name-stack{display:flex;flex-direction:column;align-items:stretch;justify-content:center;padding-top:0;padding-bottom:0}
.name-input{width:100%;height:100%;min-height:0;margin:0;padding:0;box-sizing:border-box;line-height:88rpx;text-align:center;font-size:32rpx;color:#333;background:transparent}
.name-stack.has-sku .name-input{height:44rpx;line-height:44rpx}
.row-wrap:not(.has-sku) .name-input{height:88rpx;line-height:88rpx}
.sku-toggle{position:relative;z-index:3;display:flex;align-items:center;justify-content:center;gap:8rpx;width:100%;min-height:44rpx;padding:4rpx 0 6rpx}
.sku-toggle-on{opacity:0.65}
.sku-toggle-txt{font-size:20rpx;color:#5b7390;max-width:200rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sku-chevron{font-size:28rpx;line-height:1;color:#1e4d8c;font-weight:700;padding:0 6rpx}
.sku-subs{background:#f4f7fb;border-bottom:1rpx solid #d0d7de}
.sku-sub{min-height:64rpx}
.sku-sub + .sku-sub{border-top:1rpx solid #e6edf4}
.sku-sub .cell{height:64rpx;min-height:64rpx;line-height:64rpx;font-size:24rpx;border-right-color:#e6edf4;background:transparent}
.sku-sub-name{display:flex;align-items:center;justify-content:center;padding:0}
.sku-sub-spec{width:100%;text-align:center;font-size:24rpx;color:#3d5a80;line-height:1.2}
.sku-sub .cell.qty{display:flex;align-items:center;justify-content:center;padding:0}
.sku-sub-pad{color:transparent}
.cell.unit,.cell.price,.qty-box{position:relative;padding:0;display:flex;align-items:center;justify-content:center}
.qty-input,.unit-input,.price-input{width:100%;min-width:0;height:88rpx;min-height:0;margin:0;padding:0;box-sizing:border-box;line-height:88rpx;text-align:center;font-size:32rpx;color:#333;background:transparent}
.qty-sum{width:100%;text-align:center;font-size:32rpx;font-weight:700;color:#1e4d8c}
.qty-spin{width:100%;height:88rpx;display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;justify-content:center}
.qty-spin.mini{height:64rpx}
.qty-spin-btn{width:44rpx;flex-shrink:0;height:88rpx;line-height:88rpx;text-align:center;font-size:22rpx;font-weight:700;color:#1e4d8c;background:transparent}
.qty-spin-btn.plus,.qty-spin-btn.minus{color:#1e4d8c;background:transparent}
.qty-spin-btn-on{background:#e8eef8;color:#0d3a75}
.qty-spin.mini .qty-spin-btn{width:44rpx;height:64rpx;line-height:64rpx;font-size:20rpx}
.qty-spin-num{flex:1;min-width:0;height:88rpx;line-height:88rpx;text-align:center;font-size:28rpx;font-weight:600;color:#333;background:transparent}
.qty-spin.mini .qty-spin-num{height:64rpx;line-height:64rpx;font-size:26rpx;color:#1e4d8c}
.qty-cover{position:absolute;left:0;right:0;top:0;bottom:0}
.cell{height:88rpx;min-height:0;line-height:1.1;text-align:center;font-size:32rpx;color:#333;overflow:hidden}
.cell.no{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#333333;font-weight:600;line-height:1.1}
.row.selected .cell.no{color:#2e6bb5}
.no-num{font-size:32rpx;line-height:1.1}
.drag-ico{width:24rpx;height:24rpx;margin-top:2rpx;display:block;flex-shrink:0}
.cell.total.neg{color:#e65100}
.row-action{display:flex;align-items:center;height:88rpx;padding:0 20rpx;background:#e8f1ff;border-bottom:1rpx solid #d0d7de;box-sizing:border-box;flex-shrink:0}
.ra-check{width:36rpx;height:36rpx;border-radius:50%;background:#2e6bb5;margin-right:10rpx;flex-shrink:0;position:relative}
.ra-check-tick{position:absolute;left:11rpx;top:8rpx;width:12rpx;height:18rpx;border-right:4rpx solid #fff;border-bottom:4rpx solid #fff;transform:rotate(45deg);box-sizing:border-box}
.ra-tip{flex:1;min-width:0;font-size:28rpx;font-weight:600;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ra-btn{margin-left:12rpx;height:64rpx;padding:0 18rpx;border-radius:10rpx;color:#fff;font-size:26rpx;display:flex;align-items:center;gap:8rpx;flex-shrink:0}
.ra-ico-clear{width:28rpx;height:28rpx;position:relative;display:flex;align-items:center;justify-content:center}
.ra-clear-body{width:18rpx;height:16rpx;border:3rpx solid #fff;border-radius:2rpx 2rpx 4rpx 4rpx;box-sizing:border-box;margin-top:6rpx}
.ra-clear-bar{position:absolute;top:4rpx;left:0;width:28rpx;height:3rpx;background:#fff;border-radius:2rpx;transform:rotate(-28deg)}
.ra-ico-del{width:26rpx;height:28rpx;position:relative;display:flex;flex-direction:column;align-items:center}
.ra-del-lid{width:24rpx;height:4rpx;background:#fff;border-radius:2rpx;margin-bottom:2rpx}
.ra-del-body{width:18rpx;height:18rpx;border:3rpx solid #fff;border-top-width:0;border-radius:0 0 3rpx 3rpx;box-sizing:border-box}
.ra-btn.blue{background:#2e6bb5}
.ra-btn.red{background:#e53935}
.ra-cancel{margin-left:12rpx;height:64rpx;line-height:64rpx;padding:0 18rpx;font-size:26rpx;color:#2e6bb5;background:#fff;border:1rpx solid #c5cdd6;border-radius:10rpx;flex-shrink:0;box-sizing:border-box}
