<view class="page lock"><scroll-view class="scroller" scroll-y bindscrolltolower="onMore" lower-threshold="120"><view wx:if="{{loaded && !items.length}}" class="empty">还没有{{title}}</view><view class="card" wx:for="{{items}}" wx:key="id" bindtap="onOpen" data-id="{{item.id}}"><view class="row"><text class="title">{{item.name}}</text><text class="amt" wx:if="{{item.unpaidText}}">{{item.unpaidText}}</text><text class="fold" catchtap="onFold" data-id="{{item.id}}">{{item.folded ? '▼' : '▲'}}</text></view><text class="sub" wx:if="{{item.labelText || item.phone}}">{{item.labelText}}{{item.labelText && item.phone ? ' · ' + item.phone : item.phone}}</text><view class="recs" wx:if="{{!item.folded && role === 'factory'}}"><text class="sub empty-rec" wx:if="{{item.recordsReady && !item.groups.length}}">还没有记录</text><view class="cut-block" wx:for="{{item.groups}}" wx:for-item="group" wx:key="id"><text class="cut-done" wx:if="{{group.done}}">已完成</text><view class="cut-main" catchtap="onEditRecord" data-id="{{group.id}}" data-type="cut" data-party="{{item.id}}"><view class="row"><text class="rec-name">{{group.text}}</text><text class="sent">{{group.sentText}}</text><image class="rec-pen" src="/assets/icons/edit-outlined.svg" mode="aspectFit" /></view><text class="when" wx:if="{{group.timeText}}">{{group.timeText}}</text><text class="from-factory" wx:if="{{group.filledBy === 'factory'}}">厂里提供</text></view><view class="ship" wx:for="{{group.ships}}" wx:for-item="rec" wx:key="id" catchtap="onEditRecord" data-id="{{rec.id}}" data-type="{{rec.docType}}" data-party="{{item.id}}"><view class="row"><text class="rec-name">{{rec.text}}</text><text class="amt">{{rec.amount}}</text><text class="pay {{rec.accepted ? 'on' : ''}}" wx:if="{{rec.canToggleAccept}}" catchtap="onToggleAccept" data-id="{{rec.id}}" data-accepted="{{rec.accepted}}" data-bound="{{rec.boundCutId}}">{{rec.acceptText}}</text><text class="pay {{rec.paid ? 'on' : ''}}" wx:if="{{rec.canPay}}" catchtap="onTogglePaid" data-id="{{rec.id}}" data-paid="{{rec.paid}}">{{rec.paid ? '已付' : '未付'}}</text><image class="rec-pen" src="/assets/icons/edit-outlined.svg" mode="aspectFit" /></view><text class="when" wx:if="{{rec.timeText || rec.statusText}}">{{rec.timeText}}{{rec.timeText && rec.statusText ? ' · ' + rec.statusText : rec.statusText}}</text><view class="rec-end" wx:if="{{rec.canAccept}}"><text class="accept" catchtap="onAccept" data-id="{{rec.id}}" data-code="{{rec.productCode}}" data-qty="{{rec.qty}}">验收</text></view></view></view><view class="all" wx:if="{{item.groups.length}}" catchtap="onAll" data-id="{{item.id}}" data-name="{{item.name}}"><text>查看全部</text><image class="all-ico" src="/assets/icons/rp-more.svg" mode="aspectFit" /></view></view><view class="recs" wx:elif="{{!item.folded}}"><text class="sub empty-rec" wx:if="{{item.recordsReady && !item.records.length}}">还没有记录</text><view class="rec" wx:for="{{item.records}}" wx:for-item="rec" wx:key="id" catchtap="onEditRecord" data-id="{{rec.id}}" data-type="{{rec.docType}}" data-party="{{item.id}}"><view class="row"><text class="rec-name">{{rec.text}}</text><text class="amt" wx:if="{{rec.docType !== 'cut'}}">{{rec.amount}}</text><text class="pay {{rec.accepted ? 'on' : ''}}" wx:if="{{rec.canToggleAccept}}" catchtap="onToggleAccept" data-id="{{rec.id}}" data-accepted="{{rec.accepted}}" data-bound="{{rec.boundCutId}}">{{rec.acceptText}}</text><text class="pay {{rec.paid ? 'on' : ''}}" wx:if="{{rec.canPay}}" catchtap="onTogglePaid" data-id="{{rec.id}}" data-paid="{{rec.paid}}">{{rec.paid ? '已付' : '未付'}}</text><image class="rec-pen" src="/assets/icons/edit-outlined.svg" mode="aspectFit" /></view><text class="to-factory" wx:if="{{rec.factoryText}}">{{rec.factoryText}}</text><text class="when" wx:if="{{rec.timeText || rec.statusText}}">{{rec.timeText}}{{rec.timeText && rec.statusText ? ' · ' + rec.statusText : rec.statusText}}</text><view class="rec-end" wx:if="{{rec.canAccept}}"><text class="accept" catchtap="onAccept" data-id="{{rec.id}}" data-code="{{rec.productCode}}" data-qty="{{rec.qty}}">验收</text></view></view><view class="all" wx:if="{{item.records.length}}" catchtap="onAll" data-id="{{item.id}}" data-name="{{item.name}}"><text>查看全部</text><image class="all-ico" src="/assets/icons/rp-more.svg" mode="aspectFit" /></view></view></view><view class="more-tip" wx:if="{{more}}">上拉加载更多</view><text class="off-title" wx:if="{{disabledItems.length}}">已停用</text><view class="card off" wx:for="{{disabledItems}}" wx:key="id"><view class="row"><text class="title">{{item.name}}</text><text class="amt zero">{{item.unpaidText}}</text></view><text class="sub">已停用，不计入外面的欠款。启用后记录还在。</text><view class="off-acts"><text class="hint" catchtap="onEnable" data-id="{{item.id}}">启用</text><text class="photo-x" catchtap="onDeleteParty" data-id="{{item.id}}" data-name="{{item.name}}">删除</text></view></view><view class="scroller-pad"></view></scroll-view><view class="dock"><view class="dock-3" wx:if="{{role === 'factory'}}"><view class="btn line" data-type="cut" bindtap="onCreateTyped">裁剪</view><view class="btn line" data-type="delivery" bindtap="onCreateTyped">送货</view><view class="btn" bindtap="onCreate">新建加工厂</view></view><view class="dock-2" wx:elif="{{role === 'fabric' || role === 'trim'}}"><view class="btn line" data-type="{{role === 'fabric' ? 'fabric_in' : 'trim_in'}}" bindtap="onCreateTyped">发料</view><view class="btn" bindtap="onCreate">新建{{title}}</view></view><view class="dock-2" wx:else><view class="btn line" bindtap="onCreateRecord">创建记录</view><view class="btn" bindtap="onCreate">新建{{title}}</view></view></view></view><accept-sheet wx:if="{{acceptOn}}" doc-id="{{acceptId}}" code="{{acceptCode}}" qty="{{acceptQty}}" bind:done="onAcceptDone" bind:fail="onAcceptFail" bind:close="onAcceptClose" /><view class="pop-mask" wx:if="{{benchOn}}" catchtouchmove="noop" bindtap="onCloseBench"><view class="pop-sheet tall" catchtap="noop"><view class="pop-handle"></view><supply-bench class="pop-fill" party-id="{{benchId}}" role="{{role}}" edit-id="{{benchEditId}}" edit-type="{{benchEditType}}" bind:saved="onCloseBench" bind:createfactory="onJumpFactory" /></view></view><view class="pop-mask" wx:if="{{partyOn}}" catchtouchmove="noop" bindtap="onCloseParty"><view class="pop-sheet tall" catchtap="noop"><view class="pop-handle"></view><text class="pop-title">{{formId ? '修改' + title + '资料' : '新建' + title}}</text><scroll-view class="pop-body" scroll-y><party-form party-id="{{formId}}" role="{{role}}" bind:saved="onPartySaved" /><view class="pop-pad"></view></scroll-view></view></view>
