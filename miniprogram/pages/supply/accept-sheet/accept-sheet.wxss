.pop-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:200;background:rgba(0,0,0,0.45);display:flex;flex-direction:column;justify-content:flex-end}
.pop-sheet{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;max-height:88vh;display:flex;flex-direction:column;overflow:hidden}
.pop-handle{width:72rpx;height:8rpx;border-radius:8rpx;background:#d0d7de;margin:16rpx auto 8rpx}
.pop-title{display:block;padding:4rpx 28rpx 8rpx;font-size:32rpx;font-weight:600;color:#163a6b}
.pop-body{height:52vh;padding:0 28rpx;box-sizing:border-box}
.sub{display:block;margin:8rpx 0 20rpx;font-size:26rpx;color:#6b7c93}
.label{display:block;margin:8rpx 0 12rpx;font-size:28rpx;font-weight:600;color:#1a2b3c}
.input{height:72rpx;background:#fff;border:2rpx solid #dbe3ee;border-radius:16rpx;padding:0 20rpx;font-size:28rpx;box-sizing:border-box}
.ph{color:#94a3b8}
.pop-pad{height:28rpx}
.pop-dock{padding:12rpx 28rpx calc(16rpx + env(safe-area-inset-bottom))}
.btn{background:#1e4d8c;color:#fff;text-align:center;border-radius:20rpx;padding:22rpx 0;font-size:30rpx;font-weight:600}
.sku-line{display:flex;align-items:center;gap:16rpx;margin-bottom:16rpx}
.sku-size{width:120rpx;flex-shrink:0;font-size:28rpx;font-weight:600;color:#1a2b3c}
.sku-qty{flex:1}
