<view class="page {{rtl ? 'rtl' : ''}}"><view wx:if="{{loading}}" class="state">{{i18n.loading}}</view><view wx:elif="{{error && !customerName}}" class="state">{{error}}</view><view wx:else class="wrap"><view class="chain-badge {{signatureValid ? 'chain-ok' : ''}}" wx:if="{{publicChain || readonly}}"><text class="chain-badge-t">{{signatureValid ? i18n.statementChainOk : i18n.statementChainBadge}}</text><text class="chain-badge-d">{{chainHint || i18n.statementChainHint}}</text><text class="chain-meta" wx:if="{{chainIdShort}}">{{i18n.lookupChainId}} {{chainIdShort}}</text></view><text class="warn" wx:if="{{error}}">{{error}}</text><view class="card head-card"><text class="shop" user-select>{{shopName}}</text><view class="pill {{unpaidOnly ? 'danger' : ''}}"><text>{{unpaidOnly ? i18n.unpaidCustomerStatement : i18n.customerStatement}}</text></view><view class="divider"></view><view class="info-row"><text class="info-l">{{i18n.labelCustomer}}</text><text class="info-v" user-select>{{customerName}}</text></view><view class="info-row" wx:if="{{customerPhone}}"><text class="info-l">{{i18n.phoneLab}}</text><text class="info-v">{{customerPhone}}</text></view><view class="info-row"><text class="info-l">{{i18n.period}}</text><text class="info-v">{{rangeLabel}}</text></view><view class="info-row" wx:if="{{printTime}}"><text class="info-l">{{i18n.printTimeLab}}</text><text class="info-v">{{printTime}}</text></view></view><view class="card"><view class="sec-h"><text class="sec-t">{{i18n.orderLines}}（{{totals.orderCount || 0}} {{i18n.orderUnit}}）</text></view><view class="order-row" wx:for="{{orders}}" wx:key="orderNo"><view class="idx">{{index + 1}}</view><view class="order-mid"><text class="order-date">{{item.createdAt}}</text><text class="order-no" wx:if="{{item.orderNoLabel}}">{{item.orderNoLabel}}</text></view><view class="order-r"><text class="order-amt {{item.statusClass === 'unpaid' ? 'unpaid' : ''}}">¥{{item.amountLabel}}</text><view class="order-meta"><text class="order-qty">{{item.qtyLabel}}</text><text class="tag {{item.statusClass}}">{{item.statusLabel}}</text></view></view></view><view wx:if="{{!orders.length}}" class="empty">{{i18n.noOrdersPeriod}}</view></view><view class="card sum-card"><view class="sum-row"><text class="sum-l">{{i18n.total}}（{{totals.orderCount || 0}} {{i18n.orderUnit}} / {{totals.qty || 0}} {{i18n.unitPiece}}）</text><text class="sum-v">¥{{totals.totalLabel}}</text></view><view class="sum-row" wx:if="{{totals.paidCount > 0}}"><text class="sum-l">{{i18n.paidCount}}（{{totals.paidCount}} {{i18n.orderUnit}}）</text><text class="sum-v paid">¥{{totals.paidLabel}}</text></view><view class="sum-row" wx:if="{{totals.unpaidCount > 0}}"><text class="sum-l">{{i18n.unpaidCount}}（{{totals.unpaidCount}} {{i18n.orderUnit}}）</text><text class="sum-v unpaid">¥{{totals.unpaidLabel}}</text></view><view class="divider"></view><view class="recv-row"><text class="recv-l">{{i18n.receivable}}</text><text class="recv-v" user-select>¥{{totals.receivableLabel}}</text></view></view><view class="card pay-card" wx:if="{{showPayQr && (wechatQr || alipayQr)}}"><text class="pay-hint" wx:if="{{qrHint}}" user-select>{{qrHint}}</text><view class="pay-row"><view class="pay-col" wx:if="{{wechatQr}}"><qr-image class="pay-qr" src="{{wechatQr}}" kind="wechatPay" bind:scan="onScanPageQrs" /><text class="pay-lab">微信支付</text></view><view class="pay-col" wx:if="{{alipayQr}}"><qr-image class="pay-qr" src="{{alipayQr}}" kind="alipayPay" bind:scan="onScanPageQrs" /><text class="pay-lab">支付宝支付</text></view></view></view></view></view>
