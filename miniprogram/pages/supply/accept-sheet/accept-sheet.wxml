<view class="pop-mask front" wx:if="{{open}}" catchtouchmove="noop" bindtap="onClose"><view class="pop-sheet" catchtap="noop"><view class="pop-handle"></view><text class="pop-title">验收入库 {{code}}</text><scroll-view class="pop-body" scroll-y><text class="sub">送货 {{qty}} 件。已填 {{filled}} 件，按颜色尺码入库。</text><block wx:for="{{cells}}" wx:key="key"><text class="label" wx:if="{{item.showColor}}">{{item.color}}</text><view class="sku-line"><text class="sku-size">{{item.size}}</text><input class="input sku-qty" type="number" placeholder="件数" placeholder-class="ph" value="{{item.qty}}" data-key="{{item.key}}" bindinput="onQty" /></view></block><view class="pop-pad"></view></scroll-view><view class="pop-dock"><view class="btn" bindtap="onConfirm">{{busy ? '验收中' : '入库验收'}}</view></view></view></view>
