<view class="page">
  <view class="hint">
    只列出开给该客户、和商品库系统价不一样的价格。一样的不在这里显示。下次开单仍按上次成交价带出。
  </view>

  <view wx:if="{{loading}}" class="state">加载中</view>
  <view wx:elif="{{!rows.length}}" class="state">{{emptyText}}</view>
  <view wx:else class="list">
    <view class="card" wx:for="{{rows}}" wx:key="code">
      <view class="code">{{item.code}}</view>
      <view class="prices">
        <view class="col">
          <text class="label">系统价</text>
          <text class="shelf">{{item.listText}}</text>
        </view>
        <view class="col grow">
          <text class="label">给他的价格</text>
          <input
            class="price"
            type="digit"
            value="{{item.draft}}"
            data-code="{{item.code}}"
            disabled="{{!canManage}}"
            bindinput="onDraft"
          />
        </view>
      </view>
      <view class="acts" wx:if="{{canManage}}">
        <view class="btn" data-code="{{item.code}}" bindtap="onSave">保存</view>
        <view class="btn ghost" data-code="{{item.code}}" bindtap="onDelete">删除</view>
      </view>
    </view>
  </view>
</view>
