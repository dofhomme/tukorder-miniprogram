<wxs src="../../utils/media.wxs" module="media" /><view class="page {{rtl ? 'rtl' : ''}} {{agentMode ? 'agent-skin' : ''}}"><network-tip /><view class="header"><view class="status-spacer" style="height: {{statusBarHeight}}px;"></view><view
      class="nav-row"
      style="height: {{navBarHeight}}px; padding-right: {{capsuleSafeRight}}px;"
    ></view><view class="profile-row"><view class="avatar-wrap" bindtap="goShop" hover-stay-time="50" hover-start-time="0"><image
          wx:if="{{agentMode}}"
          class="avatar-img brand"
          src="{{media.url('imageok-logo-agent.png')}}"
          mode="aspectFit"
        /><image wx:elif="{{logoPath}}" class="avatar-img" src="{{logoPath}}" mode="aspectFill" /><view wx:else class="avatar">👤</view><view class="avatar-edit" wx:if="{{!agentMode}}"><image class="avatar-edit-img" src="/assets/icons/settings.svg" mode="aspectFit" /></view></view><view class="profile-info"><text class="shop-name">{{agentMode ? i18n.agentHello : shopName}}</text><text class="display-name" wx:if="{{guestMode}}">{{guestNick}}</text><text class="display-name" wx:elif="{{roleLabel}}">{{roleLabel}}</text><text class="phone" wx:if="{{phone}}">{{phone}}</text><text class="phone" wx:elif="{{guestMode && !agentMode}}">{{roleLabel}}</text></view><view class="role-chip {{agentMode ? 'role-chip-agent' : ''}}" wx:if="{{showRoleSwitch}}" bindtap="onSwitchWorkspace" hover-stay-time="50" hover-start-time="0"><text>{{agentMode ? i18n.switchToMerchant : i18n.switchToAgent}}</text></view><view class="team-btn" wx:if="{{showTeam}}" bindtap="goTeam" hover-stay-time="50" hover-start-time="0"><image class="team-ico" src="/assets/mine-icons/team-ico.svg" mode="aspectFit" /><text>{{i18n.mineTeam}}</text></view></view></view><view class="body-clip"><scroll-view scroll-y class="body"><view class="role-switch {{agentMode ? 'role-switch-agent' : ''}}" wx:if="{{showRoleSwitch}}" bindtap="onSwitchWorkspace" hover-stay-time="50"><text class="role-switch-t">{{agentMode ? i18n.currentRoleAgent : i18n.currentRoleMerchant}}</text><text class="role-switch-d">{{i18n.dualRoleHint}}</text><text class="role-switch-act">{{agentMode ? i18n.switchToMerchant : i18n.switchToAgent}}</text></view><view class="menu-card" wx:if="{{agentMode}}"><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onPickLanguage" hover-start-time="0"><view class="ico i-lang"><image class="ico-img" src="/assets/mine-icons/i-lang.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.language}}</text><text class="menu-sub">{{locale === 'ug' ? i18n.langUg : i18n.langZh}}</text></view><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/agent-bills/agent-bills" hover-start-time="0"><view class="ico i-bills"><image class="ico-img" src="/assets/mine-icons/i-bills.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.myBills}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/agent-profile/agent-profile" hover-start-time="0"><view class="ico i-profile"><image class="ico-img" src="/assets/mine-icons/i-update.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.agentEditProfile}}</text><text class="menu-sub">{{i18n.agentEditPhone}}</text></view><text class="chev">›</text></view><button
        wx:if="{{agentIsAdmin && staffInviteToken}}"
        class="menu-item menu-share"
        hover-class="menu-item-hover"
        open-type="share"
        data-kind="staff"
      ><view class="ico i-share-staff"><image class="ico-img" src="/assets/mine-icons/i-share-staff.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.shareToStaff}}</text><text class="menu-sub">{{i18n.shareToStaffHint}}</text></view><text class="chev">›</text></button><view class="menu-item" wx:if="{{agentCanManageShops}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/agent-shops/agent-shops" hover-start-time="0"><view class="ico i-shops"><image class="ico-img" src="/assets/mine-icons/i-shops.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.agentShops}}</text><text class="menu-sub">{{i18n.agentUnbindShop}}</text></view><text class="chev">›</text></view><view class="menu-item" wx:if="{{agentCanSwitch}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onAgentSwitchShop" hover-start-time="0"><view class="ico i-switch-shop"><image class="ico-img" src="/assets/mine-icons/i-switch-shop.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.switchShop}}</text><text class="menu-sub">{{shopName}}</text></view><text class="chev">›</text></view><view class="menu-item {{tutorialsOn ? '' : 'off'}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onTutorials" hover-start-time="0"><view class="ico i-rules"><image class="ico-img" src="/assets/mine-icons/i-rules.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.tutorials}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onSupport" hover-start-time="0"><view class="ico i-support"><image class="ico-img" src="/assets/mine-icons/i-support.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.support}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onInviteHub" hover-start-time="0"><view class="ico i-invite"><image class="ico-img" src="/assets/mine-icons/i-invite.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.inviteHub}}</text><text class="chev">›</text></view></view><view class="guest-banner" wx:if="{{guestMode && !agentMode && !showAgentBills}}" bindtap="onGuestBind" hover-stay-time="50"><text class="guest-banner-t">{{i18n.bindFree}}</text><text class="guest-banner-d">{{i18n.bindHint}}</text></view><view
