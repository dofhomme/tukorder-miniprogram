.mp-update{position:fixed;left:24rpx;right:24rpx;bottom:calc(124rpx + env(safe-area-inset-bottom));z-index:100001;height:72rpx;display:flex;align-items:center;justify-content:space-between;padding:0 16rpx 0 28rpx;background:#2e6bb5;border-radius:16rpx;box-shadow:0 8rpx 24rpx rgba(46,107,181,0.28);box-sizing:border-box}
.mp-update.is-hidden{display:none}
.mp-update-txt{color:#ffffff;font-size:26rpx;font-weight:600}
.mp-update-btn{color:#2e6bb5;background:#ffffff;font-size:24rpx;font-weight:700;line-height:1;padding:12rpx 22rpx;border-radius:999rpx}
.tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:100000;display:flex;align-items:flex-start;justify-content:space-around;padding-top:14rpx;padding-bottom:calc(10rpx + env(safe-area-inset-bottom));min-height:calc(112rpx + env(safe-area-inset-bottom));background:#ffffff;border-top:1rpx solid rgba(22,58,107,0.08);box-sizing:border-box;pointer-events:auto}
.tab-bar.is-hidden{transform:translateY(120%);pointer-events:none;visibility:hidden}
.tab-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;min-width:0;min-height:96rpx;padding:0 8rpx;box-sizing:border-box}
.tab-item.is-center{justify-content:flex-start}
.tab-item.is-center .ico{width:52rpx;height:52rpx}
.ico-wrap{width:128rpx;height:64rpx;border-radius:32rpx;display:flex;align-items:center;justify-content:center;background:transparent}
.tab-item.is-hover .ico-wrap{background:rgba(46,107,181,0.08)}
.ico-wrap.active,.tab-item.on .ico-wrap{background:rgba(46,107,181,0.12)}
.tab-item.on.is-hover .ico-wrap,.tab-item.is-hover .ico-wrap.active{background:rgba(46,107,181,0.16)}
.ico{width:48rpx;height:48rpx;background:transparent;pointer-events:none}
.ico-supply{width:60rpx;height:60rpx}
.lbl{margin-top:6rpx;font-size:22rpx;line-height:1.15;color:#757575;font-weight:400;pointer-events:none}
.tab-item.on .lbl{color:#2e6bb5;font-weight:600}
.tab-item.is-hover .lbl{color:#2e6bb5}
.tab-bar.theme-agent .tab-item.is-hover .ico-wrap{background:rgba(15,118,110,0.08)}
.tab-bar.theme-agent .ico-wrap.active,.tab-bar.theme-agent .tab-item.on .ico-wrap{background:rgba(15,118,110,0.12)}
.tab-bar.theme-agent .tab-item.on.is-hover .ico-wrap,.tab-bar.theme-agent .tab-item.is-hover .ico-wrap.active{background:rgba(15,118,110,0.16)}
.tab-bar.theme-agent .tab-item.on .lbl,.tab-bar.theme-agent .tab-item.is-hover .lbl{color:#0f766e}
