<view class="page {{rtl ? 'rtl' : ''}}"><scroll-view scroll-y class="body" enhanced show-scrollbar="{{false}}"><text class="title">{{title}}</text><text class="updated">{{i18n.updatedOn}}：{{updated}}</text><text class="lead">{{lead}}</text><view class="sec" wx:for="{{sections}}" wx:key="h"><text class="h">{{item.h}}</text><text class="p" wx:for="{{item.ps}}" wx:for-item="para" wx:key="*this">{{para}}</text></view><view class="contact"><text class="h">{{i18n.contactUs}}</text><text class="p">{{i18n.operatorLine}}</text><text class="p">{{i18n.officialSiteLine}}</text><text class="p">{{i18n.icpLine}}</text><text class="p">{{i18n.legalContactHint}}</text></view><view class="safe"></view></scroll-view></view>
