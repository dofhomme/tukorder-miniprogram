<wxs src="../../utils/media.wxs" module="media" /><view class="page {{rtl ? 'rtl' : ''}} {{agentMode ? 'agent-skin' : ''}}"><network-tip /><view class="page-head {{agentMode ? 'with-brand' : ''}}"><view class="status-spacer" style="height: {{statusBarHeight}}px;"></view><view class="capsule-gap" style="height: {{navBarHeight}}px;"></view><view class="agent-brand-row" wx:if="{{agentMode}}"><image class="agent-brand-logo" src="{{media.url('imageok-logo-agent.png')}}" mode="aspectFit" /><view class="agent-brand-info"><text class="agent-brand-title">{{i18n.agentHello}}</text><text class="agent-brand-sub" wx:if="{{agentShopName}}">{{agentShopName}}{{agentCustomerName ? ' · ' + agentCustomerName : ''}}</text></view></view></view><block wx:if="{{agentMode}}"><view class="agent-cat {{agentMerchantExpired ? 'is-expired' : ''}}"><view class="agent-plaza-entry" bindtap="onOpenPlaza" hover-class="agent-plaza-entry-hover"><text class="agent-plaza-entry-t">{{i18n.plazaTitle}}</text><text class="agent-plaza-entry-s">{{i18n.plazaEntry}}</text><text class="agent-plaza-entry-a">›</text></view><view class="agent-expire" wx:if="{{agentMerchantExpired}}"><text class="agent-expire-t">{{i18n.merchantExpiredTitle}}</text><text class="agent-expire-s">{{i18n.merchantExpiredHint}}</text><button class="agent-expire-btn" open-type="share">{{i18n.merchantRenewForward}}</button></view><text class="agent-closed" wx:if="{{agentClosed && !agentMerchantExpired}}">{{i18n.ordersClosedLook}}</text><view class="agent-tabs"><view class="agent-tab {{agentTab === 'all' ? 'on' : ''}}" data-tab="all" bindtap="onAgentTab">{{i18n.catalogAll}}</view><view class="agent-tab {{agentTab === 'new' ? 'on' : ''}}" data-tab="new" bindtap="onAgentTab">{{i18n.catalogNew}}</view><view class="agent-tab link" bindtap="onOpenFolders">{{i18n.lookFolder}}</view></view><view class="agent-search"><input placeholder="{{i18n.searchGoods}}" value="{{keyword}}" bindinput="onAgentKeyword" /><text class="agent-who-link" bindtap="onSearchByImage">{{searchingImage ? i18n.searchingImage : i18n.searchByImage}}</text><text class="agent-who-link" bindtap="onWhoHas">{{i18n.whoHas}}</text></view><scroll-view
        scroll-y
        class="agent-list-scroll"
        enhanced
        show-scrollbar="{{false}}"
        lower-threshold="80"
        bindscrolltolower="onAgentReachBottom"
      ><view class="agent-empty" wx:if="{{loading}}">{{i18n.loadingCatalog}}</view><view class="agent-empty" wx:elif="{{!agentShown.length}}">{{imageSearchOn ? i18n.searchByImageEmpty : i18n.noMatchGoods}}</view><view class="agent-grid" wx:else><view class="agent-card" wx:for="{{agentShown}}" wx:key="rowKey"><text class="agent-shop-tag" wx:if="{{agentAllShops && item.shopName}}">{{item.shopName}}</text><view
              class="agent-cover-wrap"
              data-code="{{item.code}}"
              catchtap="onAgentPreviewImage"
              catchlongpress="onAgentRestock"
            ><image
