.page{background:#fff;height:100vh;display:flex;flex-direction:column;box-sizing:border-box;padding-bottom:calc(148rpx + env(safe-area-inset-bottom));overflow:hidden;position:relative}
.page-head{flex-shrink:0;background:linear-gradient(180deg,#dbe7f5 0%,#eef3f9 52%,#f3f6fb 100%);box-shadow:0 1rpx 0 rgba(22,58,107,0.08);border-bottom:1rpx solid rgba(22,58,107,0.06)}
.status-spacer,.capsule-gap{width:100%}
.merchant-body{flex:1;height:0;min-height:0;display:flex;flex-direction:column}
.tool-row{display:flex;align-items:center;gap:8rpx;padding:16rpx 20rpx 10rpx;flex-shrink:0}
.tool-link{display:flex;align-items:center;gap:6rpx;padding:10rpx 8rpx;color:#212121;font-size:30rpx;font-weight:500;flex-shrink:0}
.tool-ico{color:#1e4d8c;font-size:34rpx;font-weight:600;line-height:1}
.tool-ico-img{width:36rpx;height:36rpx;flex-shrink:0}
.search-box{flex:1;min-width:0;height:72rpx;padding:0 14rpx 0 18rpx;background:#fff;border:2rpx solid #cfd8dc;border-radius:10rpx;display:flex;align-items:center;box-sizing:border-box}
.search-ico{font-size:28rpx;opacity:0.45;margin-right:10rpx}
.search{flex:1;height:72rpx;font-size:30rpx;color:#212121;min-width:0}
.search-ph{color:#9e9e9e;font-size:28rpx}
.search-clear{padding:8rpx;color:#9e9e9e;font-size:28rpx}
.filter-row{display:flex;align-items:center;gap:16rpx;padding:8rpx 20rpx 14rpx;flex-shrink:0}
.outline-btn{display:flex;align-items:center;gap:8rpx;padding:14rpx 20rpx;border:2rpx solid #c5cdd6;border-radius:10rpx;font-size:28rpx;color:#212121;flex-shrink:0;background:#fff}
.ob-ico{color:#555;font-size:28rpx}
.ob-ico-img{width:28rpx;height:28rpx;flex-shrink:0;margin-right:4rpx}
.view-switch{display:flex;flex-shrink:0;border:2rpx solid #c5cdd6;border-radius:10rpx;overflow:hidden;background:#fff}
.vs{width:64rpx;height:56rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.vs-ico{width:36rpx;height:36rpx}
.vs.on{background:#1e4d8c}
.thumb-grid{display:flex;flex-wrap:wrap;justify-content:space-between;width:100%;padding:8rpx 20rpx 4rpx;box-sizing:border-box}
.thumb-card{width:48%;flex:0 0 48%;max-width:48%;margin-bottom:16rpx;background:#fff;border:2rpx solid #e6ebf0;border-radius:12rpx;overflow:hidden;box-sizing:border-box}
.thumb-cover{height:280rpx;background:#eef2f6}
.thumb-img{width:100%;height:100%}
.thumb-ph{height:100%;display:flex;align-items:center;justify-content:center;color:#90a4ae;font-size:34rpx;font-weight:700;letter-spacing:1rpx}
.thumb-code-row{display:flex;align-items:center;gap:6rpx;padding:12rpx 14rpx 0;min-width:0}
.thumb-code{display:block;flex:1;min-width:0;font-size:28rpx;font-weight:600;color:#212121;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.link-mark{width:22rpx;height:22rpx;flex-shrink:0}
.thumb-meta{display:block;padding:4rpx 14rpx 14rpx;font-size:24rpx;color:#607d8b}
.cat-select{flex:1;min-width:0;height:72rpx;padding:0 18rpx;border:2rpx solid #c5cdd6;border-radius:10rpx;display:flex;align-items:center;background:#fff;box-sizing:border-box}
.cat-txt{flex:1;min-width:0;font-size:28rpx;color:#212121;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cat-arrow{margin-left:8rpx;font-size:20rpx;color:#757575}
.summary{margin:0 20rpx;padding:12rpx 20rpx;background:#f7f8fa;border:1rpx solid #d0d7de;display:flex;align-items:center;font-size:28rpx;font-weight:600;color:#333;flex-shrink:0;box-sizing:border-box}
.sum-styles{margin-right:48rpx}
.sum-amt{margin-left:48rpx}
.list-scroll{flex:1;height:0;margin-top:12rpx;width:100%;box-sizing:border-box}
.table-h-scroll{width:100%;white-space:nowrap}
.table{display:inline-block;min-width:900rpx;width:900rpx;border-left:1rpx solid #d0d7de;border-right:1rpx solid #d0d7de;vertical-align:top}
.table.index-fold{min-width:836rpx;width:836rpx}
.thead,.trow{display:flex;align-items:stretch;border-bottom:1rpx solid #d0d7de;box-sizing:border-box}
.thead{background:#e8eef4;height:88rpx;border-top:1rpx solid #d0d7de;position:relative;z-index:1}
.trow{height:88rpx;min-height:88rpx;background:#fff}
.trow.alt{background:#fafbfc}
.c{display:flex;align-items:center;justify-content:center;padding:0 8rpx;font-size:32rpx;color:#333;border-right:1rpx solid #d0d7de;box-sizing:border-box;min-width:0;line-height:1.1}
.thead .c{font-weight:700;font-size:32rpx;color:#333}
.c.idx{width:64rpx;flex-shrink:0;padding:0;position:relative;overflow:visible}
.fold-no{width:44rpx;height:44rpx;border-radius:10rpx;background:#fff;border:1rpx solid rgba(22,58,107,0.18);display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.fold-no-on{background:#e8f1ff}
.fold-chev{width:12rpx;height:12rpx;border-left:4rpx solid #1e4d8c;border-bottom:4rpx solid #1e4d8c;transform:rotate(45deg);margin-left:4rpx;box-sizing:border-box}
.fold-chev.out{transform:rotate(-135deg);margin-left:0;margin-right:4rpx}
.table.index-fold .c.idx{width:0;overflow:hidden;border-right-color:transparent;padding:0}
.table.index-fold .thead .c.idx{overflow:visible;border-right:none;z-index:5}
.table.index-fold .thead .fold-no{position:absolute;left:4rpx;top:50%;margin-top:-22rpx}
.table.index-fold .thead .c.code{padding-left:52rpx}
.idx-num{font-size:32rpx;font-weight:600;color:#333}
.edit-ico{width:36rpx;height:36rpx;padding:8rpx;flex-shrink:0;box-sizing:content-box}
.c.stock{border-right:none}
.thumb-foot{display:flex;align-items:center;gap:8rpx;padding-right:8rpx}
.thumb-foot .thumb-meta{flex:1;min-width:0}
.thumb-foot .edit-ico{padding:8rpx 4rpx 12rpx}
.c.code{width:280rpx;flex-shrink:0;flex-wrap:nowrap;gap:8rpx;padding:0 8rpx}
.code-t{flex:1;min-width:0;text-align:center;font-size:32rpx;font-weight:400;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sku-tag{flex-shrink:0;padding:2rpx 10rpx;border-radius:8rpx;background:#e8eef8;color:#1e4d8c;font-size:20rpx;line-height:1.35;font-weight:600}
.stk-btn{width:36rpx;height:36rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:26rpx;font-weight:600;line-height:1;flex-shrink:0}
.stk-btn.minus{background:#bdbdbd}
.stk-btn.minus.disabled{opacity:0.35}
.stk-btn.plus{background:#43a047}
.c.unit,.c.price,.c.stock{width:132rpx;flex-shrink:0}
.c.sales{width:160rpx;flex-shrink:0;gap:8rpx;flex-wrap:nowrap}
.sales-head-on{background:#d6e6ff}
.sales-sort{width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sales-tri{width:0;height:0;border-left:13rpx solid transparent;border-right:13rpx solid transparent;border-top:16rpx solid #1e4d8c}
.sales-sort.up .sales-tri{border-top:none;border-bottom:16rpx solid #1e4d8c}
.price-t{color:#e53935;font-weight:400;font-size:32rpx}
.stock-t{font-size:32rpx;font-weight:400}
.stock-t.link{color:#1e4d8c;text-decoration:underline}
.empty{padding:80rpx 40rpx;text-align:center;color:#9e9e9e;font-size:30rpx;line-height:1.5;white-space:pre-wrap}
.empty-btn{margin-top:32rpx;display:inline-block;padding:18rpx 40rpx;background:#1e4d8c;color:#fff;border-radius:12rpx;font-size:30rpx}
.load-more{padding:28rpx 0 48rpx;text-align:center;font-size:28rpx;color:#757575}
.guest-empty{padding:120rpx 48rpx 80rpx;display:flex;flex-direction:column;align-items:center}
.guest-empty-t{font-size:34rpx;font-weight:600;color:#163a6b}
.guest-empty-d{margin-top:16rpx;text-align:center;font-size:26rpx;line-height:1.6;color:#6b7c93}
.guest-empty-btn{margin-top:40rpx;background:#2e6bb5 !important;color:#fff !important;border-radius:48rpx;font-size:30rpx}
.page.agent-skin{background:#eef6f4;padding-bottom:calc(220rpx + env(safe-area-inset-bottom))}
.page.agent-skin .page-head{background:linear-gradient(180deg,#d7efe9 0%,#eef6f4 48%,#f3f7f6 100%);box-shadow:none;border-bottom-color:rgba(15,118,110,0.08)}
.page-head.with-brand{padding-bottom:16rpx}
.agent-brand-row{display:flex;align-items:center;gap:20rpx;padding:8rpx 28rpx 4rpx;max-width:calc(100% - 200rpx);box-sizing:border-box}
.agent-brand-logo{width:72rpx;height:72rpx;border-radius:0;flex-shrink:0;background:transparent}
.agent-brand-info{flex:1;min-width:0}
.agent-brand-title{display:block;font-size:34rpx;font-weight:700;color:#134e4a;line-height:1.2}
.agent-brand-sub{display:block;margin-top:4rpx;font-size:22rpx;color:#3d5c58;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.agent-cat{flex:1;height:0;min-height:0;display:flex;flex-direction:column;padding:12rpx 28rpx 0;box-sizing:border-box}
.agent-plaza-entry{flex-shrink:0;display:flex;align-items:center;gap:12rpx;margin-bottom:12rpx;padding:18rpx 22rpx;border-radius:16rpx;background:#0f766e;color:#fff}
.agent-plaza-entry-hover{opacity:0.9}
.agent-plaza-entry-t{font-size:28rpx;font-weight:700}
.agent-plaza-entry-s{flex:1;min-width:0;font-size:22rpx;opacity:0.82;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.agent-plaza-entry-a{font-size:32rpx;opacity:0.85}
.agent-shop-tag{position:absolute;left:8rpx;top:8rpx;z-index:2;max-width:70%;padding:4rpx 10rpx;border-radius:8rpx;background:rgba(19,78,74,0.72);color:#fff;font-size:18rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.agent-list-scroll{flex:1;height:0;min-height:0}
.agent-cat .load-more{padding:24rpx 0 40rpx}
.agent-shop{display:block;flex-shrink:0;color:#3d5c58;font-size:24rpx;margin-bottom:8rpx}
.agent-closed{display:block;color:#0f766e;font-size:24rpx;margin-bottom:12rpx}
.agent-search{flex-shrink:0;background:#fff;border-radius:12rpx;padding:0 20rpx;margin-bottom:16rpx;display:flex;align-items:center;gap:12rpx}
.agent-search input{flex:1}
.agent-who-link{flex-shrink:0;font-size:24rpx;color:#0f766e;font-weight:600;padding:16rpx 0}
.agent-tabs{display:flex;gap:16rpx;padding:0 20rpx 12rpx}
.agent-tab{padding:8rpx 28rpx;border-radius:999rpx;font-size:26rpx;color:#5f7a74;background:rgba(255,255,255,0.7)}
.agent-tab.on{color:#fff;background:#0f766e;font-weight:700}
.agent-tab.link{margin-left:auto;background:transparent;color:#0f766e;padding-right:0}
.agent-watch{position:absolute;left:8rpx;bottom:8rpx;font-size:18rpx;padding:2rpx 8rpx;border-radius:6rpx;background:rgba(15,118,110,0.88);color:#fff}
.agent-thumb{width:168rpx;height:168rpx;border-radius:12rpx;display:block;background:#eef3f1}
.agent-thumb-n{position:absolute;right:6rpx;bottom:6rpx;min-width:28rpx;padding:0 8rpx;height:28rpx;line-height:28rpx;text-align:center;font-size:18rpx;color:#fff;background:rgba(0,0,0,0.45);border-radius:8rpx}
.pick-imgs{white-space:nowrap;margin:12rpx 0 4rpx;height:160rpx}
.pick-img{width:160rpx;height:160rpx;border-radius:12rpx;margin-right:12rpx;background:#eef3f1;display:inline-block;vertical-align:top}
.agent-new{font-size:18rpx;color:#fff;background:#dc2626;border-radius:8rpx;padding:2rpx 8rpx;line-height:1.4}
.prod-thumb{width:48rpx;height:48rpx;border-radius:8rpx;margin-right:8rpx;flex-shrink:0;background:#eef1f4}
.agent-grid{display:flex;flex-wrap:wrap;justify-content:space-between;width:100%;padding-bottom:0}
.agent-card{position:relative;width:48%;flex:0 0 48%;max-width:48%;margin-bottom:16rpx;background:#fff;border-radius:16rpx;overflow:hidden;box-sizing:border-box}
.agent-cover-wrap{position:relative;height:320rpx;background:#d7efe9}
.agent-cover{width:100%;height:100%}
.agent-cover-ph{height:100%;display:flex;align-items:center;justify-content:center;color:#3d5c58;font-size:28rpx}
.agent-cover-wrap .agent-new{position:absolute;left:12rpx;top:12rpx;background:#0f766e;color:#fff;font-size:20rpx;padding:4rpx 12rpx;border-radius:8rpx}
.agent-cover-wrap .agent-thumb-n{position:absolute;right:12rpx;top:12rpx;background:rgba(0,0,0,0.45);color:#fff;font-size:20rpx;padding:4rpx 10rpx;border-radius:8rpx}
.agent-play{position:absolute;left:50%;top:50%;width:72rpx;height:72rpx;margin:-36rpx 0 0 -36rpx;border-radius:50%;background:rgba(0,0,0,0.5);color:#fff;font-size:28rpx;display:flex;align-items:center;justify-content:center}
.agent-stock{position:absolute;right:12rpx;bottom:12rpx;font-size:20rpx;color:#fff;background:rgba(15,118,110,0.85);padding:4rpx 10rpx;border-radius:8rpx}
.agent-stock.low{background:rgba(180,83,9,0.9)}
.agent-stock.out{background:rgba(127,29,29,0.9)}
.agent-card-main{padding:12rpx 16rpx 4rpx}
.agent-card-main .agent-code{display:block;font-size:28rpx;font-weight:700;color:#134e4a}
.agent-card-main .agent-price{display:block;margin-top:4rpx;font-size:22rpx;color:#0f766e}
.agent-card-acts{display:flex;flex-wrap:wrap;gap:8rpx;padding:8rpx 12rpx 16rpx}
.agent-act{flex:1 1 42%;text-align:center;font-size:22rpx;color:#3d5c58;background:#eef6f4;border-radius:10rpx;padding:10rpx 0}
.agent-act.primary{background:#0f766e;color:#fff}
.folder-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 8rpx;font-size:28rpx;color:#134e4a;border-bottom:1rpx solid #eef3f1}
.folder-n{color:#5f7a74;font-size:24rpx}
.agent-btn.ghost{background:#fff;color:#0f766e;border:2rpx solid #0f766e;margin-top:16rpx}
.ship-ipt{width:100%;box-sizing:border-box;background:#f3f7f6;border-radius:12rpx;padding:20rpx 24rpx;margin-top:20rpx;font-size:30rpx;color:#134e4a;line-height:1.5}
.ship-one{min-height:200rpx;height:200rpx}
.ship-ph{color:#8a9a96;font-size:28rpx}
.ship-urg{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;font-size:28rpx;color:#134e4a}
.agent-code{display:block;font-weight:700;color:#134e4a}
.agent-name,.agent-meta,.agent-muted{display:block;color:#8a98ab;font-size:22rpx}
.agent-price{font-weight:700;color:#0f766e;font-size:26rpx}
.agent-cart{flex-shrink:0;margin-top:12rpx;margin-bottom:12rpx;max-height:240rpx;overflow-y:auto;background:#fff;border-radius:14rpx;padding:8rpx 20rpx}
.agent-cline{display:flex;align-items:center;justify-content:space-between;padding:16rpx 0}
.agent-spin,.agent-spin.big{display:flex;align-items:center;gap:16rpx}
.agent-spin.big{justify-content:center;margin:20rpx 0}
.agent-spin-btn{width:48rpx;height:48rpx;line-height:48rpx;text-align:center;border-radius:8rpx;background:#e8f4f1;color:#0f766e;font-size:32rpx}
.agent-bar{position:fixed;left:0;right:0;bottom:calc(112rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx;background:#fff;z-index:20}
.agent-btn{padding:0 28rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:12rpx;background:#0f766e;color:#fff;font-weight:600}
.agent-btn.off{opacity:0.45;pointer-events:none}
.agent-btn.sheet-btn{margin-top:12rpx}
.agent-empty{padding:40rpx 0;text-align:center;color:#8a98ab}
.mask{position:fixed;inset:0;background:rgba(16,32,54,0.45);display:flex;align-items:flex-end;z-index:40}
.sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.sheet .title{display:block;font-size:36rpx;font-weight:700;color:#134e4a}
.sheet .hint{display:block;margin-top:16rpx;color:#6b7c93;font-size:24rpx;white-space:pre-wrap}
.import-mask{align-items:flex-end;padding-bottom:calc(112rpx + env(safe-area-inset-bottom))}
.import-sheet{max-height:calc(100vh - 160rpx - env(safe-area-inset-bottom));display:flex;flex-direction:column;padding-bottom:24rpx}
.import-sheet .title{color:#163a6b}
.import-sheet .hint{color:#5b7390}
.import-body{width:100%;max-height:46vh;min-height:0}
.export-preview{width:100%;height:50vh;margin-top:12rpx}
.export-x{width:100%}
.export-table{display:inline-flex;flex-direction:column;flex-shrink:0;min-width:100%;border:1rpx solid rgba(30,77,140,0.16);border-radius:12rpx;overflow:hidden}
.export-row{display:flex;flex-direction:row}
.export-row.head{background:#e7f0fa}
.export-row.alt{background:#f4f8fc}
.export-cell{width:148rpx;flex:none;padding:12rpx 8rpx;font-size:22rpx;line-height:1.3;color:#1a2b3c;border-right:1rpx solid #e6eef6;border-bottom:1rpx solid #e6eef6;box-sizing:border-box;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.export-row.head .export-cell{color:#163a6b;font-weight:600}
.import-actions{flex-shrink:0;padding-top:8rpx}
.import-btn{margin-top:16rpx;height:80rpx;line-height:80rpx;text-align:center;border-radius:12rpx;background:#1e4d8c;color:#fff;font-size:30rpx;font-weight:600}
.import-btn.ghost{background:#fff;color:#1e4d8c;border:2rpx solid #1e4d8c;box-sizing:border-box;line-height:76rpx}
.import-line{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid rgba(22,58,107,0.08)}
.import-meta{display:flex;flex-direction:column;min-width:0;flex:1}
.import-sample{color:#5b7390;font-size:22rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.import-pick{min-width:160rpx;padding:8rpx 16rpx;border-radius:12rpx;background:#e8f1ff;color:#1e4d8c;text-align:center;font-size:26rpx;font-weight:600}
.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin:8rpx 0 16rpx}
.chip{padding:8rpx 20rpx;border-radius:999rpx;background:#e8f4f1;color:#134e4a;font-size:26rpx}
.chip.on{background:#0f766e;color:#fff}
.agent-expire{margin:16rpx 0;padding:24rpx;background:#f4f7fb;border:1rpx solid rgba(22,58,107,.12);border-radius:16rpx}
.agent-expire-t{display:block;font-size:30rpx;font-weight:700;color:#163A6B}
.agent-expire-s{display:block;margin-top:8rpx;font-size:24rpx;line-height:1.45;color:#5B7390}
.agent-expire-btn{margin:16rpx 0 0;padding:0 28rpx;height:64rpx;line-height:64rpx;font-size:26rpx;font-weight:700;color:#fff;background:#1E4D8C;border-radius:12rpx}
.agent-expire-btn::after{border:none}
.agent-cat.is-expired .agent-tabs,
.agent-cat.is-expired .agent-search,
.agent-cat.is-expired .agent-list-scroll,
.agent-cat.is-expired .agent-cart,
.agent-cat.is-expired .agent-bar,
.agent-cat.is-expired .load-more{display:none}
