<view class="page {{rtl ? 'rtl' : ''}}"><view wx:if="{{loading}}" class="empty">{{i18n.loading}}</view><view wx:elif="{{!items.length}}" class="empty">{{i18n.noFeedback}}</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="head"><view class="who-row"><text class="role {{item.role === 'agent' ? 'agent' : 'merchant'}}">{{item.roleLabel}}</text><text class="who">{{item.displayName}}</text></view><text class="del" bindtap="onDelete" data-id="{{item.id}}" hover-stay-time="50" hover-start-time="0">{{i18n.delete}}</text></view><text class="meta" wx:if="{{item.shopName}}">{{i18n.shop}}：{{item.shopName}}</text><text class="meta">{{item.userPhone}} · {{item.createdLabel}}</text><text class="msg">{{item.message}}</text></view></view>
