.page{min-height:100vh;background:#f5f6f8;padding:20rpx 24rpx 48rpx;box-sizing:border-box}
.page.has-save{padding-bottom:calc(148rpx + env(safe-area-inset-bottom))}
.hint{font-size:24rpx;line-height:1.45;margin-bottom:16rpx;padding:0 4rpx}
.hint.warn{color:#ef6c00}
.card{background:#fff;border-radius:16rpx;padding:28rpx 24rpx 32rpx;box-sizing:border-box}
.sec-title{display:block;font-size:30rpx;font-weight:700;color:#212121}
.sec-sub{display:block;margin-top:6rpx;font-size:24rpx;color:#9e9e9e}
.logo-wrap{display:flex;justify-content:center;margin:20rpx 0 12rpx}
.logo-box{position:relative;width:280rpx;height:280rpx;border-radius:12rpx;border:2rpx solid #e0e0e0;background:#f5f5f5;display:flex;align-items:center;justify-content:center;overflow:hidden;box-sizing:border-box}
.logo-img{width:100%;height:100%}
.logo-placeholder{font-size:72rpx;color:#bdbdbd;font-weight:300}
.logo-clear{position:absolute;top:4rpx;right:4rpx;width:48rpx;height:48rpx;line-height:44rpx;text-align:center;border-radius:50%;background:rgba(255,255,255,0.92);color:#e53935;font-size:36rpx;font-weight:700}
.pick-btn{display:flex;align-items:center;justify-content:center;gap:10rpx;margin:8rpx auto 0;color:#1e4d8c;font-size:28rpx;font-weight:600;padding:12rpx 24rpx}
.pick-btn.off{opacity:0.4;pointer-events:none}
.pick-ico{font-size:30rpx}
.logo-tip{display:block;text-align:center;margin-top:8rpx;font-size:22rpx;color:#9e9e9e;line-height:1.45;padding:0 12rpx}
.divider{height:1rpx;background:#eeeeee;margin:32rpx 0 28rpx}
.field{margin-bottom:28rpx}
.label{display:block;font-size:24rpx;color:#757575;margin-bottom:10rpx}
.input-row{display:flex;align-items:center;border:2rpx solid #cfd8dc;border-radius:12rpx;background:#fff;overflow:hidden;box-sizing:border-box}
.prefix{width:72rpx;text-align:center;font-size:24rpx;color:#9e9e9e;flex-shrink:0}
.input{flex:1;height:84rpx;padding:0 20rpx 0 0;font-size:28rpx}
.input-row-area{align-items:flex-start}
.input-row-area .prefix{padding-top:22rpx}
.sub-input{flex:1;width:0;min-height:84rpx;padding:16rpx 20rpx 16rpx 0;box-sizing:border-box;font-size:28rpx;color:#1a2b3c;line-height:1.45}
.switch-row{display:flex;align-items:center;gap:16rpx;margin-top:8rpx}
.size-row{display:flex;align-items:flex-end;margin-top:16rpx}
.size-opt{flex:1;height:96rpx;display:flex;align-items:center;justify-content:center;margin-right:12rpx;border-radius:12rpx;border:2rpx solid #cfd8dc;color:#5b7390;font-weight:600;box-sizing:border-box}
.size-opt:last-child{margin-right:0}
.size-opt.on{background:#1e4d8c;border-color:#1e4d8c;color:#fff}
.switch-txt{flex:1;min-width:0}
.save-bar{position:fixed;left:0;right:0;bottom:0;z-index:20;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #eee;box-sizing:border-box}
.save-big{height:88rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;border-radius:12rpx;background:#1e4d8c;color:#fff;font-size:30rpx;font-weight:700}
.save-ico{width:32rpx;height:32rpx;flex-shrink:0}
.save-big.off{opacity:0.5;pointer-events:none}
.save-hover{opacity:0.88}
.loading{padding:160rpx 0;text-align:center;color:#9e9e9e;font-size:28rpx}
