<view class="page {{rtl ? 'rtl' : ''}}"><text class="hint">{{i18n.agentReturnHint}}</text><view wx:if="{{loading}}" class="state">{{i18n.loading}}</view><view wx:elif="{{!rows.length}}" class="state">{{i18n.agentReturnEmpty}}</view><view class="list" wx:else><view class="row {{item.on ? 'on' : ''}}" wx:for="{{rows}}" wx:key="code"><view class="main" data-code="{{item.code}}" bindtap="onToggle"><text class="code">{{item.code}}</text><text class="name">{{item.name}} · {{item.max}}</text></view><view class="qty" wx:if="{{item.on}}"><text data-code="{{item.code}}" data-d="-1" catchtap="onQty">−</text><text class="n">{{item.qty}}</text><text data-code="{{item.code}}" data-d="1" catchtap="onQty">＋</text></view></view></view><input class="ipt" placeholder="{{i18n.remarkColon}}" value="{{remark}}" bindinput="onRemark" wx:if="{{rows.length}}" /><view class="btn {{submitting ? 'off' : ''}}" bindtap="onSubmit" wx:if="{{rows.length}}">{{i18n.agentReturn}}</view></view>
