.page{display:flex;flex-direction:column;background:#0f172a;box-sizing:border-box;overflow:hidden}
.stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center}
.player{background:#0f172a}
.soon{width:100%;background:#e8eef4;display:flex;flex-direction:column;align-items:center;justify-content:center}
.soon-play{width:112rpx;height:112rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center}
.soon-mark{width:0;height:0;margin-left:8rpx;border-style:solid;border-width:18rpx 0 18rpx 28rpx;border-color:transparent transparent transparent #1e4d8c}
.soon-t{margin-top:20rpx;font-size:26rpx;color:#6b7c93}
.bar{flex-shrink:0;height:88rpx;padding:0 16rpx;display:flex;align-items:center;background:#eef3f9}
.play,.full{flex-shrink:0;padding:0 16rpx;height:56rpx;line-height:56rpx;border-radius:999rpx;background:#1e4d8c;color:#fff;font-size:24rpx;font-weight:600}
.seek{flex:1;margin:0 12rpx}
.time{flex-shrink:0;min-width:132rpx;color:#5b7390;font-size:22rpx;text-align:center}
.title{flex-shrink:0;display:block;padding:16rpx 32rpx 24rpx;background:#f3f6fb;font-size:32rpx;font-weight:700;color:#163a6b}
