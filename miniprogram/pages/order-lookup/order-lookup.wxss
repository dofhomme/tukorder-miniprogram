.page{min-height:100vh;background:#eef3f9;padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.state{padding:80rpx 24rpx;text-align:center;color:#6b7c93;font-size:28rpx}
.wrap{max-width:720rpx;margin:0 auto}
.chain-badge{margin-bottom:20rpx;padding:18rpx 20rpx;border-radius:14rpx;background:linear-gradient(135deg,#eef6ff 0%,#f5fbf7 100%);border:1rpx solid #d5e6f5}
.chain-badge.chain-ok{background:linear-gradient(135deg,#e8f8ef 0%,#f3fbf7 100%);border-color:#b7e0c6}
.chain-badge-t{display:block;font-size:26rpx;font-weight:700;color:#1e4d8c}
.chain-ok .chain-badge-t{color:#1a7a45}
.chain-badge-d{display:block;margin-top:6rpx;font-size:22rpx;color:#6b7c93;line-height:1.45}
.chain-meta{display:block;margin-top:8rpx;font-size:20rpx;color:#8a98ab;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.warn{display:block;margin-bottom:16rpx;padding:14rpx 16rpx;border-radius:12rpx;background:#fff7e6;color:#b76a00;font-size:24rpx;line-height:1.45}
.ship-card{margin-bottom:20rpx;padding:22rpx 22rpx 8rpx;border-radius:16rpx;background:linear-gradient(160deg,#ffffff 0%,#f7fbf8 100%);border:1rpx solid #d7ebe0;box-shadow:0 8rpx 24rpx rgba(26,122,69,0.06)}
.ship-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.ship-status{display:flex;align-items:center;gap:12rpx}
.ship-dot{width:16rpx;height:16rpx;border-radius:50%;background:#1a7a45;box-shadow:0 0 0 6rpx rgba(26,122,69,0.16)}
.ship-status-t{font-size:30rpx;font-weight:700;color:#1a7a45;letter-spacing:1rpx}
.ship-count{font-size:22rpx;color:#6b7c93;background:#eef6f1;padding:6rpx 14rpx;border-radius:999rpx}
.ship-list{display:flex;flex-direction:column}
.ship-row{display:flex;align-items:center;gap:16rpx;padding:18rpx 4rpx 20rpx;border-top:1rpx solid #e8f0eb}
.ship-row:first-child{border-top:none}
.ship-row-hover{opacity:0.82}
.ship-badge{flex-shrink:0;min-width:72rpx;padding:8rpx 16rpx;border-radius:10rpx;color:#fff;font-size:22rpx;font-weight:700;text-align:center;line-height:1.3}
.ship-meta{flex:1;min-width:0}
.ship-lab{display:block;font-size:20rpx;color:#8a98ab;margin-bottom:4rpx}
.ship-no{display:block;font-size:28rpx;font-weight:600;color:#163a6b;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:0.5rpx;word-break:break-all;line-height:1.35}
.ship-copy{flex-shrink:0;font-size:22rpx;color:#1e4d8c;padding:8rpx 16rpx;border-radius:999rpx;background:#eef3f9}
.receipt-card{background:#fff;border-radius:16rpx;padding:8rpx 8rpx 20rpx;box-shadow:0 8rpx 28rpx rgba(22,58,107,0.06);overflow:hidden}
.photo-card{margin:0 0 20rpx;background:#fff;border-radius:16rpx;overflow:hidden;box-shadow:0 8rpx 28rpx rgba(22,58,107,0.06)}
.photo{width:100%;height:320rpx;display:block;background:#eef3f9}
.photo-t{display:block;padding:16rpx 20rpx 20rpx;font-size:26rpx;color:#163a6b;font-weight:600}
.reject-card{margin:0 0 20rpx;padding:18rpx 20rpx;background:#fff7ed;border-radius:16rpx;border:1rpx solid #fed7aa}
.reject-t{display:block;font-size:26rpx;font-weight:700;color:#b45309}
.reject-d{display:block;margin-top:6rpx;font-size:24rpx;color:#9a3412}
.page.rtl{direction:rtl}
