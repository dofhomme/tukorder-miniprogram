<view class="page"><view class="card"><view class="code-line"><image wx:if="{{linkText}}" class="link-mark" src="/assets/icons/pe-link.svg" mode="aspectFit" /><text class="title">{{productCode}}</text></view><text class="sub">售价和库存仍在我的商品里改</text></view><view class="field" wx:if="{{fabrics.length}}"><text class="label">面料</text><view class="input pick" data-kind="fabric" bindtap="onOpenPick"><text class="pick-txt">{{fabricText}}</text><text class="pick-chev">▾</text></view></view><view class="field"><text class="label">单件用料（米）</text><input class="input" type="digit" placeholder="填写米数" placeholder-class="ph" value="{{metersPerPiece}}" bindinput="onMeters" /><text class="sub" wx:if="{{avgMaterialText}}">参考 {{avgMaterialText}}</text></view><view class="field" wx:if="{{trims.length}}"><text class="label">辅料</text><view class="input pick" data-kind="trim" bindtap="onOpenPick"><text class="pick-txt">{{trimText}}</text><text class="pick-chev">▾</text></view></view><view class="pick-mask" wx:if="{{pickOpen}}" catchtouchmove="noop" bindtap="onClosePick"><view class="pick-dialog" catchtap="noop"><text class="pick-title">{{pickTitle}}</text><view class="pick-search"><text class="pick-search-ico">🔍</text><input class="pick-search-input" value="{{pickQuery}}" placeholder="搜索" placeholder-class="pick-ph" bindinput="onPickQuery" /><text class="pick-search-clear" wx:if="{{pickQuery}}" catchtap="onClearPickQuery">✕</text></view><scroll-view class="pick-list" scroll-y><view class="pick-row {{item.on ? 'on' : ''}}" wx:for="{{pickRows}}" wx:key="index" data-index="{{item.index}}" bindtap="onPickRow"><text class="pick-name">{{item.label}}</text><text class="pick-mark" wx:if="{{item.on}}">✓</text></view><view class="pick-empty" wx:if="{{!pickRows.length}}">没有匹配项</view></scroll-view><view class="pick-actions"><text class="pick-act" bindtap="onClosePick">取消</text></view></view></view><view class="field"><text class="label">单件辅料用量</text><input class="input" type="digit" placeholder="填写用量" placeholder-class="ph" value="{{trimQtyPerPiece}}" bindinput="onTrimQty" /></view><view class="seg price-seg"><text class="seg-item {{priceMode === 'cmt' ? 'on' : ''}}" data-mode="cmt" bindtap="onPriceMode">加工单价</text><text class="seg-item {{priceMode === 'package' ? 'on' : ''}}" data-mode="package" bindtap="onPriceMode">包工包料</text><text class="seg-item {{priceMode === 'buy' ? 'on' : ''}}" data-mode="buy" bindtap="onPriceMode">外采进货价</text></view><view class="field" wx:if="{{priceMode === 'cmt'}}"><text class="label">加工单价</text><input class="input" type="digit" placeholder="填写单价" placeholder-class="ph" value="{{processPrice}}" bindinput="onProcess" /></view><view class="field" wx:if="{{priceMode === 'package'}}"><text class="label">包工包料单价</text><input class="input" type="digit" placeholder="填写单价" placeholder-class="ph" value="{{packagePrice}}" bindinput="onPackage" /></view><view class="field" wx:if="{{priceMode === 'buy'}}"><text class="label">外采进货价</text><input class="input" type="digit" placeholder="填写进货价" placeholder-class="ph" value="{{buyPrice}}" bindinput="onBuy" /></view><text class="sub std" wx:if="{{stdText}}">{{stdText}}</text><view class="btn" bindtap="onSave"><image class="btn-ico" src="/assets/icons/pe-save.svg" mode="aspectFit" /><text>保存</text></view></view>
