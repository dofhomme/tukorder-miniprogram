.page{min-height:100vh;background:radial-gradient(ellipse 90% 40% at 8% -6%,rgba(45,158,139,0.18) 0%,transparent 55%),linear-gradient(180deg,#d7efe9 0%,#eef6f4 36%,#f3f7f6 100%);padding:20rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.state-wrap{padding:48rpx 12rpx}
.state,.hint,.lead{display:block;color:#6b857f;font-size:26rpx;line-height:1.6}
.lead{padding:8rpx 8rpx 20rpx}
.empty-card{margin-top:12rpx;padding:48rpx 28rpx;border-radius:24rpx;background:#fff;text-align:center}
.empty-t{display:block;margin-bottom:28rpx;font-size:30rpx;font-weight:600;color:#134e4a}
.shop-card{margin-bottom:20rpx;padding:28rpx 28rpx 24rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(19,78,74,0.06)}
.shop-card.on{box-shadow:inset 0 0 0 2rpx rgba(15,118,110,0.28),0 8rpx 24rpx rgba(19,78,74,0.06)}
.shop-top{display:flex;align-items:flex-start;gap:16rpx}
.shop-copy{flex:1;min-width:0}
.shop-name{display:block;font-size:34rpx;font-weight:700;color:#134e4a;line-height:1.3}
.shop-who{display:block;margin-top:8rpx;font-size:26rpx;color:#5f7a76}
.role{flex-shrink:0;padding:6rpx 14rpx;border-radius:999rpx;font-size:22rpx;font-weight:700}
.role.admin{color:#0f766e;background:rgba(15,118,110,0.12)}
.role.staff{color:#64748b;background:#eef2f4}
.shop-meta{margin-top:16rpx;display:flex;align-items:center;gap:16rpx}
.now{font-size:22rpx;font-weight:700;color:#0f766e}
.debt{font-size:24rpx;color:#b45309}
.shop-act{margin-top:20rpx;display:flex;justify-content:flex-end}
.unbind{min-width:140rpx;height:64rpx;padding:0 28rpx;border-radius:14rpx;background:rgba(225,29,72,0.08);color:#be123c;font-size:26rpx;font-weight:700;line-height:64rpx;text-align:center}
.renew{margin:0 16rpx 0 0;padding:0 24rpx;height:64rpx;line-height:64rpx;border-radius:14rpx;background:#1E4D8C;color:#fff;font-size:26rpx;font-weight:700}
.renew::after{border:none}
.unbind.off{opacity:0.45;pointer-events:none}
.unbind-on{opacity:0.78}
.btn{display:inline-block;min-width:220rpx;height:76rpx;line-height:76rpx;padding:0 32rpx;border-radius:16rpx;background:#0f766e;color:#fff;font-size:28rpx;font-weight:700;text-align:center}
.btn.ghost{margin-top:24rpx;background:transparent;color:#0f766e;box-shadow:inset 0 0 0 2rpx rgba(15,118,110,0.28)}
.page.rtl .shop-act{justify-content:flex-start}
