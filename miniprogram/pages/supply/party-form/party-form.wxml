<view class="field"><text class="label">名称</text><input class="input" placeholder="填写名称" placeholder-class="ph" value="{{name}}" bindinput="onName" /></view><view class="field"><text class="label">电话</text><input class="input" type="number" placeholder="填写电话" placeholder-class="ph" value="{{phone}}" bindinput="onPhone" /></view><view class="field"><text class="label">身份</text><view class="checks"><text class="check {{item.on ? 'on' : ''}}" wx:for="{{roles}}" wx:key="key" data-key="{{item.key}}" bindtap="onRole">{{item.label}}</text></view></view><view class="field"><text class="label">结算</text><view class="checks"><text class="check {{settleMode === 'cash' ? 'on' : ''}}" data-mode="cash" bindtap="onSettle">现结</text><text class="check {{settleMode === 'monthly' ? 'on' : ''}}" data-mode="monthly" bindtap="onSettle">月结</text></view></view><view class="field"><text class="label">备注</text><input class="input" placeholder="选填" placeholder-class="ph" value="{{remark}}" bindinput="onRemark" /></view><view class="btn" bindtap="onSave"><image class="btn-ico" src="/assets/icons/pe-save.svg" mode="aspectFit" /><text>保存</text></view><view class="btn ghost" wx:if="{{id}}" bindtap="onDisable">停用</view><view class="btn ghost" wx:if="{{id}}" bindtap="onDelete">删除</view>
