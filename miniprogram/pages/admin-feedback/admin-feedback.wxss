.page{min-height:100vh;background:#f5f6f8;padding:24rpx;box-sizing:border-box}
.empty{padding:160rpx 0;text-align:center;color:#9e9e9e;font-size:30rpx}
.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}
.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx}
.who-row{display:flex;align-items:center;gap:12rpx;min-width:0;flex:1}
.who{font-size:30rpx;font-weight:700;color:#212121}
.role{flex-shrink:0;font-size:22rpx;font-weight:600;line-height:1;padding:6rpx 12rpx;border-radius:8rpx}
.role.merchant{color:#163a6b;background:#dbe7f5}
.role.agent{color:#1b5e20;background:#e8f5e9}
.del{color:#e53935;font-size:26rpx}
.meta{display:block;font-size:22rpx;color:#9e9e9e;margin-top:4rpx}
.msg{display:block;margin-top:16rpx;font-size:28rpx;color:#424242;line-height:1.5;white-space:pre-wrap}
