<view class="bench"><view class="pin" wx:if="{{!editingId && tabs.length > 1 && !editType}}"><view class="seg"><text class="seg-item {{docType === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTab">{{item.label}}</text></view></view><scroll-view class="scroller" scroll-y scroll-into-view="{{anchor}}" scroll-with-animation bindscrolltolower="onMore" lower-threshold="120"><view class="card" id="editor"><text class="title">{{editingId ? '修改' : '新建'}}{{tabs.length > 1 ? tabLabel : ''}}</text><view class="field" wx:if="{{pickParty && docType !== 'cut'}}"><text class="label">{{partyLabel}}</text><view class="input pick" data-kind="party" bindtap="onOpenPick"><text class="pick-txt">{{pickedPartyId && partyChoices[partyChoiceIndex] ? partyChoices[partyChoiceIndex].name : (partyChoices.length ? '请选择' + partyLabel : '请先建立' + partyLabel)}}</text><text class="pick-chev">▾</text></view></view><view class="field" wx:if="{{showFactory}}"><text class="label">加工厂</text><view class="input pick" data-kind="factory" bindtap="onOpenPick"><text class="pick-txt">{{factoryId && factories[factoryIndex] ? factories[factoryIndex].name : (factories.length ? '请选择加工厂' : '请先建立加工厂')}}</text><text class="pick-chev">▾</text></view></view><view class="field" wx:if="{{docType === 'fabric_in' || docType === 'trim_in'}}"><text class="label">款号</text><view class="input pick" data-kind="style" bindtap="onOpenPick"><text class="pick-txt">{{productCode || '请选择款号'}}</text><text class="pick-chev">▾</text></view></view><view class="field" wx:if="{{needMaterial}}"><text class="label">物料</text><view class="input pick" data-kind="material" bindtap="onOpenPick"><text class="pick-txt">{{materialId && materials[materialIndex] ? materials[materialIndex].label : (materials.length ? '请选择物料' : '请先在物料档案里建好')}}</text><text class="pick-chev">▾</text></view></view><view class="seg" wx:if="{{docType === 'delivery' && role === 'factory'}}"><text class="seg-item {{batchMode === 'cmt' ? 'on' : ''}}" data-mode="cmt" bindtap="onMode">来料加工</text><text class="seg-item {{batchMode === 'package' ? 'on' : ''}}" data-mode="package" bindtap="onMode">包工包料</text></view><text class="sub" wx:if="{{docType === 'delivery' && role === 'factory' && batchMode === 'cmt' && !partyId && !pickedPartyId}}">先选择加工厂，再选这家厂最近的裁剪。</text><view class="field" wx:if="{{docType === 'delivery' && role === 'factory' && batchMode === 'cmt' && (partyId || pickedPartyId)}}"><text class="label">本次裁剪</text><view class="input pick" data-kind="deliveryCut" bindtap="onOpenPick"><text class="pick-txt">{{deliveryCutText}}</text><text class="pick-chev">▾</text></view><text class="sub">还没送完的裁剪可以继续选。提交时，送货总数不能超过裁剪件数。</text></view><view class="field" wx:if="{{docType === 'cut'}}"><text class="label">加工厂</text><view class="input pick" data-kind="cutFactory" bindtap="onOpenPick"><text class="pick-txt">{{cutFactoryText}}</text><text class="pick-chev">▾</text></view></view><text class="sub" wx:if="{{docType === 'cut' && !factoryId}}">先选择加工厂，再选这家厂的面料和辅料。</text><view class="field" wx:if="{{docType === 'cut' && factoryId}}"><text class="label">本次面料</text><view class="input pick" data-kind="cutFabric" bindtap="onOpenPick"><text class="pick-txt">{{cutFabricText}}</text><text class="pick-chev">▾</text></view></view><view class="field" wx:if="{{docType === 'cut' && factoryId}}"><text class="label">本次辅料</text><view class="input pick" data-kind="cutTrim" bindtap="onOpenPick"><text class="pick-txt">{{cutTrimText}}</text><text class="pick-chev">▾</text></view><text class="sub">面料选好后，货号从发料单自动带出。辅料可以不选。用过的不能再选。</text></view><view class="field" wx:if="{{docType === 'cut'}}"><text class="label">货号</text><view class="input">{{productCode || '选好面料后自动带出'}}</view></view><view class="field" wx:elif="{{needBatch}}"><text class="label">货号</text><input class="input" placeholder="搜索并选择货号" placeholder-class="ph" value="{{productCode}}" bindinput="onCode" /><view class="code-hits" wx:if="{{codeHits.length}}"><text class="code-hit" wx:for="{{codeHits}}" wx:key="*this" data-code="{{item}}" catchtap="onPickCode">{{item}}</text></view></view><view class="field" wx:if="{{showMeters}}"><text class="label">米数</text><input class="input" type="digit" placeholder="填写米数" placeholder-class="ph" value="{{meters}}" bindinput="onMeters" /></view><view class="field" wx:if="{{showBolts}}"><text class="label">匹数</text><input class="input" type="digit" placeholder="几匹" placeholder-class="ph" value="{{bolts}}" bindinput="onBolts" /></view><view class="field" wx:if="{{showIssuedAt}}"><text class="label">发出时间</text><view class="time-row"><picker mode="date" value="{{issuedDate}}" bindchange="onIssuedDate"><view class="input">{{issuedDate}}</view></picker><picker mode="time" value="{{issuedClock}}" bindchange="onIssuedClock"><view class="input">{{issuedClock}}</view></picker></view></view><view class="field" wx:if="{{showQty && docType !== 'cut'}}"><text class="label">数量 / 件数</text><input class="input" type="digit" placeholder="填写数量" placeholder-class="ph" value="{{qty}}" bindinput="onQty" /></view><view class="field" wx:if="{{docType === 'cut'}}"><text class="label">裁剪总数</text><input class="input" type="digit" placeholder="填写裁剪总数" placeholder-class="ph" value="{{qty}}" bindinput="onQty" /></view><view class="field" wx:if="{{docType === 'cut'}}"><text class="label">尺码件数</text><view class="ratio-grid"><view class="ratio-col" wx:for="{{sizeRatios}}" wx:key="index"><input class="input size-name" placeholder="尺码" placeholder-class="ph" value="{{item.size}}" data-index="{{index}}" bindinput="onRatioSize" /><text class="ratio-x" wx:if="{{sizeRatios.length > 1}}" data-index="{{index}}" catchtap="onRemoveRatio">×</text><input class="input" type="number" placeholder="件数" placeholder-class="ph" value="{{item.ratio}}" data-index="{{index}}" bindinput="onRatioNum" /></view><text class="ratio-add" bindtap="onAddRatio">+</text></view><text class="sub">上排写尺码，下排写这个尺码裁了几件。各尺码件数加起来要等于裁剪总数。</text><text class="sub" wx:if="{{sizeRatioText}}">{{sizeRatioText}}</text><text class="material-cost" wx:if="{{materialUnitText}}">{{materialUnitText}}</text></view><view class="btn invite" wx:if="{{docType === 'cut' && !editingId}}" bindtap="onInviteCut">邀请填写裁剪数</view><text class="sub" wx:if="{{inviteNote}}">{{inviteNote}}</text><text class="hint" wx:if="{{inviteToken}}" bindtap="onCopyInvite">再复制口令</text><view class="field" wx:if="{{showSize && docType !== 'cut'}}"><text class="label">尺码</text><input class="input" placeholder="填写尺码" placeholder-class="ph" value="{{size}}" bindinput="onSize" /></view><view class="field" wx:if="{{lockProcess}}"><text class="label">加工费</text><view class="input {{productCode && !unitPrice ? 'link' : ''}}" bindtap="onCreateProcess">{{unitPrice ? '¥' + unitPrice : (productCode ? '去创建加工费' : '选好货号后自动带出')}}</view></view><view class="field" wx:elif="{{lockFabricPrice}}"><text class="label">单价</text><view class="input">{{unitPrice ? '¥' + unitPrice : (materialId ? '这个面料还没有单价' : '选好面料后自动带出')}}</view></view><view class="field" wx:elif="{{showPrice}}"><text class="label">{{priceLabel}}</text><input class="input" type="digit" placeholder="填写单价" placeholder-class="ph" value="{{unitPrice}}" bindinput="onPrice" /></view><view class="ship-row" wx:if="{{docType !== 'cut'}}"><input class="input" placeholder="物流名称" placeholder-class="ph" value="{{logisticsName}}" bindinput="onLogisticsName" /><input class="input" placeholder="单号" placeholder-class="ph" value="{{logisticsNo}}" bindinput="onLogistics" /><view class="ship-slip {{slipPath ? 'on' : ''}}" bindtap="onSlip"><image wx:if="{{slipPath}}" class="ship-thumb" src="{{slipPath}}" mode="aspectFill" data-url="{{slipPath}}" catchtap="onPreview" /><text wx:else>凭证</text><text wx:if="{{slipPath}}" class="ship-x" catchtap="onClearSlip">×</text></view></view><view class="field" wx:if="{{showPaid}}"><text class="label">是否付款</text><view class="seg"><text class="seg-item {{!paid ? 'on' : ''}}" data-paid="0" bindtap="onPaid">未付</text><text class="seg-item {{paid ? 'on' : ''}}" data-paid="1" bindtap="onPaid">已付</text></view><text class="sub">未付计入欠款，已付不算</text></view><view class="amount-bar" wx:if="{{docType !== 'cut'}}"><text class="label">总金额</text><text class="amount-num">¥{{amountText}}</text></view><view class="btn" bindtap="onSave"><image class="btn-ico" src="/assets/icons/pe-save.svg" mode="aspectFit" /><text>{{editingId ? '保存修改' : '保存'}}</text></view></view><view class="card" wx:if="{{statements.length}}"><text class="title">对账单</text><view wx:for="{{statements}}" wx:for-item="st" wx:key="id"><view class="row"><text class="sub">{{st.statementNo}} 未付 ¥{{st.unpaid}}</text><text class="photo-x" data-id="{{st.id}}" catchtap="onDeleteStatement">删除</text></view><view class="photos" wx:if="{{st.files.length}}"><image class="thumb" wx:for="{{st.files}}" wx:for-item="pic" wx:key="id" src="{{pic.url}}" mode="aspectFill" data-url="{{pic.url}}" catchtap="onPreview" /></view></view></view><view class="scroller-pad"></view></scroll-view><view class="mask" wx:if="{{acceptId}}" bindtap="onCloseAccept" catchtouchmove="noop"><view class="sheet" catchtap="noop"><text class="title">验收 {{acceptNo}}</text><view class="time-row"><view class="btn slim" data-source="camera" bindtap="onAcceptPhoto">拍照</view><view class="btn slim ghost-blue" data-source="album" bindtap="onAcceptPhoto">相册</view></view><view class="photos" wx:if="{{acceptPhoto}}"><image class="thumb" src="{{acceptPhoto}}" mode="aspectFill" data-url="{{acceptPhoto}}" bindtap="onPreview" /></view><text class="sub">可以不拍照，直接确认验收</text><view class="btn" bindtap="onConfirmAccept">确认验收</view><view class="btn ghost" bindtap="onCloseAccept">取消</view></view></view><view class="pick-mask" wx:if="{{pickOpen}}" catchtouchmove="noop" bindtap="onClosePick"><view class="pick-dialog" catchtap="noop"><text class="pick-title">{{pickTitle}}</text><view class="pick-search"><text class="pick-search-ico">🔍</text><input class="pick-search-input" value="{{pickQuery}}" placeholder="搜索" placeholder-class="pick-ph" bindinput="onPickQuery" /><text class="pick-search-clear" wx:if="{{pickQuery}}" catchtap="onClearPickQuery">✕</text></view><scroll-view class="pick-list" scroll-y><view class="pick-row {{item.on ? 'on' : ''}}" wx:for="{{pickRows}}" wx:key="index" data-index="{{item.index}}" data-id="{{item.id}}" data-label="{{item.label}}" bindtap="onPickRow"><text class="pick-name">{{item.label}}</text><text class="pick-mark" wx:if="{{item.on}}">✓</text></view><view class="pick-empty" wx:if="{{!pickRows.length}}">没有匹配项</view></scroll-view><view class="pick-actions"><text class="pick-act" bindtap="onClosePick">取消</text><text class="pick-act strong" wx:if="{{pickMulti}}" bindtap="onConfirmPick">确定</text></view></view></view></view>
