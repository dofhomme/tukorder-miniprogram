<view class="page {{rtl ? 'rtl' : ''}}" wx:if="{{ready}}"><view class="header"><view class="status-spacer" style="height: {{statusBarHeight}}px;"></view><view class="nav-row" style="height: {{navBarHeight}}px; padding-right: {{capsuleSafeRight}}px;"><view
        class="nav-back"
        bindtap="onBack"
        hover-class="tap-hover"
        hover-stay-time="50"
        hover-start-time="0"
      >‹</view><text class="nav-title">{{navTitle}}</text><view class="nav-spacer"></view><view
        class="bt-link {{btConnected ? 'on' : ''}}"
        bindtap="onBluetoothSearch"
        hover-class="tap-hover"
        hover-stay-time="50"
        hover-start-time="0"
      ><image
          class="bt-ico"
          src="{{linkWifi ? (btConnected ? '/assets/icons/stmt-wifi-on.svg' : '/assets/icons/stmt-wifi.svg') : (btConnected ? '/assets/icons/stmt-bluetooth-on.svg' : '/assets/icons/stmt-bluetooth.svg')}}"
          mode="aspectFit"
        /><text class="bt-txt">{{btLabel}}</text></view></view></view><scroll-view scroll-y class="body"><view class="card head-card"><text class="shop">{{shopName}}</text><view class="pill {{unpaidOnly ? 'danger' : ''}}"><text>{{unpaidOnly ? i18n.unpaidCustomerStatement : i18n.customerStatement}}</text></view><view class="divider"></view><view class="info-row"><text class="info-l">{{i18n.labelCustomer}}</text><text class="info-v">{{customerName}}</text></view><view class="info-row" wx:if="{{customerPhone}}"><text class="info-l">{{i18n.phoneLab}}</text><text class="info-v">{{customerPhone}}</text></view><view class="info-row"><text class="info-l">{{i18n.period}}</text><text class="info-v">{{rangeLabel}}</text></view><view class="info-row"><text class="info-l">{{i18n.printTimeLab}}</text><text class="info-v">{{printTime}}</text></view></view><view class="card"><view class="sec-h"><text class="sec-t">{{i18n.orderLines}}（{{totals.orderCount}} {{i18n.orderUnit}}）</text><text class="sec-hint">{{i18n.tapToChangePay}}</text></view><view
        class="mark-all"
        wx:if="{{unpaidEditableCount > 0}}"
        bindtap="onMarkAllPaid"
        hover-class="tap-hover"
        hover-stay-time="50"
        hover-start-time="0"
      ><text class="mark-all-t">{{markingAll ? i18n.markingAllPaid : i18n.markAllPaid}}（{{unpaidEditableCount}}）</text></view><view class="order-row" wx:for="{{orders}}" wx:key="orderNo"><view class="idx">{{index + 1}}</view><view class="order-mid"><text class="order-date">{{item.createdAt}}</text><text class="order-no" wx:if="{{item.orderNoLabel}}">{{item.orderNoLabel}}</text></view><view class="order-r"><text class="order-amt {{item.statusClass === 'unpaid' ? 'unpaid' : ''}}">¥{{item.amountLabel}}</text><view class="order-meta"><text class="order-qty">{{item.qtyLabel}}</text><text
              class="tag {{item.statusClass}} tap"
              catchtap="onToggleStatus"
              data-index="{{index}}"
            >{{item.statusLabel}}</text></view></view></view><view wx:if="{{!orders.length}}" class="empty">{{i18n.noOrdersPeriod}}</view></view><view class="card sum-card"><view class="sum-row"><text class="sum-l">{{i18n.total}}（{{totals.orderCount}} {{i18n.orderUnit}} / {{totals.qty}} {{i18n.unitPiece}}）</text><text class="sum-v">¥{{totals.totalLabel}}</text></view><view class="sum-row" wx:if="{{totals.paidCount > 0}}"><text class="sum-l">{{i18n.paidCount}}（{{totals.paidCount}} {{i18n.orderUnit}}）</text><text class="sum-v paid">¥{{totals.paidLabel}}</text></view><view class="sum-row" wx:if="{{totals.unpaidCount > 0}}"><text class="sum-l">{{i18n.unpaidCount}}（{{totals.unpaidCount}} {{i18n.orderUnit}}）</text><text class="sum-v unpaid">¥{{totals.unpaidLabel}}</text></view><view class="divider"></view><view class="recv-row"><text class="recv-l">{{i18n.receivable}}</text><text class="recv-v">¥{{totals.receivableLabel}}</text></view></view><view class="card pay-card" wx:if="{{showPayQr && (wechatQr || alipayQr)}}"><text class="pay-hint" wx:if="{{qrHint}}" user-select>{{qrHint}}</text><view class="pay-row"><view class="pay-col" wx:if="{{wechatQr}}"><qr-image class="pay-qr" src="{{wechatQr}}" kind="wechatPay" bind:scan="onScanPageQrs" /><text class="pay-lab">微信支付</text></view><view class="pay-col" wx:if="{{alipayQr}}"><qr-image class="pay-qr" src="{{alipayQr}}" kind="alipayPay" bind:scan="onScanPageQrs" /><text class="pay-lab">支付宝支付</text></view></view></view></scroll-view><view class="foot"><button
      class="btn mark-full {{unpaidEditableCount<=0 || markingAll ? 'off' : ''}}"
      wx:if="{{unpaidEditableCount > 0}}"
      bindtap="onMarkAllPaid"
      disabled="{{unpaidEditableCount<=0 || markingAll || printing}}"
      loading="{{markingAll}}"
      hover-class="btn-hover"
      hover-stay-time="50"
      hover-start-time="0"
    ><text>{{markingAll ? i18n.markingAllPaid : i18n.markAllPaid}}</text></button><view class="foot-row"><button
        class="btn primary {{!btConnected || printing || markingAll ? 'off' : ''}}"
        bindtap="onPrint"
        disabled="{{!btConnected || printing || markingAll}}"
        loading="{{printing}}"
        hover-class="btn-hover"
        hover-stay-time="50"
        hover-start-time="0"
      ><image class="btn-ico" src="/assets/icons/stmt-print.svg" mode="aspectFit" /><text>{{printing ? i18n.printing : i18n.confirmPrint}}</text></button><button class="btn outline" bindtap="onOpenExport" disabled="{{markingAll || printing}}" hover-class="btn-hover" hover-stay-time="50" hover-start-time="0"><image class="btn-ico blue" src="/assets/icons/stmt-download.svg" mode="aspectFit" /><text>{{i18n.downloadBill}}</text></button></view><view
      class="btn cloud {{printing || markingAll ? 'off' : ''}}"
      wx:if="{{cloudPrintVisible}}"
      bindtap="onCloudPrint"
      hover-class="btn-hover"
      hover-stay-time="50"
      hover-start-time="0"
    >{{i18n.cloudPrintToPc}}</view><button
      class="btn share {{shareReady ? '' : 'wait'}}"
      open-type="{{shareReady ? 'share' : ''}}"
      bindtap="onShareTap"
      disabled="{{markingAll || printing}}"
      hover-class="btn-hover"
      hover-stay-time="50"
      hover-start-time="0"
    >{{i18n.shareStatement}}</button></view><view class="mask" wx:if="{{showExport}}" catchtouchmove="noop"><view class="export-sheet" catchtap="noop"><text class="export-title">{{unpaidOnly ? i18n.exportUnpaidStmt : i18n.exportStmt}}</text><scroll-view scroll-y class="export-body"><view class="export-preview"><view class="export-head"><text class="shop sm">{{shopName}}</text><view class="pill sm {{unpaidOnly ? 'danger' : ''}}"><text>{{unpaidOnly ? '客户对账单 · 未付款' : '客户对账单'}}</text></view><view class="divider"></view><view class="info-row"><text class="info-l">客户</text><text class="info-v">{{customerName}}</text></view><view class="info-row" wx:if="{{customerPhone}}"><text class="info-l">电话</text><text class="info-v">{{customerPhone}}</text></view><view class="info-row"><text class="info-l">时段</text><text class="info-v">{{rangeLabel}}</text></view><view class="info-row"><text class="info-l">打印时间</text><text class="info-v">{{printTime}}</text></view></view><view class="export-list-card"><view class="sec-h"><text class="sec-t sm">账单明细（{{totals.orderCount}} 单）</text></view><view class="order-row export" wx:for="{{orders}}" wx:key="orderNo"><view class="idx">{{index + 1}}</view><view class="order-mid"><text class="order-date">{{item.createdAt}}</text><text class="order-no">{{item.orderNoLabel}}</text></view><view class="order-r"><text class="order-amt {{item.statusClass === 'unpaid' ? 'unpaid' : ''}}">¥{{item.amountLabel}}</text><view class="order-meta"><text class="order-qty">{{item.qtyLabel}}</text><text class="tag {{item.statusClass}}">[{{item.statusLabel}}]</text></view></view></view></view><view class="export-sum-card"><view class="sum-row"><text class="sum-l">合计（{{totals.orderCount}} 单 / {{totals.qty}} 件）</text><text class="sum-v">¥{{totals.totalLabel}}</text></view><view class="sum-row" wx:if="{{totals.paidCount > 0}}"><text class="sum-l">已付（{{totals.paidCount}} 单）</text><text class="sum-v paid">¥{{totals.paidLabel}}</text></view><view class="sum-row" wx:if="{{totals.unpaidCount > 0}}"><text class="sum-l">未付（{{totals.unpaidCount}} 单）</text><text class="sum-v unpaid">¥{{totals.unpaidLabel}}</text></view><view class="divider"></view><view class="recv-row"><text class="recv-l">应收款</text><text class="recv-v">¥{{totals.receivableLabel}}</text></view></view><view class="export-sum-card" wx:if="{{showPayQr && (wechatQr || alipayQr)}}"><text class="pay-hint" wx:if="{{qrHint}}" user-select>{{qrHint}}</text><view class="pay-row"><view class="pay-col" wx:if="{{wechatQr}}"><qr-image class="pay-qr" src="{{wechatQr}}" kind="wechatPay" bind:scan="onScanPageQrs" /><text class="pay-lab">微信支付</text></view><view class="pay-col" wx:if="{{alipayQr}}"><qr-image class="pay-qr" src="{{alipayQr}}" kind="alipayPay" bind:scan="onScanPageQrs" /><text class="pay-lab">支付宝支付</text></view></view></view></view></scroll-view><view class="export-acts"><button class="export-cancel" bindtap="onCloseExport" hover-stay-time="50" hover-start-time="0">{{i18n.close}}</button><button class="export-save" bindtap="onSaveImage" loading="{{saving}}" hover-stay-time="50" hover-start-time="0">{{i18n.saveImage}}</button></view></view></view><canvas type="2d" id="stmtCanvas" class="off-canvas"></canvas><bluetooth-search-sheet id="btSheet" bind:reconnect="onBtReconnect" /></view>
