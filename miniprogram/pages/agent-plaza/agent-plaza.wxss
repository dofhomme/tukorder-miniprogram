.page{min-height:100vh;background:radial-gradient(ellipse 90% 40% at 8% -6%,rgba(45,158,139,0.18) 0%,transparent 55%),linear-gradient(180deg,#d7efe9 0%,#eef6f4 36%,#f3f7f6 100%);padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.hint,.empty,.more,.cancel{display:block;color:#6b857f;font-size:26rpx;line-height:1.6}
.row{margin-top:16rpx;display:flex;align-items:center;gap:16rpx;padding:20rpx 24rpx;border-radius:16rpx;background:rgba(255,255,255,0.92)}
.row-hover{opacity:0.86}
.logo,.mark{width:72rpx;height:72rpx;border-radius:16rpx;flex-shrink:0}
.mark{background:rgba(15,118,110,0.12);color:#0f766e;display:flex;align-items:center;justify-content:center;font-weight:700}
.mid{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}
.name{font-size:30rpx;font-weight:700;color:#134e4a}
.sub{font-size:22rpx;color:#6b857f}
.btn{font-size:24rpx;color:#0f766e;font-weight:600}
.more{margin-top:24rpx;text-align:center}
.empty{margin-top:48rpx;text-align:center}
.mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:40;background:rgba(15,42,79,0.45);display:flex;align-items:center;justify-content:center;padding:48rpx 40rpx}
.card{width:100%;background:#fff;border-radius:24rpx;padding:40rpx 32rpx}
.title{display:block;font-size:34rpx;font-weight:700;color:#134e4a}
.ipt{margin-top:16rpx;height:80rpx;padding:0 20rpx;border-radius:12rpx;background:#f3f6fb;font-size:28rpx}
.go{margin-top:28rpx;height:80rpx;line-height:80rpx;text-align:center;border-radius:16rpx;background:#0f766e;color:#fff;font-weight:600}
.go.off{opacity:0.45}
.cancel{margin-top:16rpx;text-align:center}
