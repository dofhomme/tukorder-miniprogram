<view class="page {{rtl ? 'rtl' : ''}}"><view class="header"><view class="status-spacer" style="height: {{statusBarHeight}}px;"></view><view class="nav-row" style="height: {{navBarHeight}}px; padding-right: {{capsuleSafeRight}}px;"><view class="nav-back" bindtap="onBack" hover-class="tap-hover">‹</view><text class="nav-title">{{i18n.connectPrinter}}</text><view class="nav-refresh {{scanning ? 'spin' : ''}}" bindtap="onScan" hover-class="tap-hover">↻</view></view></view><view class="conn-bar {{connected ? 'ok' : 'warn'}}"><text class="conn-ico">{{connected ? '✓' : '!'}}</text><text class="conn-txt">{{connected ? (i18n.connectedPrefix + savedName) : (autoConnecting ? (i18n.connectingPrefix + (savedName || i18n.printerBadge) + '…') : (savedName ? (i18n.disconnectedLast + savedName) : i18n.noPrinterConnected))}}</text><text class="conn-act" wx:if="{{connected}}" bindtap="onDisconnect">{{i18n.disconnect}}</text></view><view class="paper-bar"><text class="paper-lab">{{i18n.paperWidthLab}}</text><view class="chip {{paperWidth===58?'on':''}}" data-mm="58" bindtap="onPaper"><text wx:if="{{paperWidth===58}}" class="chip-ck">✓</text>58mm
    </view><view class="chip {{paperWidth===80?'on':''}}" data-mm="80" bindtap="onPaper"><text wx:if="{{paperWidth===80}}" class="chip-ck">✓</text>80mm
    </view><view class="chip {{paperWidth===110?'on':''}}" data-mm="110" bindtap="onPaper"><text wx:if="{{paperWidth===110}}" class="chip-ck">✓</text>110mm
    </view></view><view class="hint">{{i18n.printerPairHint}}</view><view class="help-row"><view class="help-link" bindtap="onOpenPerm">⚙ {{i18n.appPerms}}</view><view class="help-link" bindtap="onPairHelp">📶 {{i18n.howToPair}}</view></view><scroll-view scroll-y class="body"><view class="empty" wx:if="{{!printers.length && !others.length && !scanning}}"><text class="empty-ico">📡</text><text class="empty-t">{{i18n.noDeviceFound}}</text><text class="empty-tip">{{i18n.noDeviceTip}}</text><view class="rescan" bindtap="onScan">{{i18n.rescan}}</view></view><view class="scanning" wx:elif="{{scanning && !printers.length && !others.length}}"><text class="empty-ico">📡</text><text class="empty-t">{{i18n.scanningDevices}}</text><text class="empty-tip">{{i18n.scanningTip}}</text></view><block wx:else><view class="sum-bar {{printers.length ? 'ok' : 'warn'}}"><text wx:if="{{printers.length}}">{{i18n.recognizedPrinters}} {{printers.length}} {{i18n.unitTai}} · {{deviceTotal}} {{i18n.foundDevices}}</text><text wx:else>{{i18n.noDeviceFound}} · {{deviceTotal}} {{i18n.foundDevices}}</text></view><view class="grp" wx:if="{{printers.length}}"><view class="grp-h"><text class="grp-t">{{i18n.recognizedPrinters}}</text><text class="grp-n">{{printers.length}} {{i18n.unitTai}}</text></view><view
          class="tile {{item.current ? 'on' : ''}} {{item.selected ? 'sel' : ''}}"
          wx:for="{{printers}}"
          wx:key="deviceId"
          data-id="{{item.deviceId}}"
          data-name="{{item.name}}"
          bindtap="onSelect"
        ><view class="tile-ico {{item.current ? 'cur' : 'prt'}}">🖨</view><view class="tile-main"><view class="tile-row"><text class="tile-name">{{item.name}}</text><text class="badge">{{i18n.printerBadge}}</text></view><text class="tile-id">{{item.deviceId}}</text></view><text class="tile-st on" wx:if="{{item.current}}">{{connectedMark}}</text><text class="tile-ck" wx:elif="{{item.selected}}">●</text></view></view><view class="grp" wx:if="{{others.length}}"><view class="grp-h"><text class="grp-t mute">{{i18n.otherBtDevices}}</text><text class="grp-n">{{others.length}} {{i18n.pickIfNeeded}}</text></view><view
          class="tile {{item.selected ? 'sel' : ''}}"
          wx:for="{{others}}"
          wx:key="deviceId"
          data-id="{{item.deviceId}}"
          data-name="{{item.name}}"
          bindtap="onSelect"
        ><view class="tile-ico oth">📶</view><view class="tile-main"><text class="tile-name mute">{{item.name}}</text><text class="tile-id">{{item.deviceId}}</text></view><text class="tile-ck" wx:if="{{item.selected}}">●</text></view></view></block></scroll-view><view class="foot"><view class="fbtn ghost {{connected && !testing ? '' : 'off'}}" bindtap="onTest">{{i18n.printTestPage}}</view><view class="fbtn primary {{connectEnabled ? '' : 'off'}}" bindtap="onConnectTap">{{connecting ? i18n.connecting : i18n.connectBtn}}</view></view><bluetooth-search-sheet id="btSheet" bind:reconnect="onSheetReconnect" /><canvas type="2d" id="testCanvas" class="off-canvas"></canvas></view>
