<view class="page lock"><view class="pin head"><view class="checks tabs"><text class="check {{tab === 'style' ? 'on' : ''}}" data-tab="style" bindtap="onTab">商品</text><text class="check {{tab === 'fabric' ? 'on' : ''}}" data-tab="fabric" bindtap="onTab">面料</text><text class="check {{tab === 'trim' ? 'on' : ''}}" data-tab="trim" bindtap="onTab">辅料</text></view><input class="find" placeholder="搜索" placeholder-class="ph" value="{{q}}" confirm-type="search" bindinput="onFind" /></view><scroll-view class="scroller" scroll-y bindscrolltolower="onMore" lower-threshold="120"><block wx:if="{{tab === 'style'}}"><view wx:if="{{loaded && !styles.length}}" class="empty">{{q ? '没有匹配的货号' : '我的商品里还没有货号'}}</view><view class="card" wx:for="{{styles}}" wx:key="productCode" bindtap="onStyle" data-code="{{item.productCode}}"><view class="style-top"><view class="style-id"><image wx:if="{{item.coverUrl}}" class="style-thumb" src="{{item.coverUrl}}" mode="aspectFill" data-code="{{item.productCode}}" data-full="{{item.coverFull}}" catchtap="onPreview" binderror="onCoverError" /><text class="title" wx:if="{{item.memberCodes.length <= 1}}">{{item.productCode}}</text></view><view class="quote" wx:if="{{item.priceAmount}}"><text class="quote-k">理论成本</text><text class="quote-v">¥{{item.priceAmount}}</text></view></view><view class="code-pack" wx:if="{{item.memberCodes.length > 1}}"><image class="link-mark" src="/assets/icons/pe-link.svg" mode="aspectFit" /><text class="code-chip" wx:for="{{item.memberCodes}}" wx:for-item="code" wx:key="*this">{{code}}</text></view><view class="parts" wx:if="{{item.parts.length}}"><text class="part {{part.kind}}" wx:for="{{item.parts}}" wx:for-item="part" wx:key="label">{{part.label}} ¥{{part.amount}}</text></view></view><view class="more-tip" wx:if="{{styleMore}}">上拉加载更多</view></block><block wx:elif="{{tab === 'fabric'}}"><view wx:if="{{loaded && !fabrics.length}}" class="empty">{{q ? '没有匹配的面料' : '还没有面料'}}</view><view class="card" wx:for="{{fabrics}}" wx:key="id" bindtap="onMaterial" data-id="{{item.id}}" data-kind="fabric"><text class="title">{{item.name}}</text><text class="sub">参考价 ¥{{item.refPrice}} / {{item.unit}}</text></view><view class="more-tip" wx:if="{{fabricMore}}">上拉加载更多</view></block><block wx:else><view wx:if="{{loaded && !trims.length}}" class="empty">{{q ? '没有匹配的辅料' : '还没有辅料'}}</view><view class="card" wx:for="{{trims}}" wx:key="id" bindtap="onMaterial" data-id="{{item.id}}" data-kind="trim"><text class="title">{{item.name}}</text><text class="sub">参考价 ¥{{item.refPrice}} / {{item.unit}}</text></view><view class="more-tip" wx:if="{{trimMore}}">上拉加载更多</view></block><view class="scroller-pad"></view></scroll-view><view class="dock" wx:if="{{tab === 'style'}}"><view class="dock-2"><view class="btn" bindtap="onAddStyle">增加商品</view><view class="btn line" bindtap="onManageProducts">管理商品</view></view></view><view class="dock" wx:elif="{{tab === 'fabric' || tab === 'trim'}}"><view class="btn" bindtap="onNewMaterial">{{tab === 'fabric' ? '新建面料' : '新建辅料'}}</view></view></view><view class="pop-mask" wx:if="{{styleOn}}" catchtouchmove="noop" bindtap="onCloseStyle"><view class="pop-sheet tall" catchtap="noop"><view class="pop-handle"></view><text class="pop-title">理论成本</text><scroll-view class="pop-body" scroll-y><style-form product-code="{{styleCode}}" bind:saved="onStyleSaved" bind:linked="onStyleLinked" /><view class="pop-pad"></view></scroll-view></view></view><view class="pop-mask" wx:if="{{materialOn}}" catchtouchmove="noop" bindtap="onCloseMaterial"><view class="pop-sheet tall" catchtap="noop"><view class="pop-handle"></view><text class="pop-title">{{materialKind === 'trim' ? '辅料' : '面料'}}</text><scroll-view class="pop-body" scroll-y><material-form material-id="{{materialId}}" kind="{{materialKind}}" bind:saved="onMaterialSaved" /><view class="pop-pad"></view></scroll-view></view></view>
