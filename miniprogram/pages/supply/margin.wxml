<view class="page lock"><scroll-view class="scroller" scroll-y bindscrolltolower="onMore" lower-threshold="120"><view wx:if="{{loaded && !items.length}}" class="empty">还没有验收批次，毛利先不算</view><view class="card" wx:for="{{items}}" wx:key="productCode"><text class="title">{{item.productCode}}</text><text class="sub">拿货 ¥{{item.salesAmount}} · 退货 ¥{{item.refundAmount}} · 发出 {{item.issuedQty}} 件</text><text class="amt">{{item.marginText}}</text><view class="jump-row"><text class="hint" data-to="style" data-code="{{item.productCode}}" bindtap="onJump">看商品</text><text class="hint" data-to="cost" data-code="{{item.productCode}}" bindtap="onJump">看成本</text><text class="hint" data-to="sales" data-code="{{item.productCode}}" bindtap="onJump">看销售</text></view></view><view class="more-tip" wx:if="{{more}}">上拉加载更多</view><view class="scroller-pad"></view></scroll-view></view>
