<view class="page {{rtl ? 'rtl' : ''}}"><view class="hero"><text class="hero-k">{{i18n.cloudSyncService}}</text><text class="hero-title">{{i18n.billingOrders}}</text><text class="hero-hint">{{i18n.billingHistoryHint}}</text></view><view class="login-banner" wx:if="{{!loggedIn}}" bindtap="onGoLogin" hover-stay-time="50"><text class="login-banner-t">{{i18n.billingNeedLogin}}</text><text class="login-banner-d">{{i18n.billingNeedLoginD}}</text><text class="login-banner-act">{{i18n.goLoginStay}}</text></view><view class="empty" wx:elif="{{loading}}"><text>{{i18n.loading}}</text></view><view class="empty" wx:elif="{{!orders.length}}"><view class="empty-ring"></view><text class="empty-t">{{i18n.noBillingOrders}}</text><view class="empty-btn" bindtap="goBuy" hover-stay-time="50">{{i18n.choosePlan}}</view></view><block wx:else><view class="sum"><view class="sum-item"><text class="sum-n">{{count}}</text><text class="sum-l">{{countLabel}}</text></view><view class="sum-div"></view><view class="sum-item"><text class="sum-n">{{totalLabel}}</text><text class="sum-l">{{i18n.billingTotal}}</text></view></view><view
      class="ticket"
      wx:for="{{orders}}"
      wx:key="orderId"
      data-id="{{item.orderId}}"
      bindlongpress="onCopy"
    ><view class="ticket-band"></view><view class="ticket-body"><view class="ticket-top"><text class="ticket-plan">{{item.planTitle}}</text><text class="ticket-ok">{{item.statusLabel}}</text></view><view class="ticket-amt-row"><text class="ticket-yen">¥</text><text class="ticket-amt">{{item.priceNum}}</text></view><view class="ticket-foot"><text>{{item.dateLabel}}</text><text class="dot">·</text><text>{{item.daysLabel}}</text></view><text class="ticket-copy">{{i18n.billingLongPress}}</text></view></view></block></view>
