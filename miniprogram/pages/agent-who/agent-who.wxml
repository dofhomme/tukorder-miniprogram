<view class="page {{rtl ? 'rtl' : ''}}"><text class="hint">{{i18n.whoHasHint}}</text><text class="q" wx:if="{{q}}">{{q}}</text><view wx:if="{{loading}}" class="state">{{i18n.loading}}</view><view wx:elif="{{!hits.length}}" class="state">{{i18n.whoHasEmpty}}</view><view class="list" wx:else><view class="row {{item.current ? 'on' : ''}}" wx:for="{{hits}}" wx:key="ownerUserId" data-id="{{item.ownerUserId}}" data-code="{{item.code}}" bindtap="onOpen"><image class="cover" src="{{item.coverUrl}}" mode="aspectFill" wx:if="{{item.coverUrl}}" /><view class="cover ph" wx:else>{{item.code}}</view><view class="main"><text class="shop">{{item.shopName}}</text><text class="name">{{item.name || item.code}}</text><text class="meta">¥{{item.priceLabel}} · {{item.stockLabel}}</text></view><text class="go">{{i18n.whoHasGo}}</text></view></view></view>
