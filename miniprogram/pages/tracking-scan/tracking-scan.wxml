<view class="page {{rtl ? 'rtl' : ''}}"><view class="toolbar"><text class="count">{{i18n.scannedCount}} {{list.length}} {{i18n.trackingUnit}}</text><view class="add-btn" bindtap="onManualAdd" hover-stay-time="50" hover-start-time="0"><text class="add-ico">＋</text><text>{{i18n.addManual}}</text></view></view><scroll-view class="list" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{list.length}}"><view class="card" wx:for="{{list}}" wx:key="no"><view class="badge" style="color: {{item.color}}; border-color: {{item.border}}; background: {{item.bg}};"><text>{{item.courier}}</text></view><view class="meta" bindtap="onCopy" data-no="{{item.no}}" hover-stay-time="50" hover-start-time="0"><text class="no">{{item.no}}</text><text class="sub">{{item.courier}} · {{i18n.tapCopyTracking}}</text></view><view class="del" data-no="{{item.no}}" catchtap="onRemove" hover-stay-time="50" hover-start-time="0">✕</view></view><view class="list-pad"></view></scroll-view><view class="empty" wx:else><view class="empty-scan" bindtap="onScan" hover-class="tap-hover" hover-stay-time="50" hover-start-time="0"><text class="empty-scan-ico">▦</text><text class="empty-scan-t">{{i18n.scanTrackingHint}}</text></view><text class="empty-hint">{{i18n.emptyHintManual}}</text></view><view class="footer"><view class="scan-bar" wx:if="{{list.length}}" bindtap="onScan" hover-class="tap-hover" hover-stay-time="50" hover-start-time="0"><text class="scan-bar-ico">▦</text><text>{{i18n.continueScan}}</text></view><view class="done" bindtap="onDone" hover-stay-time="50" hover-start-time="0"><text>{{i18n.doneWithCount}}（{{list.length}} {{i18n.trackingUnit}}）</text></view></view><view class="mask" wx:if="{{showDlg}}" catchtouchmove="noop" bindtap="onDlgCancel" hover-stay-time="50" hover-start-time="0"><view class="dlg" catchtap="noop" hover-stay-time="50" hover-start-time="0"><text class="dlg-title">{{i18n.trackingNo}}</text><view class="dlg-input-wrap"><text class="dlg-prefix" bindtap="onScan">▦</text><input
          class="dlg-input"
          focus="{{showDlg}}"
          value="{{dlgValue}}"
          placeholder="{{i18n.scanOrTypeTracking}}"
          placeholder-class="dlg-ph"
          maxlength="64"
          bindinput="onDlgInput"
          confirm-type="done"
          bindconfirm="onDlgConfirm"
        /></view><view class="dlg-acts"><view class="dlg-btn" bindtap="onDlgCancel" hover-stay-time="50" hover-start-time="0"><text>{{i18n.cancel}}</text></view><view class="dlg-btn filled" bindtap="onDlgConfirm" hover-stay-time="50" hover-start-time="0"><text>{{i18n.confirm}}</text></view></view></view></view></view>
