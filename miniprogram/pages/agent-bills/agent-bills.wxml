<view class="page {{rtl ? 'rtl' : ''}}"><view wx:if="{{loading && !bound}}" class="state">{{i18n.loading}}</view><view wx:elif="{{error && !bound}}" class="state-wrap"><text class="state">{{error}}</text><view class="btn ghost" bindtap="refresh">{{i18n.retry}}</view></view><view wx:elif="{{!bound}}" class="state-wrap"><text class="title">{{i18n.agentOnlyView}}</text><text class="hint">{{i18n.agentOnlyHint}}</text><view class="btn" bindtap="onOpenPlaza">{{i18n.plazaTitle}}</view></view><view wx:else class="wrap {{merchantExpired || booksClosed ? 'is-expired' : ''}}"><view class="hero"><text class="shop">{{shopName}}</text><view class="who-row"><text class="who-name">{{customerName}}</text></view><text class="phone-sub" wx:if="{{phone}}">{{phone}}</text><text class="phone-sub muted" wx:else>{{i18n.phoneEmptyHint}}</text><view class="debt"><text class="debt-k">{{i18n.unpaidAmount}}</text><text class="debt-v">¥{{unpaidAmount}}</text></view></view><view class="agent-expire" wx:if="{{merchantExpired}}"><text class="agent-expire-t">{{i18n.merchantExpiredTitle}}</text><text class="agent-expire-s">{{i18n.merchantExpiredHint}}</text><button class="agent-expire-btn" open-type="share" data-shop="{{expireShop}}">{{i18n.merchantRenewForward}}</button></view><view class="agent-expire" wx:elif="{{booksClosed}}"><text class="agent-expire-t">{{i18n.merchantAccountClosed}}</text><text class="agent-expire-s">{{i18n.merchantAccountClosedHint}}</text></view><view class="sec-head"><text class="sec-t">{{i18n.billRecords}}</text><text class="sec-link" wx:if="{{canSwitch}}" bindtap="onSwitchShop">{{i18n.switchShop}}</text></view><view class="range-bar"><text class="range-k">{{i18n.billDateRange}}</text><picker mode="date" value="{{dateFrom}}" bindchange="onDateFrom"><view class="range-pick">{{dateFrom}}</view></picker><text class="range-sep">—</text><picker mode="date" value="{{dateTo}}" bindchange="onDateTo"><view class="range-pick">{{dateTo}}</view></picker></view><view class="sum-bar"><view class="sum-item {{listMode === 'sales' ? 'on' : ''}}" bindtap="onFilterSales" hover-class="sum-item-hover"><text class="sum-k">{{i18n.billOrderCount}}</text><text class="sum-v">{{summaryOrderCount}}</text></view><view class="sum-item {{listMode === 'returns' ? 'on' : ''}}" bindtap="onFilterReturns" hover-class="sum-item-hover"><text class="sum-k">{{i18n.billReturnCount}}</text><text class="sum-v">{{summaryReturnCount}}</text></view><view class="sum-item"><text class="sum-k">{{i18n.billSalesAmount}}</text><text class="sum-v">¥{{summarySales}}</text></view><view class="sum-item"><text class="sum-k">{{i18n.billRefundAmount}}</text><text class="sum-v">¥{{summaryRefund}}</text></view></view><view class="ack-bar"><text class="ack-t" wx:if="{{ackAt}}">{{i18n.ackedAt}} {{ackAt}}</text><text class="ack-t" wx:else>{{i18n.ackThisRange}}</text><view class="btn slim {{acking ? 'off' : ''}}" bindtap="onAckRange">{{i18n.ackThisRange}}</view></view><view class="list-hint" wx:if="{{listMode === 'sales'}}">{{i18n.billHintSales}}</view><view class="list-hint" wx:elif="{{listMode === 'returns'}}">{{i18n.billHintReturns}}</view><view class="refresh-tip" wx:if="{{loading}}">{{i18n.loading}}</view><view class="empty" wx:elif="{{!pageRows.length}}">{{listMode === 'returns' ? i18n.billNoReturns : listMode === 'sales' ? i18n.billNoSales : i18n.billNoRecords}}</view><view class="list" wx:else><view
        class="row"
        wx:for="{{pageRows}}"
        wx:key="orderNo"
        data-token="{{item.token}}"
        bindtap="onOpenOrder"
        hover-class="row-on"
      ><view class="row-main"><text class="row-no">{{item.orderNo}}</text><text class="row-date">{{item.dateLabel}}</text></view><view class="row-side"><text class="row-amt {{item.amountNeg ? 'neg' : ''}}">{{item.amountNeg ? '-' : ''}}¥{{item.amountLabel}}</text><text class="row-flag">{{item.flagLabel}}</text></view></view></view><view class="pager" wx:if="{{totalCount > 0}}"><text class="pager-info">{{pageInfo}}</text><view class="pager-acts"><view class="pager-btn {{page <= 1 ? 'off' : ''}}" bindtap="onPrevPage">{{i18n.prevPage}}</view><view class="pager-btn {{page >= pageCount ? 'off' : ''}}" bindtap="onNextPage">{{i18n.nextPage}}</view></view></view><text class="hint" wx:if="{{error}}">{{error}}</text></view></view>
