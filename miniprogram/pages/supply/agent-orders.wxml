<view class="page lock"><scroll-view class="scroller" scroll-y bindscrolltolower="onMore" lower-threshold="120"><view class="card order-card {{picked[item.id] ? 'on' : ''}}" wx:for="{{items}}" wx:key="id" bindtap="onPick" data-id="{{item.id}}"><view class="order-line"><view class="tick-box {{picked[item.id] ? 'on' : ''}}" wx:if="{{!item.isPaid && !item.isReturn}}"><view class="tick" wx:if="{{picked[item.id]}}"></view></view><view class="order-main"><text class="title">{{item.orderNo}}</text><text class="sub">¥{{item.amount}} · {{item.createdAt}}</text></view><text wx:if="{{item.isReturn && !item.isPaid}}" class="pay" catchtap="onRefund" data-id="{{item.id}}">未退</text><text wx:else class="pay {{item.isPaid ? 'on' : ''}}">{{item.isReturn ? '已退款' : (item.isPaid ? '已收' : '未收')}}</text></view></view><view class="more-tip" wx:if="{{more}}">上拉加载更多</view><view class="scroller-pad"></view></scroll-view><view class="dock"><view class="btn" bindtap="onPaid">把勾选的销售单记成已收</view></view></view>
