<view class="page {{rtl ? 'rtl' : ''}}"><view class="tabs"><scroll-view scroll-x class="tabs-scroll" enhanced show-scrollbar="{{false}}"><view
        class="tab {{tab===item.key?'on':''}}"
        wx:for="{{tabList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTab"
       hover-stay-time="50" hover-start-time="0">{{item.label}} ({{item.count}})</view></scroll-view><view wx:if="{{canPurge}}" class="empty-trash" bindtap="onEmpty" hover-stay-time="50" hover-start-time="0">{{i18n.emptyBin}}</view></view><view wx:if="{{loading}}" class="empty">{{i18n.loading}}</view><scroll-view scroll-y class="body" wx:else><block wx:if="{{tab==='order'}}"><view class="row" wx:for="{{orders}}" wx:key="orderNo"><view class="main"><text class="title">{{i18n.labelOrderNo}} {{item.orderNo}}</text><text class="sub">{{item.customerName || ''}} · ¥{{item.amountLabel}} · {{item.timeLabel}}</text></view><view class="acts"><text class="act" data-no="{{item.orderNo}}" bindtap="onRestoreOrder" hover-stay-time="50" hover-start-time="0">{{i18n.restore}}</text><text wx:if="{{canPurge}}" class="act danger" data-no="{{item.orderNo}}" bindtap="onPurgeOrder" hover-stay-time="50" hover-start-time="0">{{i18n.delete}}</text></view></view><view wx:if="{{!orders.length}}" class="empty">{{i18n.emptyDeletedOrders}}</view></block><block wx:elif="{{tab==='product'}}"><view class="row" wx:for="{{products}}" wx:key="code"><view class="main"><text class="title">{{item.name || item.code}}</text><text class="sub">{{i18n.colCode}} {{item.code}} · ¥{{item.priceLabel}}</text></view><view class="acts"><text class="act" data-code="{{item.code}}" bindtap="onRestoreProduct" hover-stay-time="50" hover-start-time="0">{{i18n.restore}}</text><text wx:if="{{canPurge}}" class="act danger" data-code="{{item.code}}" bindtap="onPurgeProduct" hover-stay-time="50" hover-start-time="0">{{i18n.delete}}</text></view></view><view wx:if="{{!products.length}}" class="empty">{{i18n.emptyDeletedProducts}}</view></block><block wx:elif="{{tab==='category'}}"><view class="row" wx:for="{{categories}}" wx:key="name"><view class="main"><text class="title">{{item.name}}</text></view><view class="acts"><text class="act" data-name="{{item.name}}" bindtap="onRestoreCategory" hover-stay-time="50" hover-start-time="0">{{i18n.restore}}</text><text wx:if="{{canPurge}}" class="act danger" data-name="{{item.name}}" bindtap="onPurgeCategory" hover-stay-time="50" hover-start-time="0">{{i18n.delete}}</text></view></view><view wx:if="{{!categories.length}}" class="empty">{{i18n.emptyDeletedCats}}</view></block><block wx:elif="{{tab==='customer'}}"><view class="row" wx:for="{{customers}}" wx:key="id"><view class="main"><text class="title">{{item.name}}</text><text class="sub">{{item.phone || i18n.noneYet}}</text></view><view class="acts"><text class="act" data-id="{{item.id}}" bindtap="onRestoreCustomer" hover-stay-time="50" hover-start-time="0">{{i18n.restore}}</text><text wx:if="{{canPurge}}" class="act danger" data-id="{{item.id}}" bindtap="onPurgeCustomer" hover-stay-time="50" hover-start-time="0">{{i18n.delete}}</text></view></view><view wx:if="{{!customers.length}}" class="empty">{{i18n.emptyDeletedCustomers}}</view></block><block wx:elif="{{tab==='return'}}"><view class="row" wx:for="{{returns}}" wx:key="cloudUid"><view class="main"><text class="title">{{item.carrier || ''}} {{item.trackingNo}}</text><text class="sub">{{item.remark || i18n.returns}}</text></view><view class="acts"><text class="act" data-uid="{{item.cloudUid}}" bindtap="onRestoreReturn" hover-stay-time="50" hover-start-time="0">{{i18n.restore}}</text><text wx:if="{{canPurge}}" class="act danger" data-uid="{{item.cloudUid}}" bindtap="onPurgeReturn" hover-stay-time="50" hover-start-time="0">{{i18n.delete}}</text></view></view><view wx:if="{{!returns.length}}" class="empty">{{i18n.emptyDeletedReturns}}</view></block></scroll-view></view>
