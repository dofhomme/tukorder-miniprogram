.page{min-height:100vh;background:#f5f6f8;padding:20rpx 24rpx 48rpx;box-sizing:border-box}
.trial{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}
.trial-d{display:block;margin-top:8rpx;font-size:24rpx;color:#757575;line-height:1.45}
.trial-row{display:flex;align-items:center;margin-top:16rpx}
.trial-in{width:160rpx;height:72rpx;padding:0 16rpx;border:2rpx solid #cfd8dc;border-radius:12rpx;font-size:30rpx;box-sizing:border-box}
.trial-unit{margin-left:12rpx;font-size:28rpx;color:#424242}
.meta{font-size:26rpx;color:#757575;margin-bottom:16rpx}
.loading,.empty{padding:120rpx 0;text-align:center;color:#9e9e9e}
.row{display:flex;background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}
.main{flex:1;min-width:0}
.top{display:flex;align-items:center;gap:12rpx;margin-bottom:8rpx}
.phone{font-size:32rpx;font-weight:700;color:#212121}
.tag{font-size:20rpx;padding:2rpx 10rpx;border-radius:6rpx;background:#eceff1;color:#546e7a}
.tag.me{background:#e3f2fd;color:#1e4d8c}
.line{display:block;font-size:24rpx;color:#757575;margin-top:4rpx;word-break:break-all}
.side{display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;margin-left:12rpx;flex-shrink:0}
.trial-open{min-width:120rpx;padding:10rpx 16rpx;text-align:center;font-size:24rpx;font-weight:600;color:#1e4d8c;background:#e8f0fa;border-radius:10rpx}
.trial-open.paid{color:#2e7d32;background:#e8f5e9}
.more{width:56rpx;text-align:center;font-size:40rpx;color:#9e9e9e;font-weight:700}
.menu-mask{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.2)}
.menu-sheet{position:absolute;right:32rpx;top:30%;background:#fff;border-radius:12rpx;min-width:220rpx;box-shadow:0 8rpx 28rpx rgba(0,0,0,.18);overflow:hidden}
.mi{padding:28rpx 36rpx;font-size:28rpx;border-bottom:1rpx solid #f0f0f0}
.mi.danger{color:#e53935;border-bottom:none}
.dlg-mask{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}
.dlg{width:100%;max-width:620rpx;background:#fff;border-radius:20rpx;padding:32rpx 28rpx;box-sizing:border-box}
.dlg-t{display:block;text-align:center;font-size:32rpx;font-weight:700;margin-bottom:24rpx}
.dlg-in{height:80rpx;padding:0 20rpx;border:2rpx solid #cfd8dc;border-radius:12rpx;margin-bottom:16rpx;font-size:28rpx;box-sizing:border-box}
.dlg-actions{display:flex;gap:16rpx;margin-top:12rpx}
.btn{flex:1;height:80rpx;line-height:80rpx;text-align:center;border-radius:12rpx;font-size:28rpx;font-weight:600}
.btn.ghost{color:#1e4d8c}
.btn.ok{background:#1e4d8c;color:#fff}
