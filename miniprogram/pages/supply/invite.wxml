<view class="page"><block wx:if="{{id}}"><view class="card" wx:if="{{item}}"><text class="title">{{item.productCode}}</text><text class="sub">{{item.statusText}} · 到期 {{item.expiresAt}}</text><text class="sub" wx:if="{{token}}">口令已复制，发给加工厂。对方打开本小程序的「填裁剪」粘贴。口令只显示这一次。</text><text class="hint" wx:if="{{token}}" bindtap="onCopy">再复制口令</text><button wx:if="{{token}}" class="btn" open-type="share">发给加工厂</button></view><view class="field"><text class="label">核对行：每行「尺码 件数」，保存后按本店核对归档</text><textarea class="input" placeholder="例如：M 20" placeholder-class="ph" value="{{qtyText}}" bindinput="onQty" auto-height="{{true}}" /></view><view class="btn" bindtap="onSaveLines"><image class="btn-ico" src="/assets/icons/pe-save.svg" mode="aspectFit" /><text>保存核对</text></view><view class="btn" bindtap="onRecognize">识别照片</view><view class="btn" bindtap="onArchive">归档成裁剪单</view><view class="btn" bindtap="onRevoke">作废链接</view></block><block wx:else><view class="field"><text class="label">来料批次</text><view wx:if="{{!batches.length && !chosenLabel}}" class="input">没有未验收的面料</view><view wx:for="{{batches}}" wx:key="docId" class="input pick {{chosenDocId === item.docId ? 'on' : ''}}" data-id="{{item.docId}}" bindtap="onBatch">{{item.label}}</view></view><view class="field"><text class="label">有效小时（1 到 168）</text><input class="input" type="number" placeholder="24" placeholder-class="ph" value="{{hours}}" bindinput="onHours" /></view><view class="btn" bindtap="onCreate">生成邀请</view><view class="card" wx:for="{{invites}}" wx:key="id" bindtap="onOpen" data-id="{{item.id}}"><text class="title">{{item.productCode}}</text><text class="sub">{{item.statusText}}</text></view></block></view>
