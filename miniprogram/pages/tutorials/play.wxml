<view class="page" style="height: {{pageH}}px;"><view class="stage"><video
      wx:if="{{videoUrl}}"
      id="lessonVideo"
      class="player"
      style="width: {{playerW}}px; height: {{playerH}}px;"
      src="{{videoUrl}}"
      title="{{title}}"
      controls="{{full}}"
      object-fit="contain"
      show-center-play-btn
      show-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      show-progress="{{false}}"
      show-bottom-progress="{{false}}"
      show-background-playback-button="{{false}}"
      enable-progress-gesture="{{false}}"
      enable-play-gesture
      bindplay="onPlay"
      bindpause="onPause"
      bindended="onEnded"
      bindtimeupdate="onTime"
      bindloadedmetadata="onMeta"
      bindfullscreenchange="onFull"
      binderror="onVideoError"
    /><view class="soon" wx:else style="height: {{playerH}}px;"><view class="soon-play"><view class="soon-mark"></view></view><text class="soon-t">{{i18n.tutorialSoon}}</text></view></view><view class="bar" wx:if="{{videoUrl}}"><view class="play" bindtap="onToggle" hover-stay-time="50">{{playing ? '暂停' : '播放'}}</view><slider
      class="seek"
      min="0"
      max="{{durationMax}}"
      step="1"
      value="{{current}}"
      activeColor="#1E4D8C"
      backgroundColor="#D5DEE8"
      block-size="16"
      bindchanging="onSeeking"
      bindchange="onSeek"
    /><text class="time">{{timeText}}</text><view class="full" bindtap="onFullTap" hover-stay-time="50">全屏</view></view><text class="title">{{title}}</text></view>
