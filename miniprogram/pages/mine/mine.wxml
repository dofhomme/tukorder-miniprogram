      wx:elif="{{!agentMode && !cloudSyncActive}}"
      bindtap="goSubscription"
      hover-stay-time="50"
    ><text class="guest-banner-t">{{i18n.openCloud}} · {{cloudSyncLabel}}</text><text class="guest-banner-d">{{pendingUpload ? i18n.pendingUploadHint + ' · ' : ''}}{{i18n.cloudShareHint}}</text></view><view
      class="guest-banner guest-banner-ok"
      wx:elif="{{pendingUpload}}"
      bindtap="goSubscription"
      hover-stay-time="50"
    ><text class="guest-banner-t">{{i18n.cloudPending}}</text><text class="guest-banner-d">{{i18n.tapUpload}} · {{cloudSyncLabel}}</text></view><view class="menu-card" wx:if="{{!agentMode}}"><view class="menu-item" wx:if="{{!guestMode}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onPickLanguage" hover-start-time="0"><view class="ico i-lang"><image class="ico-img" src="/assets/mine-icons/i-lang.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.language}}</text><text class="menu-sub">{{locale === 'ug' ? i18n.langUg : i18n.langZh}}</text></view><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="goSubscription" hover-start-time="0"><view class="ico i-sync"><image class="ico-img" src="/assets/mine-icons/i-sync.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.subTitle}}</text><text class="menu-sub">{{cloudSyncActive ? cloudSyncLabel : i18n.subPrice}}</text></view><text class="chev">›</text></view><view class="menu-item" wx:if="{{showAgentBills}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/agent-bills/agent-bills" hover-start-time="0"><view class="ico i-bills"><image class="ico-img" src="/assets/mine-icons/i-bills.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.myBills}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/customers/customers" hover-start-time="0"><view class="ico i-customers"><image class="ico-img" src="/assets/mine-icons/i-customers.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.customers}}</text><text class="chev">›</text></view><view class="menu-item" wx:if="{{canManageTeam && !agentMode}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/agent-applies/agent-applies" hover-start-time="0"><view class="ico i-agent-apply"><image class="ico-img" src="/assets/mine-icons/i-agent-apply.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.agentApplies}}</text><text class="chev">›</text></view><view
        class="menu-item" hover-class="menu-item-hover" hover-stay-time="60"
        wx:if="{{canManageReturnPackage}}"
        bindtap="go"
        data-url="/pages/returns/returns"
        hover-start-time="0"
      ><view class="ico i-returnpkg"><image class="ico-img" src="/assets/mine-icons/i-returnpkg.svg" mode="aspectFit" /></view><view class="menu-meta"><text class="menu-title">{{i18n.returns}}</text><text class="menu-sub">{{i18n.returnsSub}}</text></view><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onPrintSettings" hover-start-time="0"><view class="ico i-print"><image class="ico-img" src="/assets/mine-icons/i-print.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.printSettings}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/recycle-bin/recycle-bin" hover-start-time="0"><view class="ico i-recycle"><image class="ico-img" src="/assets/mine-icons/i-recycle.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.recycle}}</text><text class="chev">›</text></view><view class="menu-item {{tutorialsOn ? '' : 'off'}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onTutorials" hover-start-time="0"><view class="ico i-rules"><image class="ico-img" src="/assets/mine-icons/i-rules.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.tutorials}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onSupport" hover-start-time="0"><view class="ico i-support"><image class="ico-img" src="/assets/mine-icons/i-support.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.support}}</text><text class="chev">›</text></view><view wx:if="{{!guestMode}}" class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onInviteHub" hover-start-time="0"><view class="ico i-invite"><image class="ico-img" src="/assets/mine-icons/i-invite.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.inviteHub}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onFollow" hover-start-time="0"><view class="ico i-follow"><image class="ico-img" src="/assets/mine-icons/i-follow.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.followUs}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onClearCache" hover-start-time="0"><view class="ico i-clear"><image class="ico-img" src="/assets/mine-icons/i-clear.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.clearCache}}</text><text class="chev">›</text></view></view><view class="menu-card admin" wx:if="{{isAdmin}}"><text class="admin-title">{{i18n.admin}}</text><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/admin-users/admin-users" hover-start-time="0"><view class="ico i-admin-users"><image class="ico-img" src="/assets/mine-icons/i-admin-users.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.adminUsers}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/admin-feedback/admin-feedback" hover-start-time="0"><view class="ico i-feedback"><image class="ico-img" src="/assets/mine-icons/i-feedback.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.adminFeedback}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/admin-print-policy/admin-print-policy" hover-start-time="0"><view class="ico i-print-channel"><image class="ico-img" src="/assets/mine-icons/i-print-channel.svg" mode="aspectFit" /></view><text class="menu-title">{{i18n.adminPrintPolicy}}</text><text class="chev">›</text></view><view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="go" data-url="/pages/admin-voice/admin-voice" hover-start-time="0"><view class="ico i-voice"><image class="ico-img" src="/assets/mine-icons/i-voice.svg" mode="aspectFit" /></view><text class="menu-title">语音识别</text><text class="chev">›</text></view></view><button class="logout" bindtap="onLogout" hover-class="logout-hover" hover-stay-time="80">{{agentMode ? i18n.logoutAgent : (guestMode ? i18n.logoutGuest : i18n.logout)}}</button><view class="legal-row"><text class="legal-link" bindtap="onOpenLegal" data-type="privacy" hover-stay-time="50" hover-start-time="0">{{i18n.privacy}}</text><text class="legal-dot">·</text><text class="legal-link" bindtap="onOpenLegal" data-type="disclaimer" hover-stay-time="50" hover-start-time="0">{{i18n.disclaimer}}</text></view><text class="footer-tip">{{i18n.saasFooter}}</text><text class="footer-ver" bindtap="onCheckUpdate">{{versionLabel}}</text></scroll-view></view><view class="kf-fab-wrap"><button
      class="kf-fab"
      open-type="contact"
      session-from="mine"
      show-message-card="{{false}}"
      hover-class="none"
    ><image class="kf-fab-ico" src="{{media.url('kf-fab.png')}}" mode="aspectFit" /><text class="kf-fab-txt">{{i18n.contactKf}}</text></button></view><view class="sup-mask" wx:if="{{showSupDlg}}" catchtouchmove="noop"><view class="sup-dlg" catchtap="noop" hover-stay-time="50" hover-start-time="0"><text class="sup-title">{{i18n.supTitle}}</text><text class="sup-hint">{{i18n.supHint}}</text><view class="sup-wx"><text class="sup-wx-title">{{i18n.supWechatTitle}}</text><image class="sup-wx-qr" src="{{media.url('support-qr.png')}}" mode="aspectFit" show-menu-by-longpress="{{true}}" /><text class="sup-wx-id" bindtap="onCopySupportWechat">{{i18n.supWechatId}}</text></view><textarea
        class="sup-area"
        placeholder="{{i18n.supPlaceholder}}"
        maxlength="1000"
        value="{{supText}}"
        bindinput="onSupInput"
        show-confirm-bar="{{false}}"
        adjust-keyboard-to="bottom"
      /><text class="sup-count">{{supLen}} / 1000</text><view class="sup-actions"><view class="sup-btn cancel {{supSaving?'off':''}}" bindtap="onSupCancel" hover-stay-time="50" hover-start-time="0">{{i18n.cancel}}</view><view class="sup-btn ok {{supSaving?'off':''}}" bindtap="onSupSubmit" hover-stay-time="50" hover-start-time="0">
          {{supSaving ? i18n.sending : i18n.sendMsg}}
        </view></view></view></view><view class="inv-mask" wx:if="{{inviteSheet}}" catchtouchmove="noop" bindtap="onInviteSheetClose"><view class="inv-sheet" catchtap="noop"><view class="inv-handle"></view><text class="inv-title">{{i18n.inviteHub}}</text><button class="inv-row" open-type="share" data-kind="merchantOpen" hover-class="inv-row-hover"><text>{{i18n.inviteMerchantOpen}}</text></button><button wx:if="{{!agentMode}}" class="inv-row" open-type="share" data-kind="inviteAgent" hover-class="inv-row-hover"><text>{{i18n.inviteAgent}}</text></button><view class="inv-row" bindtap="onInviteRules" hover-class="inv-row-hover" hover-stay-time="60"><text>{{i18n.inviteMerchantRules}}</text></view><view class="inv-cancel" bindtap="onInviteSheetClose">{{i18n.cancel}}</view></view></view><view class="sup-mask" wx:if="{{showFollow}}" catchtouchmove="noop"><view class="sup-dlg follow-dlg" catchtap="noop"><text class="sup-title">{{i18n.followTitle}}</text><image class="follow-qr" src="{{media.url('follow-wechat.jpg')}}" mode="aspectFit" show-menu-by-longpress="{{true}}" /><text class="sup-hint follow-hint">{{i18n.followHint}}</text><view class="sup-btn ok follow-close" bindtap="onFollowClose">关闭</view></view></view><view class="clr-mask" wx:if="{{showClrDlg}}" catchtouchmove="noop"><view class="clr-dlg" catchtap="noop" hover-stay-time="50" hover-start-time="0"><text class="clr-title">{{i18n.clrTitle}}</text><text class="clr-body" wx:if="{{guestMode}}">{{i18n.clrBodyGuest}}</text><text class="clr-body" wx:else>{{i18n.clrBodyUser}}</text><view class="clr-actions"><view class="clr-btn ghost" bindtap="onClrCancel" hover-stay-time="50" hover-start-time="0">{{i18n.cancel}}</view><view class="clr-btn warn" bindtap="onClrConfirm" hover-stay-time="50" hover-start-time="0">{{guestMode ? i18n.clrConfirm : i18n.clrConfirmSync}}</view></view></view></view></view>
