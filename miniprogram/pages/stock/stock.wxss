.page{padding:24rpx}
.bar{display:flex;justify-content:space-between;margin-bottom:16rpx}
.title{font-weight:700;font-size:30rpx}
.link{color:#2b6cb0}
.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:12rpx}
.top{display:flex;justify-content:space-between}
.code{font-weight:700}
.type{color:#2b6cb0;font-size:24rpx}
.name{display:block;margin-top:6rpx;color:#4a5568;font-size:26rpx}
.meta{display:block;margin-top:6rpx;font-size:24rpx;color:#718096}
.meta.muted{color:#a0aec0}
.empty{padding:80rpx;text-align:center;color:#a0aec0}
