.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
  background: #eef3f9;
}
.page-dock {
  padding-bottom: 220rpx;
}

.status {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.status-main {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2b3c;
  line-height: 1.3;
}
.status-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #7a8b9c;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 28rpx 12rpx;
  margin-bottom: 28rpx;
}
.card-title {
  display: block;
  padding: 20rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #3a4a5a;
}
.perk {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2f6;
}
.perk-mark {
  flex: none;
  width: 36rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #2e6bb5;
  font-weight: 700;
}
.perk-t {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.45;
  color: #1a2b3c;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #3a4a5a;
  margin: 4rpx 4rpx 16rpx;
}
.plan-group {
  margin-bottom: 24rpx;
}
.plan-group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 4rpx 12rpx;
}
.plan-group-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2b3c;
}
.plan-group-seat {
  font-size: 22rpx;
  color: #7a8b9c;
}
.plans {
  display: flex;
  gap: 20rpx;
}
.plan {
  position: relative;
  flex: 1;
  min-width: 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 20rpx 22rpx;
  border: 2rpx solid #e3ebf4;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(22, 58, 107, 0.05);
  overflow: hidden;
}
.plan-on {
  border-color: #1e4d8c;
  background: #f4f8fd;
  box-shadow: 0 12rpx 28rpx rgba(30, 77, 140, 0.14);
}
.plan-ribbon {
  position: absolute;
  top: 0;
  right: 0;
  padding: 8rpx 16rpx 10rpx;
  border-bottom-left-radius: 16rpx;
  background: #1e4d8c;
  color: #fff;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
}
.plan-name {
  display: block;
  font-size: 26rpx;
  color: #5b7390;
  font-weight: 600;
}
.plan-price {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
  color: #163a6b;
}
.plan-yen {
  margin-right: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.plan-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
}
.plan-meta {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #6b7c93;
  line-height: 1.3;
}
.plan-day {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #2e6bb5;
  line-height: 1.3;
}
.plan-pick {
  display: block;
  margin-top: 18rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #5b7390;
  background: #f3f6fa;
}
.plan-on .plan-pick {
  color: #fff;
  background: #1e4d8c;
}

.history-link {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}
.history-link-hover {
  background: #f7fbff;
}
.history-link-copy {
  flex: 1;
  min-width: 0;
}
.history-link-t {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2b3c;
}
.history-link-d {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #7a8b9c;
}
.history-link-go {
  margin-left: 16rpx;
  font-size: 40rpx;
  color: #b7c4d2;
  line-height: 1;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(238, 243, 249, 0.96);
  box-sizing: border-box;
}
.btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.btn.primary {
  background: #2e6bb5;
  color: #fff;
}
.btn.ghost {
  margin-top: 16rpx;
  background: #fff;
  color: #2e6bb5;
  border: 2rpx solid rgba(46, 107, 181, 0.35);
}
.btn-disabled {
  opacity: 0.55;
}

.login-banner {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.login-banner-t {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2b3c;
}
.login-banner-d {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5a6b7d;
}
.login-banner .btn {
  margin-top: 24rpx;
}
