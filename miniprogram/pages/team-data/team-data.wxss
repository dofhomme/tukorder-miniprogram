.page{min-height:100vh;background:#f5f6f8;padding:24rpx;box-sizing:border-box;padding-bottom:48rpx}
.card{background:#fff;border-radius:16rpx;padding:28rpx 24rpx;margin-bottom:20rpx}
.account .phone{display:block;font-size:36rpx;font-weight:700;color:#212121}
.account .role{display:block;margin-top:10rpx;font-size:28rpx;color:#616161}
.account .shop{display:block;margin-top:8rpx;font-size:26rpx;color:#757575}
.sec{display:block;margin:8rpx 8rpx 12rpx;font-size:28rpx;font-weight:700;color:#424242}
.sub{display:block;margin:-4rpx 8rpx 12rpx;font-size:22rpx;color:#9e9e9e}
.stats{display:flex;gap:16rpx;margin-bottom:24rpx}
.stat{flex:1;background:#fff;border-radius:16rpx;padding:24rpx 8rpx;text-align:center}
.stat .ico{display:block;font-size:32rpx;margin-bottom:8rpx}
.stat .n{display:block;font-size:40rpx;font-weight:700;color:#212121}
.stat .l{display:block;margin-top:6rpx;font-size:22rpx;color:#757575}
.pending .prow{display:flex;justify-content:space-between;align-items:center;padding:14rpx 0}
.pl{font-size:28rpx;color:#333}
.pc{font-size:32rpx;font-weight:600;color:#757575}
.pc.warn{color:#e53935}
.aligned{display:block;margin-top:12rpx;text-align:center;font-size:22rpx;color:#9e9e9e}
.actions .act{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #f0f0f0}
.actions .act:last-child{border-bottom:none}
.act-ico{width:56rpx;text-align:center;font-size:28rpx;color:#1e4d8c;flex-shrink:0}
.act-body{flex:1;min-width:0;margin:0 12rpx}
.act-t{display:block;font-size:30rpx;color:#212121;font-weight:600}
.act-s{display:block;margin-top:6rpx;font-size:22rpx;color:#9e9e9e}
.chev{color:#c0c4cc;font-size:36rpx}
.hint-ok{margin-top:8rpx;padding:20rpx;background:#e8f5e9;border-radius:12rpx;color:#2e7d32;font-size:24rpx}
