.bt-mask{position:fixed;inset:0;z-index:1200;background:rgba(0,0,0,0.42);display:flex;flex-direction:column;justify-content:flex-end;padding:0 24rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.bt-sheet{background:#fff;border-radius:24rpx;padding:28rpx 32rpx 32rpx;box-shadow:0 -4rpx 32rpx rgba(0,0,0,0.12);animation:bt-up 0.2s ease-out}
@keyframes bt-up{from{transform:translateY(24%);opacity:0.7}
to{transform:translateY(0);opacity:1}
}
.bt-head{display:flex;align-items:center;gap:16rpx;margin-bottom:16rpx}
.bt-title{flex:1;min-width:0;font-size:32rpx;font-weight:700;color:#2e6bb5;line-height:1.3}
.bt-title.searching{color:#e53935}
.bt-perm{flex-shrink:0;height:56rpx;padding:0 22rpx;border-radius:10rpx;background:#07c160;color:#fff;font-size:26rpx;font-weight:600;display:flex;align-items:center;justify-content:center}
.bt-hint{display:block;font-size:26rpx;color:#616161;line-height:1.55;margin-bottom:20rpx}
.bt-tips-title{display:block;font-size:26rpx;color:#757575;font-weight:600;margin-bottom:10rpx}
.bt-tip{margin-bottom:8rpx}
.bt-tip-text{font-size:26rpx;color:#757575;line-height:1.5}
.bt-acts{display:flex;gap:24rpx;margin-top:28rpx}
.bt-btn{flex:1;height:88rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:600;box-sizing:border-box}
.bt-btn.ghost{background:#fff;color:#424242;border:2rpx solid #e0e0e0}
.bt-btn.primary{background:#07c160;color:#fff}
