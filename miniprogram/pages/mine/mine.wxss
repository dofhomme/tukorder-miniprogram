.page{height:100vh;min-height:100vh;background:#f3f6fb;display:flex;flex-direction:column;box-sizing:border-box}
.header{padding:0 0 48rpx;background:linear-gradient(180deg,#dbe7f5 0%,#eef3f9 48%,#f3f6fb 100%);border-bottom:1rpx solid rgba(22,58,107,0.06)}
.status-spacer{width:100%}
.nav-row{display:flex;align-items:center;justify-content:center;padding-left:32rpx;box-sizing:border-box}
.nav-title{color:#163a6b;font-size:34rpx;font-weight:600}
.profile-row{margin-top:20rpx;padding:0 24rpx 0 32rpx;display:flex;align-items:center}
.avatar-wrap{position:relative;width:112rpx;height:112rpx;flex-shrink:0}
.avatar{width:112rpx;height:112rpx;border-radius:50%;background:linear-gradient(145deg,#4a7cba 0%,#2e6bb5 100%);color:#fff;display:flex;align-items:center;justify-content:center;font-size:48rpx;box-shadow:0 8rpx 20rpx rgba(46,107,181,0.28)}
.avatar-img{width:112rpx;height:112rpx;border-radius:50%;background:rgba(46,107,181,0.12)}
.avatar-edit{position:absolute;right:-4rpx;top:-4rpx;width:40rpx;height:40rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 2rpx 8rpx rgba(22,58,107,0.15)}
.avatar-edit-img{width:24rpx;height:24rpx}
.profile-info{flex:1;margin-left:24rpx;margin-right:16rpx;min-width:0}
.shop-name{display:block;color:#163a6b;font-size:40rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.display-name{display:block;margin-top:8rpx;color:#3d6aa0;font-size:30rpx;font-weight:500}
.phone{display:block;margin-top:8rpx;color:#6b7c93;font-size:28rpx}
.team-btn{flex-shrink:0;padding:14rpx 24rpx;border-radius:40rpx;background:linear-gradient(90deg,#2e6bb5,#4a7cba);color:#fff;font-size:26rpx;font-weight:600;display:flex;align-items:center;gap:8rpx;box-shadow:0 6rpx 16rpx rgba(46,107,181,0.28)}
.body-clip{flex:1;min-height:0;height:0;margin:0 24rpx 0;border-radius:24rpx 24rpx 0 0;overflow:hidden;position:relative}
.body{height:100%;box-sizing:border-box;padding-top:16rpx;padding-bottom:48rpx}
.menu-card{background:#fff;border-radius:24rpx;margin-top:8rpx;padding:8rpx 8rpx 8rpx 32rpx;box-shadow:0 4rpx 20rpx rgba(22,58,107,0.06);border:1rpx solid rgba(22,58,107,0.05)}
.menu-card.admin{margin-top:24rpx;padding-top:20rpx}
.admin-title{display:block;font-size:26rpx;font-weight:700;color:#616161;padding:4rpx 8rpx 12rpx 0}
.menu-item{display:flex;align-items:center;padding:20rpx 16rpx 20rpx 0;border-bottom:1rpx solid #f0f0f0}
.menu-item-hover{background:#eef1f5}
button.menu-share{display:flex !important;align-items:center;width:auto !important;min-width:0 !important;min-height:0 !important;margin:0 !important;padding:20rpx 16rpx 20rpx 0 !important;border:0 none !important;border-radius:0 !important;background:transparent !important;line-height:inherit !important;font-size:inherit !important;text-align:left !important;color:inherit !important;box-sizing:border-box !important;overflow:visible !important;box-shadow:none !important}
button.menu-share::before,button.menu-share::after{display:none !important;border:none !important}
.menu-item:last-child{border-bottom:none}
.menu-item.off .menu-title{color:#b7c0cb}
.menu-item.off .chev{color:#d5dbe2}
.menu-item.off .ico{filter:grayscale(1);opacity:.45}
.ico{width:72rpx;height:72rpx;border-radius:16rpx;margin-right:24rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
.ico-img{width:44rpx;height:44rpx;display:block}
.menu-title{flex:1;font-size:30rpx;color:#333}
.menu-meta{flex:1;min-width:0}
.menu-meta .menu-title{display:block;flex:none}
.menu-sub{display:block;margin-top:4rpx;font-size:22rpx;color:#999}
.chev{color:#c0c4cc;font-size:36rpx;padding:0 8rpx}
.logout{margin:40rpx 0 16rpx;height:88rpx;padding:0 !important;display:flex;align-items:center;justify-content:center;line-height:1;background:#fff;color:#e53935;border-radius:16rpx;font-size:32rpx;font-weight:500;border:none;box-sizing:border-box;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}
.logout::after{border:none}
.logout-hover{opacity:0.85}
.legal-row{display:flex;align-items:center;justify-content:center;gap:16rpx;margin:8rpx 0 4rpx}
.legal-link{font-size:24rpx;color:#2e6bb5;font-weight:500}
.legal-dot{font-size:22rpx;color:#b0bac8}
.footer-tip{display:block;text-align:center;color:#8a98ab;font-size:22rpx;line-height:1.55;white-space:pre-line;padding:8rpx 24rpx 0}
.footer-ver{display:block;text-align:center;color:#2e6bb5;font-size:22rpx;line-height:1.55;padding:4rpx 24rpx calc(32rpx + 148rpx + env(safe-area-inset-bottom))}
.sup-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:100001;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}
.sup-dlg{width:100%;max-width:640rpx;background:#fff;border-radius:20rpx;padding:36rpx 28rpx 24rpx;box-sizing:border-box}
.follow-dlg{display:flex;flex-direction:column;align-items:center}
.follow-qr{width:420rpx;height:420rpx}
.follow-hint{text-align:center;margin-bottom:8rpx}
.follow-close{width:100%;margin-top:8rpx}
.sup-title{display:block;text-align:center;font-size:34rpx;font-weight:700;color:#212121;margin-bottom:16rpx}
.sup-hint{display:block;font-size:26rpx;color:#757575;line-height:1.5;margin-bottom:12rpx}
.sup-wx{display:flex;flex-direction:column;align-items:center;margin-bottom:16rpx}
.sup-wx-title{font-size:28rpx;font-weight:700;color:#1f2a37}
.sup-wx-qr{width:420rpx;height:420rpx;margin-top:8rpx}
.sup-wx-id{margin-top:4rpx;font-size:26rpx;color:#2f6bff}
.sup-area{width:100%;min-height:160rpx;padding:20rpx;border:2rpx solid #cfd8dc;border-radius:12rpx;font-size:28rpx;line-height:1.5;box-sizing:border-box;background:#fff}
.sup-count{display:block;text-align:right;margin-top:10rpx;font-size:22rpx;color:#9e9e9e}
.sup-actions{display:flex;gap:16rpx;margin-top:24rpx}
.sup-btn{flex:1;height:80rpx;line-height:80rpx;text-align:center;border-radius:12rpx;font-size:28rpx;font-weight:600}
.sup-btn.cancel{color:#757575;background:transparent}
.sup-btn.ok{color:#1e4d8c;background:transparent;font-weight:700}
.sup-btn.off{opacity:0.45;pointer-events:none}
.clr-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:100001;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}
.clr-dlg{width:100%;max-width:640rpx;background:#fff;border-radius:20rpx;padding:36rpx 28rpx 24rpx;box-sizing:border-box}
.clr-title{display:block;text-align:center;font-size:34rpx;font-weight:700;color:#212121;margin-bottom:20rpx}
.clr-body{display:block;font-size:26rpx;color:#424242;line-height:1.55;white-space:pre-wrap;margin-bottom:28rpx}
.clr-actions{display:flex;gap:16rpx}
.clr-btn{flex:1;height:80rpx;line-height:80rpx;text-align:center;border-radius:40rpx;font-size:28rpx;font-weight:600}
.clr-btn.ghost{color:#616161;background:#fff;border:2rpx solid #bdbdbd;box-sizing:border-box}
.clr-btn.warn{color:#fff;background:#ff9800;border:2rpx solid #ff9800;box-sizing:border-box}
.ico.i-customers{background-color:#e8f5e9}
.ico.i-returnpkg{background-color:#e8f5e9}
.ico.i-sync{background-color:#e8eaf6}
.ico.i-sub{background-color:#fff8e1}
.ico.i-bills{background-color:#e0f2f1}
.ico.i-profile{background-color:#e8f5e9}
.ico.i-shops{background-color:#e0f2f1}
.ico.i-share-staff{background-color:#f3e5f5}
.ico.i-switch-shop{background-color:#e3f2fd}
.ico.i-stats{background-color:#fff3e0}
.ico.i-print{background-color:#e3f2fd}
.ico.i-recycle{background-color:#e1f5fe}
.ico.i-lang{background-color:#e8eaf6}
.ico.i-support{background-color:#e3f2fd}
.ico.i-clear{background-color:#e3f2fd}
.ico.i-admin-users{background-color:#e3f2fd}
.ico.i-feedback{background-color:#fff3e0}
.ico.i-voice{background-color:#ede7f6}
.ico.i-rules{background-color:#e8eaf6}
.ico.i-agent-apply{background-color:#e0f2f1}
.ico.i-print-channel{background-color:#e3f2fd}
.ico.i-share-stall{background-color:#e8eaf6}
.ico.i-invite{background-color:#e8eaf6}
.ico.i-follow{background-color:#fce4ec}
.team-ico{width:32rpx;height:32rpx;flex-shrink:0}
.role-chip{flex-shrink:0;margin-left:12rpx;padding:10rpx 20rpx;border-radius:999rpx;background:rgba(46,107,181,0.12);color:#163a6b;font-size:22rpx;font-weight:600}
.role-chip-agent{background:rgba(15,118,110,0.14);color:#134e4a}
.role-switch{margin:32rpx 24rpx 12rpx;padding:24rpx 32rpx;border-radius:20rpx;background:linear-gradient(135deg,rgba(46,107,181,0.12),rgba(46,107,181,0.04));border:1rpx solid rgba(46,107,181,0.18)}
.role-switch-t{display:block;font-size:30rpx;font-weight:600;color:#163a6b}
.role-switch-d{display:block;margin-top:6rpx;font-size:22rpx;color:#2e6bb5}
.role-switch-act{display:block;margin-top:14rpx;font-size:26rpx;font-weight:600;color:#2e6bb5}
.role-switch-agent{background:linear-gradient(135deg,rgba(15,118,110,0.12),rgba(15,118,110,0.04));border-color:rgba(15,118,110,0.2)}
.role-switch-agent .role-switch-t{color:#134e4a}
.role-switch-agent .role-switch-d,.role-switch-agent .role-switch-act{color:#0f766e}
.guest-banner{margin:40rpx 24rpx 20rpx;padding:28rpx 32rpx;border-radius:20rpx;background:linear-gradient(135deg,rgba(46,107,181,0.12),rgba(46,107,181,0.04));border:1rpx solid rgba(46,107,181,0.18)}
.guest-banner-t{display:block;font-size:30rpx;font-weight:600;color:#163a6b}
.guest-banner-d{display:block;margin-top:8rpx;font-size:24rpx;color:#2e6bb5}
.guest-banner-ok{background:linear-gradient(135deg,rgba(46,160,100,0.12),rgba(46,160,100,0.04));border-color:rgba(46,160,100,0.22)}
.guest-banner-ok .guest-banner-t{color:#1a5c3a}
.guest-banner-ok .guest-banner-d{color:#2e8a55}
.page.agent-skin{background:#eef6f4}
.page.agent-skin .header{background:linear-gradient(180deg,#d7efe9 0%,#eef6f4 48%,#f3f7f6 100%);border-bottom-color:rgba(15,118,110,0.08)}
.page.agent-skin .avatar{background:#0f766e;box-shadow:none}
.page.agent-skin .avatar-img.brand{background:transparent;border-radius:0;padding:0;box-sizing:border-box}
.page.agent-skin .shop-name,.page.agent-skin .display-name{color:#134e4a}
.inv-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:40;background:rgba(15,23,42,0.45);display:flex;align-items:flex-end}
.inv-sheet{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.inv-handle{width:72rpx;height:8rpx;border-radius:8rpx;background:#d5dbe2;margin:8rpx auto 20rpx}
.inv-title{display:block;text-align:center;font-size:32rpx;font-weight:700;color:#163a6b;margin-bottom:12rpx}
.inv-row{display:flex;align-items:center;justify-content:center;height:96rpx;border-bottom:1rpx solid #f0f0f0;font-size:32rpx;color:#1a2b3c}
button.inv-row{width:100% !important;margin:0 !important;padding:0 !important;border:0 none !important;border-radius:0 !important;background:transparent !important;line-height:96rpx !important;font-size:32rpx !important;color:#1a2b3c !important;font-weight:500 !important}
button.inv-row::after{border:none}
.inv-row-hover{background:#eef1f5}
.inv-cancel{margin-top:16rpx;height:88rpx;border-radius:16rpx;background:#f3f6fb;color:#546e7a;font-size:30rpx;display:flex;align-items:center;justify-content:center}
.kf-fab-wrap{position:fixed;right:28rpx;bottom:calc(140rpx + env(safe-area-inset-bottom));width:112rpx;height:112rpx;z-index:30;background:transparent;overflow:hidden;border-radius:50%}
button.kf-fab{width:112rpx !important;height:112rpx !important;min-width:0 !important;min-height:0 !important;max-width:112rpx !important;max-height:112rpx !important;padding:0 !important;margin:0 !important;line-height:1 !important;font-size:0 !important;border:0 none !important;outline:0 none !important;border-radius:50% !important;background:#2e6bb5 !important;background-color:#2e6bb5 !important;overflow:hidden !important;box-shadow:none !important;display:flex !important;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box !important;position:relative}
button.kf-fab::before,button.kf-fab::after{display:none !important;border:0 none !important;background:none !important}
.kf-fab-ico{width:44rpx;height:44rpx;display:block}
.kf-fab-txt{margin-top:6rpx;font-size:20rpx;line-height:1;color:#fff;font-weight:600}
.page.rtl .kf-fab-wrap{right:auto;left:28rpx}
