.page{height:100vh;display:flex;flex-direction:column;background:#fff;box-sizing:border-box}
.body{flex:1;height:0;padding-bottom:24rpx}
.agent-banner{margin:0 32rpx 16rpx;padding:20rpx 22rpx;border-radius:14rpx;background:#f6effb}
.agent-banner-t{display:block;font-weight:700;color:#6a1b9a;font-size:28rpx}
.agent-banner-d{display:block;margin-top:6rpx;color:#7b5c8c;font-size:24rpx;line-height:1.45}
.agent-banner.reject{background:#fff7ed}
.agent-banner.reject .agent-banner-t{color:#b45309}
.agent-banner.reject .agent-banner-d{color:#9a3412}
.agent-ok{margin-top:16rpx;height:64rpx;line-height:64rpx;text-align:center;border-radius:10rpx;background:#6a1b9a;color:#fff;font-weight:600;font-size:26rpx;flex:1}
.agent-acts{display:flex;gap:12rpx}
.agent-no{margin-top:16rpx;height:64rpx;line-height:64rpx;text-align:center;border-radius:10rpx;background:#fff;color:#b45309;border:2rpx solid #f6d7b0;font-weight:600;font-size:26rpx;flex:1}
.item-qty{display:flex;align-items:center;gap:8rpx;margin-right:8rpx}
.qty-btn{width:44rpx;height:44rpx;line-height:44rpx;text-align:center;background:#f3eef8;border-radius:8rpx;color:#6a1b9a;font-size:28rpx}
.qty-n{min-width:36rpx;text-align:center;font-size:26rpx}
.ship-box{margin:0 32rpx 16rpx;padding:18rpx 22rpx;border-radius:14rpx;background:#f0fdfa}
.ship-title{display:block;font-weight:700;color:#0f766e;font-size:26rpx}
.ship-line{display:block;margin-top:6rpx;color:#334155;font-size:24rpx;line-height:1.45}
.hdr{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:28rpx 32rpx 20rpx}
.hdr-left{flex:1;min-width:0}
.hdr-no-row{display:flex;align-items:center;gap:10rpx}
.ret-badge{flex-shrink:0;font-size:20rpx;font-weight:700;color:#fff;background:#e53935;border-radius:6rpx;padding:2rpx 8rpx;line-height:1.4}
.hdr-no{font-size:32rpx;font-weight:700;color:#1a202c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hdr-time{display:block;margin-top:8rpx;font-size:24rpx;color:#9aa5b1}
.hdr-cust{display:block;margin-top:6rpx;font-size:24rpx;color:#718096}
.hdr-amt{flex-shrink:0;font-size:40rpx;font-weight:700;color:#ff5252;line-height:1.2}
.divider{height:1rpx;background:#edf2f7;margin:0 0 8rpx}
.fulfill{padding:16rpx 32rpx 8rpx}
.fulfill-title{display:block;font-size:28rpx;font-weight:700;color:#2d3748;margin-bottom:16rpx}
.chip-row{display:flex;flex-wrap:wrap;gap:12rpx}
.chip{display:flex;align-items:center;justify-content:center;gap:4rpx;min-height:56rpx;padding:0 20rpx;border-radius:999rpx;background:#f1f5f9;border:1rpx solid #e2e8f0;box-sizing:border-box}
.chip text{font-size:24rpx;color:#64748b;line-height:1}
.chip-ico{font-size:22rpx !important;font-weight:700}
.chip.on.paid{background:#e8f5e9;border-color:#a5d6a7}
.chip.on.paid text{color:#2e7d32;font-weight:600}
.chip.on.picked{background:#e3f2fd;border-color:#90caf9}
.chip.on.picked text{color:#1565c0;font-weight:600}
.chip.on.shipped{background:#fff3e0;border-color:#ffcc80}
.chip.on.shipped text{color:#ef6c00;font-weight:600}
.chip.on.delivered{background:#e0f2f1;border-color:#80cbc4}
.chip.on.delivered text{color:#00695c;font-weight:600}
.chip.readonly{opacity:0.72}
.trk-wrap{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}
.trk-chip{display:flex;align-items:center;padding:8rpx 18rpx;border-radius:999rpx;background:#e3f2fd;border:1rpx solid #90caf9}
.trk-txt{font-size:22rpx;color:#1565c0}
.trk-x{margin-left:10rpx;font-size:24rpx;color:#e53935;padding:0 4rpx}
.deliv-thumb{width:72rpx;height:72rpx;border-radius:8rpx;overflow:hidden;border:1rpx solid #cfd8dc;flex-shrink:0}
.deliv-img{width:100%;height:100%}
.deliv-mask{position:fixed;inset:0;z-index:11000;background:rgba(0,0,0,0.45);display:flex;align-items:flex-end}
.deliv-sheet{width:100%;background:#fff;border-radius:24rpx 24rpx 0 0;padding:12rpx 0 calc(16rpx + env(safe-area-inset-bottom))}
.deliv-item{display:flex;align-items:center;padding:28rpx 40rpx}
.deliv-item-ico{width:56rpx;text-align:center;font-size:36rpx;margin-right:28rpx}
.deliv-item-txt{font-size:30rpx;color:#222}
.deliv-item-txt.danger,.deliv-item.danger .deliv-item-txt{color:#e53935}
.deliv-cancel{margin-top:8rpx;border-top:8rpx solid #f2f2f2;height:96rpx;line-height:96rpx;text-align:center;font-size:30rpx;color:#555;font-weight:600}
.items{padding:8rpx 0 40rpx}
.item{display:flex;align-items:center;gap:20rpx;padding:24rpx 32rpx;border-bottom:1rpx solid #edf2f7}
.item-main{flex:1;min-width:0}
.item-name{display:block;font-size:28rpx;font-weight:600;color:#1a202c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item-sub{display:block;margin-top:8rpx;font-size:24rpx;color:#718096}
.item-amt{flex-shrink:0;font-size:28rpx;font-weight:600;color:#2d3748}
.item-empty{padding:48rpx;text-align:center;color:#a0aec0;font-size:26rpx}
.actions{flex-shrink:0;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #edf2f7;display:flex;flex-direction:column;gap:16rpx}
.act-row{display:flex;gap:20rpx}
.act-btn{flex:1;height:88rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;box-sizing:border-box}
.act-btn.print{flex:1.35;background:#07c160}
.act-btn.print .act-txt{color:#fff;font-weight:700}
.act-btn.download,.act-btn.delete{background:#fff;border:2rpx solid #2e6bb5}
.act-btn.download .act-txt,.act-btn.delete .act-txt{color:#2e6bb5;font-weight:600}
.act-btn.edit{background:#2e6bb5}
.act-btn.edit .act-txt{color:#fff;font-weight:700}
.act-btn.disabled{opacity:0.55;pointer-events:none}
.act-btn.locked{opacity:0.55}
.act-ico{width:36rpx;height:36rpx;flex-shrink:0}
.act-txt{font-size:28rpx;line-height:1}
.empty{padding:120rpx 40rpx;text-align:center;color:#a0aec0;font-size:28rpx}
.exp-mask{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:40rpx 32rpx;box-sizing:border-box}
.exp-dialog{width:100%;max-width:640rpx;max-height:86vh;background:#fff;border-radius:20rpx;display:flex;flex-direction:column;overflow:hidden}
.exp-title{display:block;padding:28rpx 28rpx 12rpx;font-size:32rpx;font-weight:700;text-align:center;color:#1a202c}
.exp-scroll{flex:1;max-height:62vh;padding:0 24rpx;box-sizing:border-box}
.exp-card{background:#fff;padding:12rpx 8rpx 28rpx;overflow:hidden;box-sizing:border-box}
.exp-actions{display:flex;gap:16rpx;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #edf2f7}
.exp-btn{flex:1;height:80rpx;line-height:80rpx;text-align:center;border-radius:12rpx;font-size:28rpx;background:#f1f5f9;color:#334155}
.exp-btn.primary{background:#2e6bb5;color:#fff;font-weight:600}
.exp-btn.primary.disabled{opacity:0.55}
.exp-canvas{position:fixed;left:-9999px;top:0;width:360px;height:600px}
